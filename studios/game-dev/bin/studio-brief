#!/bin/sh
# studio-brief — print exactly one unit's inputs, so an orchestrator never
# reads the plan or spec whole. Read-only. `plan` and `spec` come from the
# sibling studio-state (so STUDIO_STORY selects the story's file). Each part
# is headed by one line `==> <file>:L<a>-<b>` followed by those lines verbatim.
#
#   studio-brief task <n>   the plan's ## Global Constraints and ## Decisions,
#                           the `### Task <n>:` block, and every range on that
#                           block's `Spec:` line (`<path>:L<a>-<b>` or
#                           `<path>§<heading line as written>`, separated by
#                           ", "), then the story ledger's active directives
#                           (`Directive <id>:` lines not later retired) as a
#                           part `==> <ledger>`
#   studio-brief final      the spec's ## Acceptance criteria (only the story's
#                           items when the spec has ## Stories), the story's
#                           ## Stories row, the ledger's `Ruling: ` and
#                           `minor (deferred)` lines (anchored at the line's
#                           prefix), the active directives the same way as for
#                           `task`, before `diff:`, and the line
#                           `diff: git diff origin/<Target>...HEAD` (Target from
#                           $STUDIO_RUN's `Target:` header, else origin/HEAD).
#                           No plan text. The story id is $STUDIO_STORY.
#                           When the spec has no ## Acceptance criteria, the
#                           plan's stand in (and no ## Stories row is read).
#   studio-brief check <k>  the plan's Global Constraints, Decisions and
#                           Acceptance criteria, the `### Task 1..k` blocks
#                           with their Spec: ranges, `range: <adopt-base>..
#                           <T<k> end>` (truth region: after the last `adopt
#                           reset`), directives, Context files, and the line
#                           `diff:` for that range. k=0: `range: none`.
#
# `Context:` (a comma-separated file list before the plan's first `## `) adds a
# `## Context files` part to all three verbs: whole files while the byte total
# stays <= 12000, the rest listed under `Read these as well:`.
#
# A plan without ## Global Constraints or ## Decisions, or a task without a
# Spec: line, prints a one-line note in its place and still exits 0.
# Exit: 0 ok · 1 a task, cited range, heading or story that cannot be
# resolved, or a range past the end of its file · 2 bad usage
set -u

HERE="$(cd "$(dirname "$0")" && pwd)"
STATE_BIN="$HERE/studio-state"

usage() {
  printf 'usage: studio-brief task <n> | final | check <k>\n' >&2
  exit 2
}
fail() { printf 'studio-brief: %s\n' "$*" >&2; exit 1; }

# section FILE KEY EXACT — "a b" (first, last line) of the block whose heading
# line starts with KEY (equals KEY when EXACT is 1) and which ends before the
# next heading of the same or higher level; empty when absent. Lines inside
# ``` fences are never headings.
section() {
  awk -v key="$2" -v ex="$3" '
    function lvl(s) { match(s, /^#+/); return RLENGTH }
    /^```/ { fence = !fence; next }
    fence { next }
    !a && /^#+ / && (ex ? $0 == key : index($0, key) == 1) { a = NR; L = lvl($0); next }
    a && /^#+ / && lvl($0) <= L { print a, NR - 1; found = 1; exit }
    END { if (a && !found) print a, NR }
  ' "$1"
}

# emit FILE A B — the part header, then the lines.
emit() { printf '==> %s:L%s-%s\n' "$1" "$2" "$3"; sed -n "$2,$3p" "$1"; }

# state_get KEY — one studio-state field, with '-' (unset) read as empty.
state_get() {
  _v="$(sh "$STATE_BIN" get "$1" 2>/dev/null)" || fail "studio-state get $1 failed"
  [ "$_v" = "-" ] && _v=""
  printf '%s\n' "$_v"
}

# ledger_path — the story's ledger in this checkout: .studio/ledger/
# <STUDIO_STORY>.md, else the spec slug's (date prefix stripped); empty when
# neither is known.
ledger_path() {
  if [ -n "${STUDIO_STORY:-}" ]; then printf '%s\n' "$WORK/.studio/ledger/$STUDIO_STORY.md"; return 0; fi
  _lp_s="$(state_get spec)"; [ -n "$_lp_s" ] || return 0
  printf '%s\n' "$WORK/.studio/ledger/$(basename "$_lp_s" | sed -e 's/\.md$//' -e 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}-//').md"
}
# directives_part — AC15: the ledger's active directives (a `Directive <id>:`
# line with no later `Directive <id> retired`), as one part headed
# `==> <ledger path>`; nothing when there are none.
directives_part() {
  _dp_l="$(ledger_path)"
  [ -n "$_dp_l" ] && [ -f "$_dp_l" ] || return 0
  _dp="$(awk '
    $0 !~ /^- [0-9-]+ / { next }
    { t = $0; sub(/^- [0-9-]+ /, "", t) }
    t ~ /^Directive [0-9]+: / { id = t; sub(/^Directive /, "", id); sub(/:.*/, "", id); L[NR] = $0; D[NR] = id; next }
    t ~ /^Directive [0-9]+ retired *$/ { id = t; sub(/^Directive /, "", id); sub(/ .*/, "", id); R[id] = NR }
    END { for (i = 1; i <= NR; i++) if ((i in L) && !((D[i] in R) && R[D[i]] > i)) print L[i] }' "$_dp_l")"
  [ -z "$_dp" ] || printf '==> %s\n%s\n' "$_dp_l" "$_dp"
}

WORK="$(sh "$STATE_BIN" root --work 2>/dev/null)" && cd "$WORK" 2>/dev/null

[ $# -ge 1 ] || usage
verb="$1"

# emit_section FILE KEY EXACT NAME — emit a section or exit 1 naming it.
emit_section() {
  _r="$(section "$1" "$2" "$3")"
  [ -n "$_r" ] || fail "$4 not found in $1"
  # shellcheck disable=SC2086
  emit "$1" $_r
}

# emit_task N WITHDIR — the `### Task N:` block, then (WITHDIR=1) the active
# directives, then every range on the block's `Spec:` line (`task` and `check`
# share it). Needs $plan. Exits 1 when the task or a range cannot be resolved.
emit_task() {
  _et_n="$1"; _et_wd="$2"
  _et_r="$(section "$plan" "### Task $_et_n:" 0)"
  [ -n "$_et_r" ] || fail "### Task $_et_n not found in $plan"
  set -- $_et_r
  _et_a="$1"; _et_b="$2"
  emit "$plan" "$_et_a" "$_et_b"
  if [ "$_et_wd" = 1 ]; then directives_part; fi
  specline="$(sed -n "${_et_a},${_et_b}p" "$plan" | sed -n 's/^Spec: //p' | head -n 1)"
  if [ -z "$specline" ]; then
    printf '(task %s has no Spec: line)\n' "$_et_n"
    return 0
  fi
  # Items are separated by ", " (a heading containing ", " cannot be cited).
  items="$(printf '%s\n' "$specline" | sed 's/, /\
/g')"
  oldifs="$IFS"; IFS='
'
  for item in $items; do
    IFS="$oldifs"
    case "$item" in
      *§*)
        f="${item%%§*}"; h="${item#*§}"
        [ -f "$f" ] || fail "spec $f not found (Spec: item '$item')"
        emit_section "$f" "$h" 1 "heading '$h'"
        ;;
      *:L[0-9]*-[0-9]*)
        f="${item%:L*}"; rng="${item##*:L}"
        a="${rng%-*}"; b="${rng#*-}"
        case "$a$b" in *[!0-9]*) fail "bad range in Spec: item '$item'" ;; esac
        [ -f "$f" ] || fail "spec $f not found (Spec: item '$item')"
        total="$(wc -l < "$f" | tr -d ' ')"
        # a final line without a newline still counts
        [ -n "$(tail -c1 "$f")" ] && total=$((total + 1))
        { [ "$a" -ge 1 ] && [ "$a" -le "$b" ] && [ "$b" -le "$total" ]; } \
          || fail "range $item is past the end of $f ($total lines)"
        emit "$f" "$a" "$b"
        ;;
      *) fail "cannot parse Spec: item '$item'" ;;
    esac
    IFS='
'
  done
  IFS="$oldifs"
}

# context_part — D18: the plan's Context: files under `## Context files`,
# whole, in order, while the running byte total stays <= 12000; the rest
# listed under `Read these as well:`. Nothing when the plan has no Context:.
context_part() {
  _cp_p="$(state_get plan)"; [ -n "$_cp_p" ] && [ -f "$_cp_p" ] || return 0
  _cp_l="$(sed -n '/^## /q; s/^Context:[[:space:]]*//p' "$_cp_p" | head -n 1)"
  [ -n "$_cp_l" ] || return 0
  printf '## Context files\n'
  _cp_t=0; _cp_over=""
  set -f   # a `*` in a Context path is a name, not a glob
  for _cp_f in $(printf '%s\n' "$_cp_l" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'); do
    [ -f "$_cp_f" ] || fail "Context file $_cp_f not found"
    _cp_c="$(wc -c < "$_cp_f" | tr -d ' ')"
    if [ -z "$_cp_over" ] && [ $((_cp_t + _cp_c)) -le 12000 ]; then
      _cp_t=$((_cp_t + _cp_c)); _cp_n="$(wc -l < "$_cp_f" | tr -d ' ')"
      [ -n "$(tail -c1 "$_cp_f")" ] && _cp_n=$((_cp_n + 1))
      if [ "$_cp_n" -eq 0 ]; then printf '==> %s:L0-0\n' "$_cp_f"; else emit "$_cp_f" 1 "$_cp_n"; fi
    else
      [ -n "$_cp_over" ] || printf 'Read these as well:\n'; _cp_over=1; printf -- '- %s\n' "$_cp_f"
    fi
  done
  set +f
}

# plan_head — the plan's Global Constraints and Decisions (or a note each).
plan_head() {
  for part in "Global Constraints" "Decisions"; do
    r="$(section "$plan" "## $part" 1)"
    if [ -n "$r" ]; then
      # shellcheck disable=SC2086
      emit "$plan" $r
    else
      printf '(plan has no ## %s)\n' "$part"
    fi
  done
}

# need_plan — set $plan from the state, or fail.
need_plan() {
  plan="$(state_get plan)"
  [ -n "$plan" ] || fail "no plan set"
  [ -f "$plan" ] || fail "plan $plan not found"
}

case "$verb" in
task)
  [ $# -eq 2 ] || usage
  case "$2" in ''|*[!0-9]*) usage ;; esac
  need_plan
  plan_head
  emit_task "$2" 1
  context_part
  ;;
check)
  [ $# -eq 2 ] || usage
  case "$2" in ''|*[!0-9]*) usage ;; esac
  k="$2"
  need_plan
  plan_head
  r="$(section "$plan" "## Acceptance criteria" 1)"
  if [ -n "$r" ]; then
    # shellcheck disable=SC2086
    emit "$plan" $r
  else
    printf '(plan has no ## Acceptance criteria)\n'
  fi
  i=1
  while [ "$i" -le "$k" ]; do emit_task "$i" 0; i=$((i + 1)); done
  # D2: only the lines after the last `adopt reset` count.
  truth=""
  ledger="$(ledger_path)"
  if [ -n "$ledger" ] && [ -f "$ledger" ]; then
    truth="$(awk '/^- [0-9-]+ adopt reset /{ n = NR } { l[NR] = $0 } END { for (i = n + 1; i <= NR; i++) print l[i] }' "$ledger")"
  fi
  rng=""
  if [ "$k" -eq 0 ]; then
    printf 'range: none — no finished task\n'
  else
    base="$(printf '%s\n' "$truth" | awk '/^- [0-9-]+ adopt-base /{ v = $NF } END { print v }')"
    [ -n "$base" ] || fail "no adopt-base line in the ledger (after the last adopt reset)"
    tend="$(printf '%s\n' "$truth" | awk -v k="$k" '$0 ~ "^- [0-9-]+ T" k " complete " { v = $NF } END { sub(/.*\.\./, "", v); print v }')"
    [ -n "$tend" ] || fail "no T$k complete line in the ledger (after the last adopt reset)"
    rng="$base..$tend"
    printf 'range: %s\n' "$rng"
  fi
  directives_part
  context_part
  [ -z "$rng" ] || printf 'diff: git diff %s\n' "$rng"
  ;;
final)
  [ $# -eq 1 ] || usage
  spec="$(state_get spec)"
  [ -n "$spec" ] || fail "no spec set"
  [ -f "$spec" ] || fail "spec $spec not found"
  story="${STUDIO_STORY:-}"
  st="$(section "$spec" "## Stories" 0)"
  ac="$(section "$spec" "## Acceptance criteria" 0)"
  acfile="$spec"
  if [ -z "$ac" ]; then
    # D17: an adopted story may have no epic spec; the plan's criteria stand in
    # and there is no ## Stories row to read.
    _pl="$(state_get plan)"
    if [ -n "$_pl" ] && [ -f "$_pl" ]; then
      ac="$(section "$_pl" "## Acceptance criteria" 0)"
      if [ -n "$ac" ]; then acfile="$_pl"; st=""; fi
    fi
  fi
  [ -n "$ac" ] || fail "## Acceptance criteria not found in $spec"
  set -- $ac
  aa="$1"; ab="$2"
  row=""
  if [ -n "$st" ]; then
    [ -n "$story" ] || fail "STUDIO_STORY not set"
    set -- $st
    sa="$1"; sb="$2"
    # row line number and the Acceptance criteria cell, by the header's column
    rowinfo="$(awk -v a="$sa" -v b="$sb" -v id="$story" '
      function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
      NR < a || NR > b { next }
      /^\|/ {
        n = split($0, c, "|")
        if (!col) { for (i = 1; i <= n; i++) if (trim(c[i]) == "Acceptance criteria") { col = i; break } }
        if (trim(c[2]) == id && col) { print NR "|" trim(c[col]); exit }
      }
    ' "$spec")"
    [ -n "$rowinfo" ] || fail "story $story has no row (or no Acceptance criteria column) in $spec's ## Stories"
    rown="${rowinfo%%|*}"; cell="${rowinfo#*|}"
    # Expand "1, 3-5" to the item numbers.
    nums=""
    for tok in $(printf '%s' "$cell" | tr ',' ' '); do
      case "$tok" in
        [0-9]*-[0-9]*)
          i="${tok%-*}"; e="${tok#*-}"
          while [ "$i" -le "$e" ]; do nums="$nums $i"; i=$((i + 1)); done ;;
        [0-9]*) nums="$nums $tok" ;;
        *) fail "cannot parse Acceptance criteria cell '$cell'" ;;
      esac
    done
    [ -n "$nums" ] || fail "story $story lists no acceptance criteria"
    # Item N spans from its `N. ` line to the line before the next item.
    starts="$(awk -v a="$aa" -v b="$ab" '
      /^```/ { fence = !fence }
      NR > a && NR <= b && !fence && /^[0-9]+\. / { split($0, p, "."); print p[1], NR }
    ' "$spec")"
    for num in $nums; do
      sl="$(printf '%s\n' "$starts" | awk -v n="$num" '$1 == n { print $2; exit }')"
      [ -n "$sl" ] || fail "acceptance criterion $num not found in $spec"
      nx="$(printf '%s\n' "$starts" | awk -v s="$sl" '$2 > s { print $2; exit }')"
      if [ -n "$nx" ]; then el=$((nx - 1)); else el="$ab"; fi
      emit "$spec" "$sl" "$el"
    done
    emit "$spec" "$rown" "$rown"
  else
    emit "$acfile" "$aa" "$ab"
  fi
  # the story's ledger
  ledger="$(ledger_path)"
  if [ -f "$ledger" ]; then
    printf '==> %s\n' "$ledger"
    grep -E '^- [0-9-]+ ((T[0-9]+|Task [0-9]+:|check) )?(Ruling: |minor \(deferred\))' "$ledger" || true
  else
    printf '(no ledger at %s)\n' "$ledger"
  fi
  directives_part
  context_part
  # the diff command
  target=""
  if [ -n "${STUDIO_RUN:-}" ] && [ -f "$STUDIO_RUN" ]; then
    target="$(sed -n 's/^Target:[ 	]*//p' "$STUDIO_RUN" | head -n 1 | sed -e 's/[ 	]#.*$//' -e 's/[ 	]*$//')"
  fi
  if [ -z "$target" ]; then
    target="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')"
  fi
  [ -n "$target" ] || fail "no Target: in \$STUDIO_RUN and no origin/HEAD"
  printf 'diff: git diff origin/%s...HEAD\n' "$target"
  ;;
*) usage ;;
esac
