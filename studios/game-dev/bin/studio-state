#!/bin/sh
# studio-state — read and write the studio's state the same way from every
# skill. Every checkout has its own stage pointer (#42): the main checkout's
# is <root>/.studio/STATE.md; a linked worktree's is its own git-excluded
# .studio/STATE.md, created on its first write (until then it reads idle).
# The milestone is project-wide, on the main pointer. Everything else keyed
# on `root` (STUDIO_STORY state, the gate lock, state.mutex, records,
# reports) stays project-wide; the feature ledger, config.json and the spec
# and plan paths live in the checkout the command runs in, so they travel
# with the branch.
#
#   studio-state root [--work]   print the project root (the main checkout; the gate lock, stories, records), or the working root
#   studio-state init [--local]  create .studio/ (STATE.md, config.json, ledger/)
#   studio-state show            print STATE.md, then the current feature ledger
#   studio-state get KEY         print one field
#   studio-state set KEY VALUE   replace one field; '-' clears it
#   studio-state ledger TEXT     append a dated line to the feature ledger
#                                (.studio/ledger/<feature>.md when spec is set,
#                                else STATE.md's own ledger)
#   studio-state check [--rebuild]      verify state against files and ledger;
#                                       --rebuild sets task from the ledger
#   studio-state reset [--keep-ledger]  back to idle; drops the feature ledger
#                                       unless --keep-ledger
#   studio-state worktree        print the worktree that has the recorded branch checked out
#
# Keys: stage spec plan task branch milestone
# Exit: 0 ok · 1 no .studio/ (except init and root), bad key, bad value, bad
# usage, or a check that found a mismatch · 3 worktree: the branch exists but
# no worktree has it checked out
set -eu

# The pointer's root is the main worktree, always listed first by
# `git worktree list` (correct from the main checkout or any linked
# worktree). That listing instead reports a bare repository's or a
# submodule's own git-dir — not a worktree — when there is no ordinary
# worktree to report, so trust the candidate only when it owns a `.git` entry
# of its own; otherwise fall back to the working root, and outside a
# repository — or a bare one, which has no working root either — to the
# current directory. Every git call is guarded so a missing repository, an
# unborn HEAD, or a bare repository never aborts the script under `set -eu`.
_wt="$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')"
WORK_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -n "$_wt" ] && [ -e "$_wt/.git" ]; then
  STATE_ROOT="$_wt"
else
  STATE_ROOT="$WORK_ROOT"
fi
[ -n "$STATE_ROOT" ] || STATE_ROOT="$(pwd -P)"
[ -n "$WORK_ROOT" ] || WORK_ROOT="$(pwd -P)"
# The pointer's own path, through symlinks, so st_lock can source the shared
# mutex beside it (overnight-runs.sh; AC27: reused, never copied).
_self="$0"
while [ -L "$_self" ]; do _l="$(readlink "$_self")"
  case "$_l" in /*) _self="$_l" ;; *) _self="$(dirname "$_self")/$_l" ;; esac
done
SELF_DIR="$(cd "$(dirname "$_self")" && pwd -P)"
TAB="$(printf '\t')"
# #42 AC1-AC5: every checkout resolves only its own stage pointer.
# - the main checkout: <root>/.studio/STATE.md (MAIN);
# - a linked worktree: <work root>/.studio/STATE.md (LOCAL) when it exists and git
#   does not track it (AC4); otherwise the checkout is pointer-less, reads idle,
#   and its first write creates LOCAL (AC6);
# - STUDIO_STORY: <root>/.studio/stories/<id>.md, unchanged (AC5).
MAIN="$STATE_ROOT/.studio/STATE.md"
LOCAL="$WORK_ROOT/.studio/STATE.md"
_gd="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null || true)"
_gcd="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
LINKED=0; [ -z "$_gd" ] || [ "$_gd" = "$_gcd" ] || LINKED=1
TRACKED=0; POINTERLESS=0; STATE="$MAIN"
if [ "$LINKED" = 1 ]; then
  STATE="$LOCAL"
  if ( cd "$WORK_ROOT" && git ls-files --error-unmatch .studio/STATE.md ) >/dev/null 2>&1; then TRACKED=1; fi
  if [ ! -f "$LOCAL" ] || [ "$TRACKED" = 1 ]; then POINTERLESS=1; fi
fi
STORY="${STUDIO_STORY:-}"
if [ -n "$STORY" ]; then
  printf '%s' "$STORY" | grep -Eq '^[A-Za-z0-9._-]+$' || { printf "studio-state: bad STUDIO_STORY '%s'\n" "$STORY" >&2; exit 1; }
  STATE="$STATE_ROOT/.studio/stories/$STORY.md"; POINTERLESS=0
fi
FORCE=0
CONFIG="$WORK_ROOT/.studio/config.json"
LEDGER_DIR="$WORK_ROOT/.studio/ledger"
KEYS="stage spec plan task branch milestone"
STAGES="idle brainstorm plan execute"
MILESTONES="prototype vertical-slice alpha beta gold"

usage() {
  printf 'usage: studio-state root [--work] | init [--local] | show | get KEY | set KEY VALUE | ledger TEXT | check [--rebuild] | reset [--keep-ledger] | worktree\nkeys: %s\n' "$KEYS" >&2
  exit 1
}

fail() { printf 'studio-state: %s\n' "$*" >&2; exit 1; }

today() { date +%Y-%m-%d; }
hdr() { sed -n "s/^$2: //p" "$1" 2>/dev/null | head -n 1; }
slug_of() { basename "$1" | sed -e 's/\.md$//' -e 's/^[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}-//'; }
# exclude_once LINE — append LINE to <common git dir>/info/exclude once,
# repairing a missing final newline first (#39's rule, now shared).
exclude_once() {
  [ -n "$_gcd" ] || return 0
  mkdir -p "$_gcd/info" || fail "cannot create $_gcd/info"
  grep -qxF "$1" "$_gcd/info/exclude" 2>/dev/null && return 0
  if [ -s "$_gcd/info/exclude" ] && [ -n "$(tail -c 1 "$_gcd/info/exclude")" ]; then printf '\n' >> "$_gcd/info/exclude"; fi
  printf '%s\n' "$1" >> "$_gcd/info/exclude"
}
# st_lock — AC27: take <root>/.studio/state.mutex once per invocation. 0 when
# held (now or already) or when <root>/.studio is missing (f3-N3: nothing to
# race, nothing created); 1 when mx_take times out. The traps release it on
# every exit; INT and TERM then exit 130/143, so a write never resumes unlocked.
LOCKED=0; MUTEX="$STATE_ROOT/.studio/state.mutex"
st_lock() {
  [ "$LOCKED" = 0 ] || return 0
  [ -d "$STATE_ROOT/.studio" ] || return 0
  [ -f "$SELF_DIR/overnight-runs.sh" ] || fail "missing $SELF_DIR/overnight-runs.sh — reinstall the studio"
  . "$SELF_DIR/overnight-runs.sh"
  trap 'mx_drop "$MUTEX" $$' EXIT
  trap 'mx_drop "$MUTEX" $$; exit 130' INT
  trap 'mx_drop "$MUTEX" $$; exit 143' TERM
  if mx_take "$MUTEX" $$; then LOCKED=1; exclude_once .studio/state.mutex; return 0; fi
  return 1
}
mutex_pid() { readlink "$MUTEX" 2>/dev/null || printf '?'; }
lock_or_fail() { st_lock || fail "$MUTEX is busy (pid $(mutex_pid))"; }
# make_local_pointer DIR — AC6/AC8, the one function behind init --local and
# auto-create: the idle template without a milestone line, written to a temp
# file and hard-linked into place (never clobbers; a lost race keeps the winner's).
make_local_pointer() {
  mkdir -p "$1/.studio" || fail "cannot create $1/.studio"
  _mk="$1/.studio/STATE.md.tmp.$$"
  write_idle_state "$_mk" nomilestone || fail "cannot write $_mk"
  ln "$_mk" "$1/.studio/STATE.md" 2>/dev/null || true
  rm -f "$_mk"
  [ -f "$1/.studio/STATE.md" ] || fail "cannot create $1/.studio/STATE.md"
  exclude_once .studio/STATE.md
}
# auto_create — AC6: a pointer-less worktree's first write creates its pointer
# (the caller holds the mutex); AC4: never into a tracked STATE.md.
auto_create() {
  [ "$TRACKED" = 0 ] || fail "$LOCAL is tracked by git — a tracked STATE.md is never a stage pointer; run git rm --cached .studio/STATE.md on this branch"
  make_local_pointer "$WORK_ROOT"; STATE="$LOCAL"; POINTERLESS=0
}
# main_milestone — AC10/AC11: the project-wide milestone, read from the main
# pointer; prototype when there is none.
main_milestone() { if [ -f "$MAIN" ]; then hdr "$MAIN" milestone; else printf 'prototype\n'; fi; }
# milestone_view FILE — FILE with every header milestone line dropped and
# main's milestone printed after branch: (else after task:) — AC10's show.
milestone_view() {
  _mvk=task; grep -q '^branch: ' "$1" && _mvk=branch     # legacy pointers have no branch: line
  ST_MS="$(main_milestone)" ST_K="$_mvk" awk '
    /^## Ledger/ { inl = 1 }
    !inl && /^milestone: / { next }
    { print }
    !inl && !done && index($0, ENVIRON["ST_K"] ": ") == 1 { print "milestone: " ENVIRON["ST_MS"]; done = 1 }' "$1"
}
# pre_verb VERB — runs first in get, set, show, ledger, check, reset and
# worktree. Empty here; #42 T4 fills it.
pre_verb() { :; }

# in_list WORD LIST — succeed when WORD is one of the space-separated LIST.
in_list() {
  for _w in $2; do [ "$_w" = "$1" ] && return 0; done
  return 1
}

# write_idle_state FILE [nomilestone] — the idle template, shared by every
# init form. Only the main pointer carries the milestone line (AC10): local
# pointers and story files pass nomilestone.
write_idle_state() {
  {
    printf '# Studio State\n\nstage: idle\nspec: -\nplan: -\ntask: -\nbranch: -\n'
    [ "${2:-}" = nomilestone ] || printf 'milestone: prototype\n'
    printf '\n## Ledger\n\n'
  } > "$1"
}

need_state() {
  if [ -n "$STORY" ]; then
    [ -f "$STATE" ] || fail "no story $STORY"
    return 0
  fi
  # AC3: a pointer-less worktree needs only the main pointer.
  if [ "$POINTERLESS" = 1 ]; then
    [ -f "$MAIN" ] || fail "no $MAIN here — run 'studio-state init' in the project root"
    return 0
  fi
  [ -f "$STATE" ] || fail "no $STATE here — run 'studio-state init' in the project root"
}

# write_field KEY VALUE — replace the first "KEY: " header line. Only that
# line is replaced; ledger lines start with "- " and can never match. The
# value travels through the environment, not `awk -v`, which would turn a
# "\n" in a path into a real newline and split the header.
write_field() {
  _tmp="$STATE.tmp.$$"
  STUDIO_STATE_VALUE="$2" awk -v k="$1" '
    BEGIN { done = 0 }
    !done && $0 ~ ("^" k ": ") { print k ": " ENVIRON["STUDIO_STATE_VALUE"]; done = 1; next }
    { print }
  ' "$STATE" > "$_tmp"
  mv "$_tmp" "$STATE"
}

# set_field KEY VALUE — write_field guarded by the same damaged-file check
# `set` uses, so a header line that went missing is never silently skipped.
set_field() {
  grep -q "^$1: " "$STATE" || fail "no '$1:' line in $STATE — the file is damaged; restore the header"
  write_field "$1" "$2"
}

# set_branch VALUE — set_field for `branch`, except that a STATE.md written
# before the key existed gains the line right after its first `task:` line.
# Every other missing header line stays set_field's damaged-file error.
set_branch() {
  if grep -q '^branch: ' "$STATE"; then
    write_field branch "$1"
    return 0
  fi
  grep -q '^task: ' "$STATE" || fail "no 'task:' line in $STATE — the file is damaged; restore the header"
  _tmp="$STATE.tmp.$$"
  STUDIO_STATE_VALUE="$1" awk '
    BEGIN { done = 0 }
    { print }
    !done && /^task: / { print "branch: " ENVIRON["STUDIO_STATE_VALUE"]; done = 1 }
  ' "$STATE" > "$_tmp"
  mv "$_tmp" "$STATE"
}

# shq WORD — WORD single-quoted for sh, so a printed command survives a path
# with spaces or quotes when it is pasted or run.
shq() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# field KEY — the current value of a header field. A pointer-less worktree
# has no story (AC3): stage idle, every other field -.
field() {
  if [ "$POINTERLESS" = 1 ]; then
    if [ "$1" = stage ]; then printf 'idle\n'; else printf -- '-\n'; fi
    return 0
  fi
  sed -n "s/^$1: //p" "$STATE" | head -n 1
}

# feature_slug — the ledger file stem for the current spec: its basename
# without .md and without a leading YYYY-MM-DD-; empty when no spec is set.
feature_slug() {
  _spec="$(field spec)"
  case "$_spec" in ''|-) return 0 ;; esac
  slug_of "$_spec"
}

# ledger_file — where a ledger line goes: the feature ledger when a spec is
# set, else STATE.md's own ledger section.
ledger_file() {
  if [ -n "$STORY" ]; then printf '%s\n' "$LEDGER_DIR/$STORY.md"; return 0; fi
  _slug="$(feature_slug)"
  if [ -n "$_slug" ]; then printf '%s\n' "$LEDGER_DIR/$_slug.md"; else printf '%s\n' "$STATE"; fi
}

# truth_lines FILE — FILE's lines after its last `adopt reset` line (all of
# them when there is none): the ledger studio-adopt and check read (#35 D2).
truth_lines() {
  awk '/^- [0-9-]+ adopt reset /{ n = NR } { l[NR] = $0 } END { for (i = n + 1; i <= NR; i++) print l[i] }' "$1"
}

cmd="${1:-}"
[ -n "$cmd" ] || usage

case "$cmd" in
  root)
    case "${2:-}" in
      '') printf '%s\n' "$STATE_ROOT" ;;
      --work) printf '%s\n' "$WORK_ROOT" ;;
      *) usage ;;
    esac
    ;;
  init)
    if [ "${2:-}" = --local ]; then
      [ -z "$STORY" ] || fail "init --local cannot be combined with STUDIO_STORY"
      [ "$LINKED" = 1 ] || fail "init --local: the main checkout keeps $STATE_ROOT/.studio/STATE.md — run it in a run worktree"
      [ ! -f "$LOCAL" ] || fail "init --local: $LOCAL already exists"
      # AC8: the explicit form of auto-create — the same function, under the
      # mutex (a no-op when <root>/.studio is missing, f3-N3).
      lock_or_fail
      make_local_pointer "$WORK_ROOT"
      printf 'initialised %s (local stage pointer)\n' "$LOCAL"; exit 0
    fi
    if [ -n "$STORY" ]; then
      mkdir -p "$STATE_ROOT/.studio/stories"
      if [ ! -f "$STATE" ]; then
        write_idle_state "$STATE" nomilestone
      fi
      exclude_once .studio/stories/
      printf 'initialised %s\n' "$STATE"
      exit 0
    fi
    # AC9: a linked worktree never creates the main pointer over an existing one;
    # its own pointer comes from its first write or init --local.
    [ "$LINKED" = 0 ] || [ ! -f "$MAIN" ] || fail "this is a linked worktree — its stage pointer is created on its first write; to create it now, run studio-state init --local"
    [ ! -f "$MAIN" ] || fail "$MAIN already exists"
    mkdir -p "$STATE_ROOT/.studio" "$LEDGER_DIR"
    write_idle_state "$MAIN"
    # The studio defaults; the session hook reads this file for its identity
    # line and a project overrides keys here.
    if [ ! -f "$CONFIG" ]; then
      printf '{ "engine": "godot4", "dimension": "2d", "language": "gdscript", "tests": "gut" }\n' > "$CONFIG"
    fi
    # The pointer is local to this checkout: ignore it once, where it lives.
    if [ -e "$STATE_ROOT/.git" ]; then
      _gi="$STATE_ROOT/.gitignore"
      if ! grep -qxF '.studio/STATE.md' "$_gi" 2>/dev/null; then
        # A gitignore missing its trailing newline would otherwise run
        # together with the appended line.
        if [ -s "$_gi" ] && [ -n "$(tail -c 1 "$_gi")" ]; then
          printf '\n' >> "$_gi"
        fi
        printf '.studio/STATE.md\n' >> "$_gi"
      fi
    fi
    printf 'initialised %s\n' "$MAIN"
    ;;
  get)
    pre_verb get
    need_state
    key="${2:-}"
    in_list "$key" "$KEYS" || usage
    # AC10: the milestone is project-wide — the main pointer's, everywhere.
    if [ "$key" = milestone ]; then main_milestone; else field "$key"; fi
    ;;
  set)
    pre_verb set
    need_state
    [ $# -eq 3 ] || usage
    key="$2"
    # A real newline in a value would split the header into two lines.
    val="$(printf '%s' "$3" | tr '\n\r' '  ')"
    in_list "$key" "$KEYS" || usage
    [ -n "$val" ] || usage
    case "$key" in
      stage) in_list "$val" "$STAGES" || fail "stage must be one of: $STAGES" ;;
      milestone) in_list "$val" "$MILESTONES" || fail "milestone must be one of: $MILESTONES" ;;
      task)
        case "$val" in
          -) ;;
          *) printf '%s' "$val" | grep -qE '^[0-9]+/[0-9]+$' || fail "task must be n/N or -" ;;
        esac ;;
    esac
    # AC10/AC11/AC27: set milestone writes the main pointer, from every
    # checkout and under STUDIO_STORY, under the mutex; it never auto-creates.
    if [ "$key" = milestone ]; then
      [ -f "$MAIN" ] || fail "no main pointer — run studio-state init in $STATE_ROOT"
      lock_or_fail
      STATE="$MAIN"
      set_field milestone "$val"
      exit 0
    fi
    # AC5: STUDIO_STORY writes are unchanged and unlocked. Every other write
    # holds the mutex (AC27); a pointer-less worktree's first one creates its
    # pointer (AC6).
    if [ -z "$STORY" ]; then
      lock_or_fail
      [ "$POINTERLESS" = 0 ] || auto_create
    fi
    if [ "$key" = branch ]; then set_branch "$val"; else set_field "$key" "$val"; fi
    ;;
  show)
    pre_verb show
    need_state
    if [ "$POINTERLESS" = 1 ]; then
      # AC3: the idle header with main's milestone, and no story. Built in a
      # temp file outside the checkout: a read writes nothing here.
      _iv="$(mktemp "${TMPDIR:-/tmp}/studio-state.XXXXXX")" || fail "cannot create a temp file"
      write_idle_state "$_iv" nomilestone
      milestone_view "$_iv"
      rm -f "$_iv"
      printf '(no story in this checkout)\n'
      exit 0
    fi
    milestone_view "$STATE"
    _lf="$(ledger_file)"
    if [ "$_lf" != "$STATE" ] && [ -f "$_lf" ]; then
      printf '\n## Feature ledger: %s\n\n' "$(basename "$_lf" .md)"
      cat "$_lf"
    fi
    ;;
  ledger)
    pre_verb ledger
    need_state
    shift
    # All remaining words form the entry, so an unquoted call keeps its text;
    # an embedded newline is folded to a space so an entry stays one line.
    text="$(printf '%s' "$*" | tr '\n' ' ')"
    [ -n "$text" ] || usage
    if [ -z "$STORY" ]; then
      lock_or_fail
      [ "$POINTERLESS" = 0 ] || auto_create
    fi
    _lf="$(ledger_file)"
    if [ "$_lf" != "$STATE" ] && [ ! -f "$_lf" ]; then
      mkdir -p "$LEDGER_DIR"
      printf '# Ledger — %s\n\n' "$(basename "$_lf" .md)" > "$_lf"
    fi
    printf -- '- %s %s\n' "$(today)" "$text" >> "$_lf"
    ;;
  check)
    pre_verb check
    need_state
    [ $# -le 2 ] || usage
    rebuild=0
    case "${2:-}" in '') ;; --rebuild) rebuild=1 ;; *) usage ;; esac
    # AC3/AC7: a pointer-less worktree has nothing to check or rebuild.
    if [ "$POINTERLESS" = 1 ]; then
      if [ "$rebuild" = 1 ]; then printf 'no story in this checkout\n'; else printf 'check: ok\n'; fi
      exit 0
    fi
    [ "$rebuild" = 0 ] || [ -n "$STORY" ] || lock_or_fail
    if [ -n "$STORY" ] && [ "$rebuild" = "1" ]; then
      _task="$(field task)"
      case "$_task" in
        ''|-)
          _plan="$(field plan)"
          case "$_plan" in ''|-) fail "check --rebuild needs a plan to count tasks" ;; esac
          case "$_plan" in /*) _pf="$_plan" ;; *) _pf="$WORK_ROOT/$_plan" ;; esac
          [ -f "$_pf" ] || fail "plan file missing: $_plan"
          # Only the tasks above ## Backlog: a producer cut keeps its heading.
          _N="$(awk '/^## Backlog/ { exit } /^### Task [0-9]/ { n++ } END { print n + 0 }' "$_pf")"
          set_field task "0/$_N" ;;
        *) _N="${_task#*/}" ;;
      esac
      _lf="$(ledger_file)"
      _k=0
      _max=0
      if [ -f "$_lf" ]; then
        _nums="$(truth_lines "$_lf" | sed -n 's/^- [0-9-]* T\([0-9]*\) complete.*/\1/p' | sort -n -u)"
        for _m in $_nums; do
          if [ "$_m" -eq $((_k + 1)) ]; then _k="$_m"; fi
          _max="$_m"
        done
      fi
      if [ "$_max" -gt $((_k + 1)) ]; then
        printf 'check: ledger gap: T%s missing\n' "$((_k + 1))"
        exit 1
      fi
      set_field task "$_k/$_N"
      printf 'check: task rebuilt to %s/%s from the ledger\n' "$_k" "$_N"
      exit 0
    fi
    problems=0
    for k in spec plan; do
      v="$(field "$k")"
      case "$v" in ''|-) continue ;; esac
      case "$v" in /*) f="$v" ;; *) f="$WORK_ROOT/$v" ;; esac
      if [ ! -f "$f" ]; then printf 'check: %s file missing: %s\n' "$k" "$v"; problems=1; fi
    done
    # The highest "T<n> complete" in the ledger is what has actually shipped.
    _lf="$(ledger_file)"
    done_n=0
    if [ -f "$_lf" ]; then
      done_n="$(truth_lines "$_lf" | sed -n 's/^- [0-9-]* T\([0-9]*\) complete.*/\1/p' | sort -n | tail -n 1)"
      done_n="${done_n:-0}"
    fi
    task="$(field task)"
    case "$task" in
      ''|-) ;;
      *)
        n="${task%%/*}"; N="${task#*/}"
        if [ "$n" -gt "$N" ]; then printf 'check: task %s has n > N\n' "$task"; problems=1; fi
        if [ "$done_n" -gt "$n" ]; then
          if [ "$rebuild" = "1" ]; then
            set_field task "$done_n/$N"
            printf 'check: task rebuilt to %s/%s from the ledger\n' "$done_n" "$N"
          else
            printf 'check: ledger says T%s complete but task is %s — run check --rebuild\n' "$done_n" "$task"
            problems=1
          fi
        elif [ "$done_n" -lt "$n" ]; then
          printf 'check: note — ledger has T%s complete, task is %s (execute may be on another branch)\n' "$done_n" "$task"
        fi ;;
    esac
    [ "$problems" = "0" ] && printf 'check: ok\n'
    exit "$problems"
    ;;
  reset)
    pre_verb reset
    need_state
    [ $# -le 2 ] || usage
    keep=0
    case "${2:-}" in '') ;; --keep-ledger) keep=1 ;; *) usage ;; esac
    # AC7: a pointer-less worktree has nothing to reset, and writes nothing.
    if [ "$POINTERLESS" = 1 ]; then printf 'no story in this checkout\n'; exit 0; fi
    [ -n "$STORY" ] || lock_or_fail
    spec="$(field spec)"
    _lf="$(ledger_file)"
    if [ "$_lf" != "$STATE" ]; then
      if [ "$keep" = "0" ] && [ -f "$_lf" ]; then rm -f "$_lf"; fi
      printf -- '- %s abandoned %s\n' "$(today)" "$spec" >> "$STATE"
    fi
    set_field stage idle
    set_field spec -
    set_field plan -
    set_field task -
    set_branch -
    printf 'reset to idle\n'
    ;;
  worktree)
    pre_verb worktree
    need_state
    [ $# -eq 1 ] || usage
    # AC3: a pointer-less worktree has no story, so no branch.
    [ "$POINTERLESS" = 0 ] || fail "no feature branch recorded"
    br="$(field branch)"
    case "$br" in ''|-) fail "no feature branch recorded" ;; esac
    git show-ref --verify --quiet "refs/heads/$br" 2>/dev/null || fail "branch $br no longer exists"
    # One record per `git worktree list --porcelain` block that holds the
    # branch: "<prunable 0|1><TAB><locked 0|1><TAB><path>". The ref is
    # compared whole, so feat/x never matches feat/x-2.
    _tab="$(printf '\t')"
    _recs="$(git worktree list --porcelain 2>/dev/null | STUDIO_STATE_REF="refs/heads/$br" awk '
      function flush() {
        if (hit) printf "%d\t%d\t%s\n", prunable, locked, path
        hit = 0; prunable = 0; locked = 0; path = ""
      }
      /^worktree / { flush(); path = substr($0, 10); next }
      $0 == "branch " ENVIRON["STUDIO_STATE_REF"] { hit = 1; next }
      /^prunable( |$)/ { prunable = 1; next }
      /^locked( |$)/ { locked = 1; next }
      END { flush() }
    ')"
    _prefix=""
    while IFS="$_tab" read -r _pr _lk _p; do
      [ -n "$_p" ] || continue
      if [ "$_pr" = 0 ] && [ -d "$_p" ]; then
        printf '%s\n' "$_p"
        exit 0
      fi
      # A stale entry still holds the branch, and git refuses to add a second
      # worktree for it. Claude Code locks its worktrees and git never marks
      # a locked entry prunable: unlock it first, then prune.
      if [ "$_lk" = 1 ]; then
        _prefix="git worktree unlock $(shq "$_p") && git worktree prune && "
      elif [ -z "$_prefix" ]; then
        _prefix="git worktree prune && "
      fi
    done <<EOF
$_recs
EOF
    _name="$(printf '%s' "$br" | tr '/' '-')"
    printf 'studio-state: no worktree has %s checked out\n' "$br" >&2
    printf '%sgit worktree add %s %s\n' "$_prefix" "$(shq "$STATE_ROOT/.claude/worktrees/$_name")" "$(shq "$br")" >&2
    exit 3
    ;;
  *)
    usage
    ;;
esac
