#!/bin/sh
# studio-overnight — run an approved plan to a draft PR unattended: one fresh
# `claude-gd -p "/game-dev:execute --one"` session per unit, until the
# feature ships or a stop rule fires. Reads studio state, never writes it.
#
#   studio-overnight start [--dry-run]   preflight, then run (dry run: print the launch line)
#   studio-overnight status              the live run: dir, unit, task, spend, pid
#   studio-overnight stop                end the run after the running unit
#
# Exit: start 0 done · 1 any other ending · 2 refused. status 0 live · 1 no
# run. stop 0 stop requested · 1 no run.
# Self-contained on purpose (copy mode); calls its sibling studio-state.
set -u

PROMPT="/game-dev:execute --one"
SELF_ABS="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
SELF_DIR="$(cd "$(dirname "$self")" && pwd -P)"
STATE_BIN="$SELF_DIR/studio-state"
DENY_FILE="$SELF_DIR/overnight-deny.txt"

say() { printf 'studio-overnight: %s\n' "$*" >&2; }
state() { ( cd "$START_DIR" && sh "$STATE_BIN" "$@" ); }
FAILED=0
refuse() { say "$*"; FAILED=1; }

# cfg_raw KEY — the raw token after "KEY": in config.json; empty when absent.
cfg_raw() {
  [ -f "$CONFIG" ] || return 0
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([^,}[:space:]]*\).*/\1/p' "$CONFIG" | head -n 1
}
# cfg KEY DEFAULT MIN MAX int|dec — sets the variable named by KEY's upper
# case; a present value outside the range or of the wrong kind is a refusal.
cfg() {
  _v="$(cfg_raw "$1")"
  [ -n "$_v" ] || _v="$2"
  case "$5" in
    int) printf '%s' "$_v" | grep -Eq '^[0-9]+$' ;;
    dec) printf '%s' "$_v" | grep -Eq '^[0-9]+(\.[0-9]+)?$' ;;
  esac || { refuse "config overnight.$1 must be a number from $3 to $4 ($5), got $_v"; return; }
  awk -v v="$_v" -v lo="$3" -v hi="$4" 'BEGIN { exit !(v >= lo && v <= hi) }' \
    || { refuse "config overnight.$1 must be from $3 to $4, got $_v"; return; }
  eval "$(printf '%s' "$1" | tr 'a-z' 'A-Z')=\$_v"
}

# with_launch_args FN — FN with the session's argv: prompt first, then the
# flags, --disallowedTools last with one argument per deny rule.
with_launch_args() {
  _fn="$1"
  set -- "$PROMPT" --output-format stream-json --verbose \
    --permission-mode auto --permission-prompts none \
    --max-budget-usd "$SESSION_USD" --disallowedTools
  while IFS= read -r _r || [ -n "$_r" ]; do
    _r="$(printf '%s' "$_r" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    case "$_r" in ''|'#'*) continue ;; esac
    set -- "$@" "$_r"
  done < "$DENY_FILE"
  "$_fn" "$@"
}
print_launch() {
  printf 'cd %s && OMEGA_AUTOPILOT=1 claude-gd -p' "'$START_DIR'"
  for _a in "$@"; do printf " '%s'" "$_a"; done
  printf '\n'
}

lock_pid() { sed -n 's/^pid=//p' "$LOCK" 2>/dev/null | head -n 1; }
lock_live() {
  _p="$(lock_pid)"
  [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null \
    && ps -o args= -p "$_p" 2>/dev/null | grep -q studio-overnight
}
# take_lock RUN_DIR — noclobber, so two starts cannot both win.
take_lock() {
  ( set -C
    printf 'pid=%s\nrun=%s\nstarted=%s\n' "$$" "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$LOCK"
  ) 2>/dev/null
}

usage() {
  cat <<EOF
usage: $SELF_ABS start [--dry-run] | status | stop

  start [--dry-run]  preflight, then run the approved plan one unit per fresh
                     claude-gd session until it ships or a stop rule fires.
                     --dry-run runs the preflight and prints the launch line.
  status             the live run: dir, unit, task k/N, spend, pid (exit 1: no run)
  stop               end the run after the running unit (exit 1: no run)

Exit: start 0 done, 1 any other ending, 2 refused.

Config: .studio/config.json "overnight" (defaults, ranges):
  session_usd          25    1-200    budget cap per session (USD)
  run_usd              150   1-2000   budget cap for the whole run (USD)
  session_minutes      90    10-480   wall-clock cap per session
  retries              1     0-3      retries of an unchanged unit
  kill_grace_seconds   30    5-120    TERM-to-KILL grace
A value present but out of range or not a number is a refusal.

Deny rules: $DENY_FILE
  one --disallowedTools rule per line.

The morning report is written to .studio/reports/overnight-<ts>/report.md on
every ending.

Test hook:
  STUDIO_OVERNIGHT_SESSION_SECONDS — test hook: overrides session_minutes in seconds
EOF
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  '') usage >&2; exit 2 ;;
esac

START_DIR="$(sh "$STATE_BIN" root --work 2>/dev/null || true)"
STATE_ROOT="$(sh "$STATE_BIN" root 2>/dev/null || true)"
CONFIG="$START_DIR/.studio/config.json"
LOCK="$STATE_ROOT/.studio/overnight.lock"
STOP_FILE="$STATE_ROOT/.studio/overnight.stop"
REPORTS="$STATE_ROOT/.studio/reports"

preflight() {
  FAILED=0
  _stage="$(state get stage 2>/dev/null)" || {
    refuse "no studio state here (run from the project checkout)"
    exit 2
  }
  plan="$(state get plan 2>/dev/null)"
  spec="$(state get spec 2>/dev/null)"
  state show 2>/dev/null | grep -qF -- "plan approved $plan" \
    || refuse "plan not approved: no 'plan approved $plan' ledger line"
  if [ -n "$(git -C "$START_DIR" status --porcelain -- "$spec" "$plan" 2>/dev/null)" ]; then
    refuse "uncommitted spec or plan — commit them first"
  fi
  if [ -n "$(git -C "$START_DIR" status --porcelain -- .studio/ledger .studio/config.json 2>/dev/null)" ]; then
    refuse "uncommitted ledger change — read the Stop: line, resolve it, commit"
  fi
  grep -q '^## Decisions' "$START_DIR/$plan" 2>/dev/null \
    || refuse "plan has no ## Decisions section (run /omega:autopilot's question sweep)"
  case "$_stage" in
    plan|execute) ;;
    *) refuse "stage $_stage: nothing approved to run" ;;
  esac
  if ! { command -v claude-gd >/dev/null 2>&1 && claude-gd --version >/dev/null 2>&1; }; then
    refuse "claude-gd not found or not working"
  fi
  gh auth status >/dev/null 2>&1 || refuse "gh auth status failed — log in first"
  if [ ! -f "$DENY_FILE" ] || ! grep -Evq '^[[:space:]]*(#|$)' "$DENY_FILE"; then
    refuse "$DENY_FILE: no deny rules"
  fi
  cfg session_usd 25 1 200 dec
  cfg run_usd 150 1 2000 dec
  cfg session_minutes 90 10 480 int
  cfg retries 1 0 3 int
  cfg kill_grace_seconds 30 5 120 int
  GRACE="${KILL_GRACE_SECONDS:-30}"
  if lock_live; then
    refuse "a run is live (pid $(lock_pid)) — studio-overnight status"
  fi
  [ "$FAILED" -eq 0 ] || exit 2
}

cmd_start() {
  _dry=0
  [ "${1:-}" != "--dry-run" ] || _dry=1
  preflight
  if [ "$_dry" -eq 1 ]; then
    with_launch_args print_launch
    exit 0
  fi
  RUN_DIR="$REPORTS/overnight-$(date +%Y%m%d-%H%M%S)"
  if [ -f "$LOCK" ]; then
    say "reclaiming stale lock (pid $(lock_pid))"
    rm -f "$LOCK"
  fi
  mkdir -p "$RUN_DIR" "$(dirname "$LOCK")"
  take_lock "$RUN_DIR" || { say "lock taken by another start"; exit 2; }
  trap 'rm -f "$LOCK"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  [ -f "$REPORTS/.gitignore" ] || printf '*\n' > "$REPORTS/.gitignore"
  _excl="$(git -C "$START_DIR" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  mkdir -p "$(dirname "$_excl")"
  for _e in .studio/overnight.lock .studio/overnight.stop; do
    grep -qxF "$_e" "$_excl" 2>/dev/null || printf '%s\n' "$_e" >> "$_excl"
  done
  rm -f "$STOP_FILE"
  # The unit loop arrives in Task 2.
  printf '# Overnight run\n\nEnding: stop: not implemented\n' > "$RUN_DIR/report.md"
  exit 1
}

case "$1" in
  start)  shift; cmd_start "$@" ;;
  status) echo "no run"; exit 1 ;;
  stop)   echo "no run"; exit 1 ;;
  *)      usage >&2; exit 2 ;;
esac
