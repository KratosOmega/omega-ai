#!/bin/sh
# studio-overnight — run an approved plan to a draft PR unattended: one fresh
# `claude-gd -p "/game-dev:execute --one"` session per unit, until the
# feature ships or a stop rule fires. Reads studio state, never writes it.
#
#   studio-overnight start [--dry-run]   preflight, then run (dry run: print the launch line)
#   studio-overnight start [--dry-run] <manifest>   manifest mode (overnight-lanes.sh)
#   studio-overnight status [--follow]   the live run: dir, unit, task, spend, pid,
#                                        the running unit's last activity; from any
#                                        directory (the ~/.claude-gamedev/runs registry)
#   studio-overnight watch [<seconds>]   status, refreshed until Ctrl-C
#   studio-overnight stop                end the run after the running unit
#
# Exit: start 0 done · 1 any other ending · 2 refused. status 0 this
# project's run is live · 1 no run · 3 (outside a project) live elsewhere.
# watch 0. stop 0 stop requested · 1 no run.
# check-id 0 free · 1 taken · 2 usage.
# Self-contained on purpose (copy mode); calls its siblings studio-state
# (the single-plan story is read where its pointer is: story_dir, #42),
# studio-event and studio-env, and sources overnight-lanes.sh, -channel.sh and
# -progress.sh. status prints a progress bar with a rough finish time, then the
# resource readout (studio-env).
set -u

# Manifest mode's per-unit words, set only by overnight-lanes.sh: never taken
# from the user's environment, so a single-plan run evaluates and uses none.
LAUNCH_ENV=""; UNIT_CWD=""; LDIR=""
# #59 D2: the runner's own gates (merge, final gate) are never capped; a
# session gets STUDIO_GATE_MINUTES only through its launch words.
unset STUDIO_GATE_MINUTES
# The single-plan run's spec (#42 AC38): set by take_lock in the runner, never
# taken from the user's environment; other processes read the lock's spec=.
RUN_SPEC=""
PROMPT="/game-dev:execute --one"
SELF_ABS="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in /*) self="$link" ;; *) self="$(dirname "$self")/$link" ;; esac
done
SELF_DIR="$(cd "$(dirname "$self")" && pwd -P)"
STATE_BIN="$SELF_DIR/studio-state"
DENY_FILE="$SELF_DIR/overnight-deny.txt"

say() { printf 'studio-overnight: %s\n' "$*" >&2; }
# sq TEXT — TEXT as one single-quoted shell word ('\'' for each ').
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
# start_state ARGS — studio-state in the start checkout (the preflight, and
# the run's spec at take_lock).
start_state() { ( cd "$START_DIR" && sh "$STATE_BIN" "$@" ); }
# run_spec — AC38 (f2-M6): the single-plan run's spec. RUN_SPEC in the runner;
# elsewhere the lock's spec=, else its registry entry's. "" for a manifest run,
# a pre-#42 record, or spec -.
run_spec() {
  _rp_s="${RUN_SPEC:-}"
  [ -n "$_rp_s" ] || _rp_s="$(runs_kv spec "$LOCK")"
  if [ -z "$_rp_s" ]; then
    _rp_r="$(runs_kv run "$LOCK")"
    for _rp_e in "${REGISTRY:-$HOME/.claude-gamedev/runs}"/overnight-* "${REGISTRY:-$HOME/.claude-gamedev/runs}/last"; do
      [ -f "$_rp_e" ] && [ -n "$_rp_r" ] && [ "$(runs_kv run "$_rp_e")" = "$_rp_r" ] || continue
      _rp_s="$(runs_kv spec "$_rp_e")"; break
    done
  fi
  [ "$_rp_s" != - ] || _rp_s=""
  printf '%s\n' "$_rp_s"
}
# story_resolve — AC38: STORY_DIR, the checkout whose pointer holds the run's
# story, in the current shell. START_DIR under STUDIO_STORY or with no persisted
# spec, and while START_DIR's own spec is the run's; else the one `stories`
# line with that spec (run lines skipped); else main's newest handed line for
# it when its path is a live worktree. 1 with STORY_WHY when ambiguous or gone
# (STORY_DIR stays START_DIR, so it is always a usable directory).
story_resolve() {
  STORY_DIR="$START_DIR"; STORY_WHY=""
  [ -z "${STUDIO_STORY:-}" ] || return 0
  _sy_s="$(run_spec)"
  [ -n "$_sy_s" ] || return 0
  [ "$(start_state get spec 2>/dev/null)" != "$_sy_s" ] || return 0
  _sy_h="$(start_state stories 2>/dev/null | ST_S="$_sy_s" awk -F'\t' '$4 == ENVIRON["ST_S"] && $6 != "run" { print $1 }')"
  case "$(printf '%s\n' "$_sy_h" | grep -c .)" in
    1) STORY_DIR="$_sy_h"; return 0 ;;
    0) ;;
    *) STORY_WHY="ambiguous story $_sy_s"; return 1 ;;
  esac
  # Handed paths are `pwd -P` paths, as studio-state records them.
  _sy_p="$(ST_S="$_sy_s" awk -F'\t' '/^## Ledger/ { f = 1; next }
          f && $1 ~ / handed$/ && $2 == "spec=" ENVIRON["ST_S"] { p = $NF } END { sub(/^path=/, "", p); print p }' \
          "$STATE_ROOT/.studio/STATE.md" 2>/dev/null)"
  if [ -n "$_sy_p" ] && [ -d "$_sy_p" ] && git -C "$START_DIR" worktree list --porcelain 2>/dev/null | grep -qxF "worktree $_sy_p"; then
    STORY_DIR="$_sy_p"; return 0
  fi
  STORY_WHY="story $_sy_s not found"; return 1
}
# story_dir — STORY_DIR as story_resolve finds it (START_DIR when unresolved).
story_dir() { story_resolve || true; printf '%s\n' "$STORY_DIR"; }
# state ARGS — studio-state where the run's story is (story_dir).
state() { _st_d="$(story_dir)"; ( cd "$_st_d" && sh "$STATE_BIN" "$@" ); }
FAILED=0
refuse() { say "$*"; FAILED=1; }

# cfg_raw KEY — the raw token after "KEY": in config.json; empty when absent.
cfg_raw() {
  [ -f "$CONFIG" ] || return 0
  sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([^,}[:space:]]*\).*/\1/p' "$CONFIG" | head -n 1
}
# cfg KEY DEFAULT MIN MAX int|dec — sets the variable named by KEY's upper
# case; a present value outside the range or of the wrong kind is a refusal.
cfg() {
  _v="$(cfg_raw "$1")"
  [ -n "$_v" ] || _v="$2"
  case "$5" in
    int) printf '%s' "$_v" | grep -Eq '^[0-9]+$' ;;
    dec) printf '%s' "$_v" | grep -Eq '^[0-9]+(\.[0-9]+)?$' ;;
  esac || { refuse "config overnight.$1 must be a number from $3 to $4 ($5), got $_v"; return; }
  awk -v v="$_v" -v lo="$3" -v hi="$4" 'BEGIN { exit !(v >= lo && v <= hi) }' \
    || { refuse "config overnight.$1 must be from $3 to $4, got $_v"; return; }
  eval "$(printf '%s' "$1" | tr 'a-z' 'A-Z')=\$_v"
}

# hold_overrides — R26: STUDIO_OVERNIGHT_HOLD_MINUTES (0-1440) replaces
# hold_minutes; STUDIO_OVERNIGHT_HOLD_SECONDS (whole seconds) replaces only
# the deadline's length. Sets HOLD_MINUTES (normalized: awk reads 010 as 10),
# HOLD_ON (1 iff HOLD_MINUTES > 0) and HOLD_SECS. A bad value is a refusal.
hold_overrides() {
  _ho_m="${STUDIO_OVERNIGHT_HOLD_MINUTES:-}"
  if [ -n "$_ho_m" ]; then
    case "$_ho_m" in
      *[!0-9]*) refuse "STUDIO_OVERNIGHT_HOLD_MINUTES must be a whole number from 0 to 1440, got $_ho_m" ;;
      *) if awk -v v="$_ho_m" 'BEGIN { exit !(v <= 1440) }'; then HOLD_MINUTES="$_ho_m"
         else refuse "STUDIO_OVERNIGHT_HOLD_MINUTES must be a whole number from 0 to 1440, got $_ho_m"; fi ;;
    esac
  fi
  case "${STUDIO_OVERNIGHT_HOLD_SECONDS:-}" in
    *[!0-9]*) refuse "STUDIO_OVERNIGHT_HOLD_SECONDS must be a whole number of seconds, got $STUDIO_OVERNIGHT_HOLD_SECONDS" ;;
  esac
  HOLD_MINUTES="$(awk -v v="${HOLD_MINUTES:-0}" 'BEGIN { print v + 0 }')"
  HOLD_ON=0; [ "$HOLD_MINUTES" -eq 0 ] || HOLD_ON=1
  HOLD_SECS="$(awk -v s="${STUDIO_OVERNIGHT_HOLD_SECONDS:-}" -v m="$HOLD_MINUTES" 'BEGIN { print (s != "") ? s + 0 : m * 60 }')"
}

# cfg_str KEY DEFAULT REGEX — the quoted string value of "KEY" (first match
# anywhere in config.json); DEFAULT when absent. A value not matching REGEX is
# a refusal naming the key. Sets the variable named by KEY's upper case.
cfg_str() {
  _v=""
  [ ! -f "$CONFIG" ] || _v="$(sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" | head -n 1)"
  [ -n "$_v" ] || _v="$2"
  printf '%s\n' "$_v" | grep -Eq -- "$3" \
    || { refuse "config $1 must match $3, got $_v"; return; }
  eval "$(printf '%s' "$1" | tr 'a-z' 'A-Z')=\$_v"
}
# cfg_nobs KEY — cfg_str for a command line: unset is empty, and a backslash
# is refused (the reader would not decode it as a JSON escape).
cfg_nobs() {
  if [ -f "$CONFIG" ] && sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONFIG" | head -n 1 | grep -q '\\'; then
    refuse "config $1 must not contain a backslash (a JSON escape is not decoded); write the command without one, or put it in a script and name the script"
    return
  fi
  cfg_str "$1" '' '^[^\]*$'
}
# sub_escape TEXT — TEXT safe as a sed replacement with the | delimiter.
sub_escape() { printf '%s' "$1" | sed 's/[\\&|]/\\&/g'; }
# deny_rules — the deny file's rules, one per line: comments and blanks
# dropped, {default_branch} and {merge_basename} expanded; a line needing an
# empty {default_branch} or {merge_basename} is dropped.
deny_rules() {
  _db="$(sub_escape "${DEFAULT_BRANCH:-}")"; _mb="$(sub_escape "${MERGE_BASENAME:-}")"
  while IFS= read -r _r || [ -n "$_r" ]; do
    _r="$(printf '%s' "$_r" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
    case "$_r" in ''|'#'*) continue ;; esac
    case "$_r" in *'{default_branch}'*) [ -n "${DEFAULT_BRANCH:-}" ] || continue ;; esac
    case "$_r" in *'{merge_basename}'*) [ -n "${MERGE_BASENAME:-}" ] || continue ;; esac
    printf '%s\n' "$_r" | sed "s|{default_branch}|$_db|g; s|{merge_basename}|$_mb|g"
  done < "$DENY_FILE"
}
# cmd_deny_rules [--dir PATH] — the deny rules a unit would get for the
# project at PATH (default: here), one per line (AC1 of #28). Reads no run
# state; works outside git. Notes for dropped placeholders go to stderr.
cmd_deny_rules() {
  _dd="."
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --dir) [ "$#" -ge 2 ] || { usage >&2; exit 2; }; _dd="$2"; shift 2 ;;
      --dir=*) _dd="${1#--dir=}"; shift ;;
      *) usage >&2; exit 2 ;;
    esac
  done
  [ -n "$_dd" ] && [ -d "$_dd" ] || { say "deny-rules: not a directory: $_dd"; exit 2; }
  if [ ! -f "$DENY_FILE" ] || ! grep -Evq '^[[:space:]]*(#|$)' "$DENY_FILE"; then
    say "deny-rules: $DENY_FILE: no deny rules"; exit 1
  fi
  _dw="$(cd "$_dd" && sh "$STATE_BIN" root --work 2>/dev/null)" || _dw=""
  [ -n "$_dw" ] || _dw="$(cd "$_dd" && pwd -P)"
  DEFAULT_BRANCH="$(git -C "$_dw" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)" || DEFAULT_BRANCH=""
  DEFAULT_BRANCH="${DEFAULT_BRANCH#origin/}"
  CONFIG="$_dw/.studio/config.json"
  MERGE_COMMAND=""; cfg_str merge_command '' '.*'
  MERGE_BASENAME=""
  [ -z "$MERGE_COMMAND" ] || MERGE_BASENAME="$(basename "${MERGE_COMMAND%% *}")"
  _live="$(grep -Ev '^[[:space:]]*#' "$DENY_FILE")"
  if [ -z "$DEFAULT_BRANCH" ] && printf '%s\n' "$_live" | grep -q '{default_branch}'; then
    say "deny-rules: no origin/HEAD in $_dw — rules using {default_branch} dropped"
  fi
  if [ -z "$MERGE_BASENAME" ] && printf '%s\n' "$_live" | grep -q '{merge_basename}'; then
    say "deny-rules: no merge_command in $CONFIG — rules using {merge_basename} dropped"
  fi
  deny_rules
  exit 0
}
# model_for LABEL — sets UNIT_MODEL for a unit kind (D23); a -retry keeps its
# kind's. It runs in the current shell: an unknown label's exit 3 ends the
# runner (a runner error), not a command-substitution subshell.
model_for() {
  case "${1%-retry}" in
    T*) UNIT_MODEL="$MODEL_TASK" ;;
    final-review|check) UNIT_MODEL="$MODEL_FINAL" ;;
    finish) UNIT_MODEL="$MODEL_FINISH" ;;
    repair|final-repair|gate-repair|sync-repair) UNIT_MODEL="$MODEL_REPAIR" ;;
    progress) UNIT_MODEL="$MODEL_PROGRESS" ;;
    *) say "no model for unit $1"; exit 3 ;;
  esac
}

# with_launch_args FN — FN with the session's argv: prompt, --model, the
# flags, --disallowedTools last with one argument per deny rule.
with_launch_args() {
  _fn="$1"
  set -- "$PROMPT" --model "$UNIT_MODEL" --output-format stream-json --verbose \
    --permission-mode auto --permission-prompts none \
    --max-budget-usd "$SESSION_USD" --disallowedTools
  _rules="$(deny_rules)"
  while IFS= read -r _r || [ -n "$_r" ]; do
    [ -n "$_r" ] || continue
    set -- "$@" "$_r"
  done <<EOF
$_rules
EOF
  "$_fn" "$@"
}
# print_launch ARGS — the launch line; LAUNCH_ENV (manifest mode: a story's
# env words) replaces the default: the command caps (caps_env) then
# OMEGA_AUTOPILOT=1.
print_launch() {
  printf 'cd %s && %s claude-gd -p' "$(sq "$START_DIR")" "${LAUNCH_ENV:-$(caps_env) OMEGA_AUTOPILOT=1}"
  for _a in "$@"; do printf ' %s' "$(sq "$_a")"; done
  printf '\n'
}

lock_pid() { sed -n 's/^pid=//p' "$LOCK" 2>/dev/null | head -n 1; }
lock_live() {
  _p="$(lock_pid)"
  [ -n "$_p" ] && kill -0 "$_p" 2>/dev/null \
    && ps -o args= -p "$_p" 2>/dev/null | grep -q studio-overnight
}
# take_lock RUN_DIR — noclobber, so two starts cannot both win. The lock
# records the run's start dir (start=, D7) and, for a single-plan run, its
# spec (spec=, #42 AC38: RUN_SPEC), so story_dir resolves in any process.
take_lock() {
  [ -n "$RUN_SLUG" ] || RUN_SPEC="$(start_state get spec 2>/dev/null)"
  ( set -C
    { printf 'pid=%s\nrun=%s\nstarted=%s\nstart=%s\n' "$$" "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$START_DIR"
      [ -z "$RUN_SPEC" ] || printf 'spec=%s\n' "$RUN_SPEC"; } > "$LOCK"
  ) 2>/dev/null
}

usage() {
  cat <<EOF
usage: $SELF_ABS start [--dry-run | --detach] [<manifest>] | status [--run <slug>] | status --follow | watch [--run <slug>] [<seconds>] | stop | stop --run <slug> | stop --all | next [<manifest>] | check-id <id> [--plan <path>|-] [--ticket <ticket>|-] [--slug <slug>] [--branch <branch>|-] | activity [--open] <unit.jsonl> | deny-rules [--dir <path>]
       $SELF_ABS say|said|unsay|hold|resume|stop <story> [--run <run>] … (talking to a live run; below)

  start [--dry-run]  preflight, then run the approved plan one unit per fresh
                     claude-gd session until it ships or a stop rule fires.
                     --dry-run runs the preflight and prints the launch line.
                     When worktree_setup is set, start first checks it in a
                     scratch linked worktree (see Config).
  start [--dry-run] <manifest>
                     manifest mode (docs/runs/<slug>.md): preflight every
                     story; --dry-run prints the chains, each chain's first
                     launch line and the deny rule count.
  start --detach <manifest>
                     manifest mode, detached from the chat: preflight (the
                     worktree_setup check included: up to
                     worktree_setup_minutes) runs in the foreground (a
                     refusal or a signal exits 2), then the runner starts in
                     its own session with stdin /dev/null and output in
                     reports/overnight-<slug>-detached-<ts>.log (linked as
                     runner.log in the run dir). Every variable named
                     CLAUDECODE, CLAUDE_*, AI_AGENT, OMEGA_* or STUDIO_* is
                     removed (the test hooks below included);
                     CLAUDE_CONFIG_DIR and PATH stay. Exit 0 printing
                     "detached: pid <p>, log <path>" once status answers
                     within 10 s; else it prints the plain command.
  deny-rules [--dir <path>]
                     print the deny rules a unit would get for the project at
                     <path> (default: here), one per line; notes on stderr for
                     placeholders with no value; reads no run state
  next [<manifest>]  the planning loop: classify each manifest row (brainstorm,
                     plan, planned) and print the one next command; no argument
                     reads .studio/run. Reads files and ledger lines only.
  check-id <id> [--plan <path>|-] [--ticket <ticket>|-] [--slug <slug>] [--branch <branch>|-]
                     is <id> free for a new story? Taken (any case) when
                     origin/<default> holds another story's .studio/ledger/<id>.md
                     (its last plan approved or adopted path is not this
                     story's plan), another run's origin/integration/<slug>
                     holds it, another run's record under .studio/runs/
                     (archived ones too) lists it on another branch than
                     --branch (a story carried over keeps its id), or a plan under
                     docs/game-dev/plans/ on origin/<default> says Story: <id>.
                     Defaults: the row of .studio/run's manifest. No fetch.
                     Exit 0 free · 1 taken (each reason, then a free id to use
                     instead) · 2 usage
  status             the live run: a progress bar with a rough finish time, dir, unit,
                     task k/N, spend, pid, and the machine readout (studio-env)
                     (exit 1: no run)
                     A manifest run: one line per story (lane, state, unit,
                     task k/N), the gate holder, spend, pid; with no live run,
                     the last manifest run (a SIGKILLed one is swept and its
                     report written first), exit 1. A running unit gets one
                     more line: elapsed time and its last activity (the
                     subagent still running and the last tool call). An ended
                     run reads "ended (<ending>) — <id> stopped: <why> —
                     report: <path> — resume: <command>".
                     Works from any directory: outside a project it reads the
                     registry ~/.claude-gamedev/runs (one entry per live run;
                     "last" is the newest ended one) and shows every live run,
                     else the last ended one, else where it looked.
                     Exit 0 this project's run is live, 1 no run, 3 (outside
                     a project) a run is live elsewhere.
                     Several runs may be live in one project (each with its own
                     lock under .studio/runs/): status prints one block per run,
                     oldest first, each headed "== <slug> (<kind>, pid <pid>)".
                     status --run <slug> shows one (a slug or a run dir
                     basename); exit 1 "no live run <slug>" if it is not live.
  watch [--run <slug>] [<seconds>]
                     status every <seconds> (default 5) until Ctrl-C, like
                     status --follow; --run applies to watch only (it watches
                     one run). Exit 0.
  stop               end the run after the running unit (exit 1: no run); with
                     two or more live runs it stops none and lists them
  stop --run <slug>  end that run only (its own stop flag)
  stop --all         end every live run after its running unit
  activity <unit.jsonl>
                     one unit log's last activity in one line, as status shows it
  activity --open <unit.jsonl>
                     the log's open (unanswered) tool calls, newest first, one
                     per line, each cut to 120 characters

Talking to a live run (<story> is - in a single-plan run; every verb takes
--run <run>, a run dir basename, and then acts only on that live run):
  say <story> [--unit] '<text>' | say <story> [--unit] -- <text>
                     queue a message for the story's sessions; prints its id.
                     A story message is followed for the rest of the story and
                     recorded as a Directive ledger line; --unit: this unit
                     only. It arrives at the session's start or at its
                     next tool call (a session waiting on a subagent or a
                     long gate reads it when that returns). Empty text exits 2.
  said <story>       the story's directives: id, state, text
  unsay <story> <id> remove a pending message, or retire a directive
  hold <story>       hold the story at its next unit boundary (queued or
                     waiting: when it would start)
  resume <story>     a held story goes on with its next unit (lanes: after a
                     red gate, one gate-repair unit first); refused while the
                     start checkout's ledger has uncommitted changes
  stop <story>       end the story (stopped by operator; a story held by a rule:
                     stopped <rule's why>); its chain is skipped
  A stop rule after isolation holds the story for hold_minutes instead of
  ending it; say + resume, or stop, ends the hold, else the deadline does.
  A hold fixes what a session can be told; a red landing, the run budget,
  a whole-run stop or a dead runner still end at once.
  Exit: 0 done (stdout), 1 refused (one stderr line), 2 usage. Bare stop (no
  --run) keeps today's output: stdout, exit 0 or 1.
  Events: <run dir>/events.jsonl, schema v1 (docs/game-dev/overnight-events.md).

Exit: start 0 done, 1 any other ending, 2 refused.

Run selection: a story verb (say, said, unsay, hold, resume, stop <story>) acts
on the live run that lists the story; with two or more live runs and none
listing it, it refuses ("no live run lists <story>"). --run <slug or run dir
basename> picks the run explicitly.
install or pull omega-ai only when \`studio-overnight status\` shows no live run (a run reads the plugin while it runs)

The run may: commit, push the feature branch, open a draft PR.
The run may not: merge, force-push, delete a remote branch, read or write secrets.

A manifest run has two modes (Mode: in docs/runs/<slug>.md); sessions never
merge in either, the runner lands:
  integration  each shipped story is merged by the runner into integration/<slug>
               (a --no-ff merge commit); then one full gate and one draft PR
               integration -> main. Nothing is merged into main, and the final
               PR is never merged by the run.
  direct       each shipped story is merged into main by the runner through
               config merge_command <pr> (the project's own gate), one landing
               at a time, each dependent after its dependency.
Lanes are dependency chains, up to max_lanes at a time. next prints the planning
loop's one next command. The gate lock (.studio/gate.lock) lets one test or gate
run at a time across all lanes and the runner; a dead holder's lock is reclaimed.

Config: .studio/config.json "overnight" (defaults, ranges):
  session_usd          25    1-200    budget cap per session (USD)
  run_usd              0     0-5000   budget cap for the whole run (USD); 0 = no run-wide cap
  session_minutes      90    10-480   wall-clock cap per session (and per merge command).
                                    It sets each session's command caps: a Bash call with
                                    no timeout gets min(45, session_minutes/3) min
                                    (BASH_DEFAULT_TIMEOUT_MS); BASH_MAX_TIMEOUT_MS is the
                                    whole session; studio-gate stops a gate run (studio-test,
                                    studio-run, studio-setup) past min(60, session_minutes/2)
                                    min (STUDIO_GATE_MINUTES, exit 124). The preflight warns
                                    when the slowest recent studio-test (.studio/gate.times)
                                    × 1.2 + 10 min exceeds the session, or × 1.2 the gate cap.
  idle_minutes         20    0-120    end a unit whose session log has not grown for this
                                    long (outcome stalled), unless it waits on or runs a
                                    gate (studio-test, studio-run, studio-setup, studio-gate);
                                    0 = off
  worktree_setup       ""             command run once per new worktree under the gate lock
                                    (studio-setup); no backslash. Unset = nothing runs.
                                    Preflighted: start runs it once in a scratch linked
                                    worktree off the run's base and refuses on a failure
                                    (exit code and log shown); --dry-run only says so
  worktree_setup_minutes 20  1-120    cap on one worktree_setup run
  gate_command         ""             command the finish gate runs after the tests
                                    (studio-setup gate); no backslash. Unset = none
  retries              1     0-3      retries of an unchanged unit
  gate_repairs         2     0-3      lanes: gate-repair units per story after a red finish gate,
                                    each followed by a fresh finish (the full gate again);
                                    0 = a red gate stops the story
  kill_grace_seconds   30    5-120    TERM-to-KILL grace
  max_lanes            0     0-8      lane processes (0 = one per chain)
  max_sessions         6     1-8      claude sessions running at once across every live run
                                    in the project (read from the main checkout's config)
  model_task           sonnet   model for task units      (^[a-z0-9.-]+$)
  model_final          opus     model for the final review
  model_finish         sonnet   model for the finish
  model_repair         opus     model for a repair
  model_progress       sonnet   model for the progress unit
  hold_minutes         480   0-1440   minutes a held story waits for say/resume/stop;
                                    0 = a stop rule ends the story at once (no holds)
  directive_chars      4000  500-16000 cap on a story's active + pending directive text
A value present but out of range or not a number is a refusal.
Top level of config.json: "merge_command" — a command line containing <pr>,
its first word an executable file under the checkout.

Deny rules: $DENY_FILE
  one --disallowedTools rule per line.

The morning report is written to .studio/reports/overnight-<ts>/report.md on
every ending (manifest mode: overnight-<slug>-<ts>/report.md, a section per
story, the resume command and the cleanup command).

Environment:
  STUDIO_RUN_ORIGIN — optional tag (1-200 characters from A-Z a-z 0-9 . _ : -)
                     written as origin= in this run's registry entry; the
                     runner never interprets it and does not pass it to unit
                     sessions
  STUDIO_OVERNIGHT_SETUP_CHECKED — set by --detach for its child: the
                     commit the foreground worktree_setup check passed at;
                     start skips the check when it names the base's commit
                     and refuses (exit 2) when the base has moved since.
                     Never set it yourself

Test hooks (tests only; never set them for a real run; --detach strips them):
  STUDIO_OVERNIGHT_POLL_SECONDS — test hook: a whole number of seconds between
                     a lane's polls of a wait or a lock (default 5)
  STUDIO_OVERNIGHT_SLOT_POLL_SECONDS — test hook: seconds between a unit's
                     tries for a session slot (default 2)
  STUDIO_OVERNIGHT_LAND_HOOK — test hook: shell text evaluated after a landing's
                     push and before it is recorded (the crash-after-push test)
  STUDIO_OVERNIGHT_GATE_CMD — test hook: shell text that replaces the final
                     step's full gate commands
  STUDIO_OVERNIGHT_SESSION_SECONDS — test hook: overrides session_minutes in
                     seconds; a whole number, else start refuses
  STUDIO_OVERNIGHT_IDLE_SECONDS — test hook: whole seconds that replace
                     idle_minutes × 60 (idle_minutes 0 still turns the check off)
  STUDIO_OVERNIGHT_IDLE_POLL_SECONDS — test hook: whole seconds between idle
                     checks (default 30)
  STUDIO_OVERNIGHT_LABEL — test hook: forces every unit's label (the
                     unknown-label test); never set it for a real run
  STUDIO_OVERNIGHT_HEARTBEAT_SECONDS — test hook: seconds between the
                     running unit's heartbeat lines on stderr (default 60)
  STUDIO_OVERNIGHT_WATCH_COUNT — test hook: watch ends after this many
                     refreshes (default 0: until Ctrl-C)
  STUDIO_OVERNIGHT_DETACH_STATUS_CMD — test hook: shell text that replaces the
                     --detach status check (read before the strip)
  STUDIO_OVERNIGHT_DETACH_CHILD_CMD — test hook: shell text run in place of the
                     detached child's start (read before the strip)
  STUDIO_OVERNIGHT_RACE_HOOK — test hook: shell text evaluated between reading
                     a stale lock's pid and reclaiming it (the reclaim-race test)
  STUDIO_OVERNIGHT_HOLD_MINUTES — test hook: overrides hold_minutes; a whole
                     number 0-1440, else start refuses (the suites set 0)
  STUDIO_OVERNIGHT_HOLD_SECONDS — test hook: a hold's length in seconds, in
                     place of hold_minutes x 60; a whole number
  STUDIO_OVERNIGHT_INBOX_WAIT — test hook: seconds a verb waits for the
                     inbox lock (default 15)
  STUDIO_ENV_FIXTURE — test hook: a directory of canned outputs studio-env reads
                     in place of uname, sysctl, /proc, nproc, df, pmset and ps
EOF
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  '') usage >&2; exit 2 ;;
esac

START_DIR="$(sh "$STATE_BIN" root --work 2>/dev/null || true)"
STATE_ROOT="$(sh "$STATE_BIN" root 2>/dev/null || true)"
CONFIG="$START_DIR/.studio/config.json"
LOCK="$STATE_ROOT/.studio/overnight.lock"
STOP_FILE="$STATE_ROOT/.studio/overnight.stop"
REPORTS="$STATE_ROOT/.studio/reports"
RUN_SLUG=""   # a manifest run's slug (run_paths); empty for a single-plan run
# The project's live runs (#39): runs_live, runs_match, runs_stop_of, mx_*.
. "$SELF_DIR/overnight-runs.sh"
# The project-wide session cap (#39 AC27): sess_*; slots are taken by manifest units only (D19).
. "$SELF_DIR/overnight-sessions.sh"

# preflight [manifest] — bundle 2's checks. With `manifest`, the single-plan
# checks (spec, plan, ledger, stage on STATE.md) are skipped and a failure
# does not exit: overnight-lanes.sh adds its checks, then exits on any.
preflight() {
  FAILED=0
  _pf_mf="${1:-}"
  _stage="$(start_state get stage 2>/dev/null)" || {
    refuse "no studio state here (run from the project checkout)"
    exit 2
  }
  if [ -n "$_pf_mf" ]; then
    if [ -n "$(git -C "$START_DIR" status --porcelain -- .studio/config.json 2>/dev/null)" ]; then
      refuse "uncommitted .studio/config.json — commit it first"
    fi
  else
  plan="$(start_state get plan 2>/dev/null)"
  spec="$(start_state get spec 2>/dev/null)"
  case "$spec:$plan" in
    :*|-:*|*:|*:-)
      # AC38: name each active story's checkout (another checkout's pointer).
      _pf_w="$(start_state stories 2>/dev/null | ST_D="$START_DIR" awk -F'\t' '$6 == "active" && $1 != ENVIRON["ST_D"] { printf " — the story is in %s", $1 }')"
      refuse "no spec or plan set (studio-state get spec, get plan)$_pf_w" ;;
    *)
      # Whole line: an approval of docs/plan.md.old does not approve docs/plan.md.
      start_state show 2>/dev/null | sed -n 's/^- [0-9-]* plan approved //p' | grep -qxF -- "$plan" \
        || refuse "plan not approved: no 'plan approved $plan' ledger line"
      if [ -n "$(git -C "$START_DIR" status --porcelain -- "$spec" "$plan" 2>/dev/null)" ]; then
        refuse "uncommitted spec or plan — commit them first"
      fi
      grep -q '^## Decisions' "$START_DIR/$plan" 2>/dev/null \
        || refuse "plan has no ## Decisions section (run /omega:autopilot's question sweep)" ;;
  esac
  if [ -n "$(git -C "$START_DIR" status --porcelain -- .studio/ledger .studio/config.json 2>/dev/null)" ]; then
    refuse "uncommitted ledger change — read the Stop: line, resolve it, commit"
  fi
  fi
  case "${STUDIO_OVERNIGHT_SESSION_SECONDS:-0}" in
    *[!0-9]*) refuse "STUDIO_OVERNIGHT_SESSION_SECONDS must be a whole number of seconds, got ${STUDIO_OVERNIGHT_SESSION_SECONDS}" ;;
  esac
  [ -n "$_pf_mf" ] || case "$_stage" in
    plan|execute) ;;
    *) refuse "stage $_stage: nothing approved to run" ;;
  esac
  if ! { command -v claude-gd >/dev/null 2>&1 && claude-gd --version >/dev/null 2>&1; }; then
    refuse "claude-gd not found or not working"
  fi
  gh auth status >/dev/null 2>&1 || refuse "gh auth status failed — log in first"
  if [ ! -f "$DENY_FILE" ] || ! grep -Evq '^[[:space:]]*(#|$)' "$DENY_FILE"; then
    refuse "$DENY_FILE: no deny rules"
  fi
  DEFAULT_BRANCH="$(git -C "$START_DIR" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)"
  DEFAULT_BRANCH="${DEFAULT_BRANCH#origin/}"
  [ -n "$DEFAULT_BRANCH" ] || refuse "origin/HEAD is not set — run: git remote set-head origin --auto"
  cfg session_usd 25 1 200 dec
  cfg run_usd 0 0 5000 dec
  awk -v v="${RUN_USD:-0}" 'BEGIN { exit !(v > 0 && v < 1) }' \
    && refuse "config overnight.run_usd must be 0 (no run-wide cap) or from 1 to 5000, got $RUN_USD"
  cfg max_lanes 0 0 8 int
  if [ -n "$_pf_mf" ]; then
    # #39 AC27: one cap for every run, from the main checkout's config (D21: the start value is the fallback).
    _pf_ms="$(CONFIG="$STATE_ROOT/.studio/config.json"; cfg_raw max_sessions)"
    case "${_pf_ms:-6}" in
      [1-8]) SESS_START_CAP="${_pf_ms:-6}" ;;
      *) refuse "overnight.max_sessions must be an integer 1-8 in $STATE_ROOT/.studio/config.json" ;;
    esac
  fi
  cfg_str model_task sonnet '^[a-z0-9.-]+$'
  cfg_str model_final opus '^[a-z0-9.-]+$'
  cfg_str model_finish sonnet '^[a-z0-9.-]+$'
  cfg_str model_repair opus '^[a-z0-9.-]+$'
  cfg_str model_progress sonnet '^[a-z0-9.-]+$'
  cfg_str merge_command '' '.*'
  cfg_nobs worktree_setup
  cfg_nobs gate_command
  cfg worktree_setup_minutes 20 1 120 int
  MERGE_BASENAME=""
  if [ -n "${MERGE_COMMAND:-}" ]; then
    _w="${MERGE_COMMAND%% *}"
    case "$MERGE_COMMAND" in *'<pr>'*) ;; *) refuse "config merge_command: must contain <pr>, got $MERGE_COMMAND" ;; esac
    if [ -f "$START_DIR/$_w" ] && [ -x "$START_DIR/$_w" ]; then
      MERGE_BASENAME="$(basename "$_w")"
    else
      refuse "config merge_command: first word $_w is not an executable file under $START_DIR"
    fi
  fi
  cfg session_minutes 90 10 480 int
  [ -z "${SESSION_MINUTES:-}" ] || SESSION_MINUTES="$(printf '%s\n' "$SESSION_MINUTES" | awk '{ print $1 + 0 }')"
  gate_room_check
  cfg retries 1 0 3 int
  cfg gate_repairs 2 0 3 int
  cfg hold_minutes 480 0 1440 int
  cfg directive_chars 4000 500 16000 int
  hold_overrides
  cfg kill_grace_seconds 30 5 120 int
  GRACE="${KILL_GRACE_SECONDS:-30}"
  # #59 R2: the idle watchdog (run_unit). Its seconds seams are whole numbers >= 1.
  cfg idle_minutes 20 0 120 int
  [ -z "${IDLE_MINUTES:-}" ] || IDLE_MINUTES="$(printf '%s\n' "$IDLE_MINUTES" | awk '{ print $1 + 0 }')"   # D3
  for _pf_v in STUDIO_OVERNIGHT_IDLE_SECONDS STUDIO_OVERNIGHT_IDLE_POLL_SECONDS; do
    eval "_pf_x=\${$_pf_v:-1}"
    case "$_pf_x" in ''|*[!0-9]*) refuse "$_pf_v must be a whole number of seconds (1 or more), got $_pf_x" ;;
      *) [ "$_pf_x" -ge 1 ] || refuse "$_pf_v must be a whole number of seconds (1 or more), got $_pf_x" ;; esac
  done
  if lock_live; then
    refuse "a run is live (pid $(lock_pid)) — $(sq "$SELF_ABS") status"
  elif [ -z "$_pf_mf" ] && ! lock_recheck; then
    # AC5: a single-plan run excludes every live run, per-run locks included.
    refuse "$RECHECK_WHY"
  fi
  env_line
  [ -n "$_pf_mf" ] || [ "$FAILED" -eq 0 ] || exit 2
}
# env_line [RUN_PID] — studio-env's readout on stdout: a summary line, and a
# warning block when the machine is short of something. Never fails, never
# blocks. The preflight prints it on stdout too (stderr is the refusals').
env_line() {
  sh "$SELF_DIR/studio-env" --dir "${START_DIR:-.}" ${1:+--run-pid "$1"} || true
}

# session_caps — #59 R1: the command caps of every runner-launched session,
# from SESSION_MINUTES (default 90): CMD_MIN = min(45, S/3) and GATE_MIN =
# min(60, S/2) (integer minutes), CMD_MS = CMD_MIN × 60000 (Bash calls with no
# timeout), MAX_MS = S × 60000 (the ceiling gate-routed calls request).
session_caps() {
  _sc_s="${SESSION_MINUTES:-90}"
  CMD_MIN=$((_sc_s / 3)); [ "$CMD_MIN" -le 45 ] || CMD_MIN=45
  GATE_MIN=$((_sc_s / 2)); [ "$GATE_MIN" -le 60 ] || GATE_MIN=60
  CMD_MS=$((CMD_MIN * 60000)); MAX_MS=$((_sc_s * 60000))
}
# caps_env — the caps as launch env words, each KEY='value' (sq).
caps_env() {
  session_caps
  printf 'BASH_DEFAULT_TIMEOUT_MS=%s BASH_MAX_TIMEOUT_MS=%s STUDIO_GATE_MINUTES=%s' \
    "$(sq "$CMD_MS")" "$(sq "$MAX_MS")" "$(sq "$GATE_MIN")"
}

# gate_room_check — a warning (never a refusal) when the slowest of the last
# 10 studio-test runs plus the slowest of the last 10 gate_command runs
# (studio-gate's .studio/gate.times, who `studio-test` and `gate`) × 1.2 plus
# 10 minutes for the rest of a finish or check unit exceeds session_minutes:
# those units run them in one session, and a gate the cap kills is `timed
# out` (D13).
gate_room_check() {
  _gr_t="$(awk '$2 == "studio-test" { s[++n] = $3 }
    END { m = 0; for (i = (n > 10 ? n - 9 : 1); i <= n; i++) if (s[i] ~ /^[0-9]+$/ && s[i] + 0 > m) m = s[i] + 0; print m }' \
    "$STATE_ROOT/.studio/gate.times" 2>/dev/null)"
  _gr_g="$(awk '$2 == "gate" { s[++n] = $3 }
    END { m = 0; for (i = (n > 10 ? n - 9 : 1); i <= n; i++) if (s[i] ~ /^[0-9]+$/ && s[i] + 0 > m) m = s[i] + 0; print m }' \
    "$STATE_ROOT/.studio/gate.times" 2>/dev/null)"
  # #59 R1: studio-gate stops a run past GATE_MIN (exit 124): warn when the
  # slowest recent studio-test or gate run × 1.2 does not fit it.
  session_caps
  _gr_m=$(( ${_gr_t:-0} > ${_gr_g:-0} ? ${_gr_t:-0} : ${_gr_g:-0} ))
  if [ "$_gr_m" -gt 0 ] && [ $((_gr_m * 12)) -gt $((GATE_MIN * 600)) ]; then
    _gr_cn=$(( (_gr_m * 12 / 10 + 59) / 60 ))
    if [ "$_gr_cn" -le 60 ]; then _gr_fix="set overnight.session_minutes to at least $((_gr_cn * 2)) in .studio/config.json"
    else _gr_fix="the cap tops out at 60 min (session_minutes 120 or more): speed up or split the suite"; fi
    say "warning: gate run cap: the slowest recent studio-test or gate run took $(( (_gr_m + 59) / 60 )) min; × 1.2 is past the gate run cap of $GATE_MIN min (min(60, session_minutes/2)) — $_gr_fix (studio-gate stops a run past the cap, exit 124)"
  fi
  _gr_s=$(( ${_gr_t:-0} + ${_gr_g:-0} ))
  [ "$_gr_s" -gt 0 ] 2>/dev/null || return 0
  _gr_need=$(( (_gr_s * 12 / 10 + 59) / 60 + 10 ))
  [ "$_gr_need" -gt "${SESSION_MINUTES:-90}" ] || return 0
  _gr_what="the slowest of the last 10 studio-test runs"
  if [ "${_gr_g:-0}" -gt 0 ]; then
    if [ "${_gr_t:-0}" -gt 0 ]; then _gr_what="$_gr_what plus the slowest of the last 10 gate_command runs"
    else _gr_what="the slowest of the last 10 gate_command runs"; fi
  fi
  say "warning: $_gr_what took $(( (_gr_s + 59) / 60 )) min, and a finish or check unit runs them inside one session: session_minutes ${SESSION_MINUTES:-90} is too tight — set overnight.session_minutes to at least $_gr_need in .studio/config.json (a unit the cap ends is reported \"timed out\")"
}

# ledger_of DIR — the feature ledger's lines as `studio-state show` prints
# them from DIR (the runner never derives the ledger's file name).
ledger_of() {
  ( cd "$1" && sh "$STATE_BIN" show 2>/dev/null ) | sed -n '/^## Feature ledger: /,$p' | sed 1d
}
# feature_dir [STORY_DIR] — the story's feature checkout: `worktree` where its
# pointer is (story_dir, or the given dir), else that dir itself.
feature_dir() {
  _fd_s="${1:-$(story_dir)}"
  _w="$(cd "$_fd_s" && sh "$STATE_BIN" worktree 2>/dev/null)"
  if [ -n "$_w" ] && [ -d "$_w" ]; then printf '%s\n' "$_w"; else printf '%s\n' "$_fd_s"; fi
}
# snapshot STOPS_FILE — the progress signature, and the Stop: lines of the
# feature and start checkouts, sorted: each line suffixed with a tab and its
# occurrence number in its own ledger, then de-duplicated across the two (the
# feature ledger starts as a copy of the start's). A stop written again with
# the same text on the same day is a new `<line>\t2`, so a comm -13 of two
# snapshots finds it; a reader strips the suffix (new_stop). The start side is
# the story's checkout (story_dir, resolved once here; #42 R2), never a new
# story started in START_DIR after the hand-off.
snapshot() {
  story_resolve || true; _sn_d="$STORY_DIR"
  FEATURE_DIR="$(feature_dir "$_sn_d")"
  _l="$(ledger_of "$FEATURE_DIR")"
  # That read can adopt a pre-#42 story into its worktree (AC18), idling the
  # pointer resolved above: resolve again before reading stage and task.
  story_resolve || true; _sn_d="$STORY_DIR"
  SIG_STAGE="$(cd "$_sn_d" && sh "$STATE_BIN" get stage)"; SIG_TASK="$(cd "$_sn_d" && sh "$STATE_BIN" get task)"
  SIG_FRD="$(printf '%s\n' "$_l" | grep -c '^- [0-9-]* final review done$')"
  SIG_SHIPPED="$(printf '%s\n' "$_l" | grep -c '^- [0-9-]* shipped ')"
  # check lines count in D2's truth region: after the last `adopt reset` line.
  _lt="$(printf '%s\n' "$_l" | awk '/^- [0-9-]+ adopt reset /{ n = NR } { l[NR] = $0 } END { for (i = n + 1; i <= NR; i++) print l[i] }')"
  SIG_CHK="$(printf '%s\n' "$_lt" | grep -c '^- [0-9-]* check done')"
  SIG_CHKREQ="$(printf '%s\n' "$_lt" | grep -c '^- [0-9-]* check requested$')"
  SIG="stage=$SIG_STAGE;task=$SIG_TASK;frd=$SIG_FRD;shipped=$SIG_SHIPPED;chk=$SIG_CHK"
  # $1.start: the start checkout's Stop: lines (the whole set before
  # isolation, when one ledger is both), so take_new_stop can tell a Stop
  # written before isolation, or in both ledgers, from a feature-only one.
  # Once the story was handed to its worktree (story_dir is not START_DIR),
  # the start checkout holds no part of it: the start side is empty, so a
  # Stop: there is feature-side (AC17-18 holds), and START_DIR's own pointer,
  # idle or a new story, is never read (R2).
  if [ "$FEATURE_DIR" = "$_sn_d" ]; then   # one ledger: read it once
    printf '%s\n' "$_l" | stop_lines | sort -u > "$1"
    if [ "$_sn_d" = "$START_DIR" ]; then cp "$1" "$1.start"; else : > "$1.start"; fi
  else
    ledger_of "$_sn_d" | stop_lines | sort -u > "$1.start"
    { printf '%s\n' "$_l" | stop_lines; cat "$1.start"; } | sort -u > "$1"
  fi
}
# stop_lines — the Stop: lines of one ledger on stdin, each suffixed with a
# tab and its occurrence number (snapshot's rule).
stop_lines() { grep '^- [0-9-]* Stop: ' | awk '{ k[$0]++; printf "%s\t%d\n", $0, k[$0] }'; }
# new_stop BEFORE AFTER — the Stop: line in snapshot AFTER that BEFORE does
# not hold (the last, when several), its suffix stripped; empty for none.
new_stop() { _ns="$(comm -13 "$1" "$2" | tail -n 1)"; printf '%s\n' "${_ns%	*}"; }
# take_new_stop BEFORE AFTER — new_stop's line (NEW_STOP; empty for none),
# its ending (STOP_ENDING, `stop: <reason>`), and where it came from
# (STOP_SRC): `start` when any line new in AFTER is also in the start
# checkout's ledger (AFTER.start), else `feature` (AC17-18, R6).
take_new_stop() {
  NEW_STOP="$(new_stop "$1" "$2")"; STOP_ENDING=""; STOP_SRC=""
  [ -n "$NEW_STOP" ] || return 0
  STOP_ENDING="stop: ${NEW_STOP#*Stop: }"
  if comm -13 "$1" "$2" | awk -v st="$2.start" 'FILENAME == st { s[$0] = 1; next } ($0 in s) { f = 1 } END { exit !f }' "$2.start" -; then
    STOP_SRC=start
  else
    STOP_SRC=feature
  fi
}
# run_budget_out — the run budget refuses one more session: run_usd is set
# and spent_all + session_usd exceeds it.
run_budget_out() {
  awk -v r="$RUN_USD" 'BEGIN { exit !(r > 0) }' \
    && awk -v s="$(spent_all)" -v u="$SESSION_USD" -v r="$RUN_USD" 'BEGIN { exit !(s + u > r) }'
}
# label_for — the unit's name from the SIG_* values (D8); names files only.
label_for() {
  if [ "${SIG_CHKREQ:-0}" -gt 0 ] && [ "${SIG_CHK:-0}" -eq 0 ]; then echo check; return; fi
  case "$SIG_STAGE:$SIG_TASK" in
    plan:*|*:-|*:|*:0/*) echo T1; return ;;
  esac
  _k="${SIG_TASK%/*}"; _n="${SIG_TASK#*/}"
  if [ "$_k" -lt "$_n" ]; then echo "T$((_k + 1))"
  elif [ "$SIG_FRD" -eq 0 ]; then echo final-review
  else echo finish; fi
}
# cost_of FILE — total_cost_usd of the last result event; empty when none.
cost_of() {
  grep '"type"[[:space:]]*:[[:space:]]*"result"' "$1" 2>/dev/null | tail -n 1 \
    | sed -n 's/.*"total_cost_usd"[[:space:]]*:[[:space:]]*\([0-9.eE+-]*\).*/\1/p'
}
spent_all() { spent; }
stop_requested() { [ -f "$STOP_FILE" ] || [ "$STOP_REQ" = 1 ]; }
spent() { awk -F'\t' '$4 != "unknown" { s += $4 } END { printf "%.2f\n", s + 0 }' "$RUN_DIR/units.tsv" 2>/dev/null || echo 0.00; }

# ---- The event log (spec AC28-29; docs/game-dev/overnight-events.md) ----
# run_event EVENT FIELD… — one line in RUN_DIR/events.jsonl (studio-event);
# a failure is a stderr note, never fatal.
run_event() { sh "$SELF_DIR/studio-event" "$RUN_DIR" "$@" || say "events.jsonl: $1 not written"; }
# state_event ID RECORD — a story_state event for record line RECORD (R17):
# state is its first word (a trailing ':' dropped); why for held, stopped
# and skipped; until for held. Nothing until EV_ON=1.
state_event() {
  [ "${EV_ON:-0}" = 1 ] || return 0
  _se_r="$2"; _se_s="${_se_r%% *}"; _se_s="${_se_s%:}"; _se_w=""; _se_u=""
  case "$_se_r" in
    "held "*) _se_w="${_se_r#held }"; _se_u="${_se_w##* until }"; _se_w="${_se_w% until *}" ;;
    stopped:*|skipped:*) _se_w="${_se_r#*: }" ;;
    "stopped "*|"skipped "*) _se_w="${_se_r#* }" ;;
  esac
  if [ "$_se_s" = held ]; then run_event story_state "story=$1" state=held "why=$_se_w" "until=$_se_u"
  elif [ -n "$_se_w" ]; then run_event story_state "story=$1" "state=$_se_s" "why=$_se_w"
  else run_event story_state "story=$1" "state=$_se_s"; fi
}
# iso_utc EPOCH — EPOCH as YYYY-MM-DDTHH:MM:SSZ (GNU date -d, else BSD -r).
iso_utc() { date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ; }
# ---- Operator messages and holds (#27; spec AC13-14, AC17-27) ----
# requeue_check — after each unit: each story or retire message the unit
# claimed (inbox/<story>/delivered/<UNIT_TAG>/) is checked against the
# story's feature-checkout ledger (`Directive <id>:` or `Directive <target>
# retired` at a line's start, after its date). One with no match goes back to
# pending with requeues + 1 and a message_requeued event. REQ_LIMIT is the
# first id whose requeues reach RETRIES + 1, when holds are on and the story
# is isolated (R6, R9). Writes no studio state. A manifest run's storyless
# unit (the final step) has no inbox.
requeue_check() {
  REQ_LIMIT=""
  if [ -z "${CUR_ID:-}" ] && [ -f "$RUN_DIR/rows.tsv" ]; then return 0; fi
  _rq_s="${CUR_ID:--}"; _rq_ib="$RUN_DIR/inbox/$_rq_s"; _rq_dl="$_rq_ib/delivered/$UNIT_TAG"
  [ -d "$_rq_dl" ] || return 0
  _rq_fd="$(feature_dir)"; _rq_l="$(ledger_of "$_rq_fd")"
  inbox_lock "$_rq_ib" 5 || { say "inbox busy: the directive check after $UNIT_STEM was skipped"; return 0; }
  for _rq_f in "$_rq_dl"/[0-9]*.msg; do
    [ -f "$_rq_f" ] || continue
    _rq_id="$(msg_get id "$_rq_f")"
    case "$(msg_get scope "$_rq_f")" in
      story) _rq_p="Directive $_rq_id:" ;;
      retire) _rq_p="Directive $(msg_get target "$_rq_f") retired" ;;
      *) continue ;;
    esac
    if printf '%s\n' "$_rq_l" | awk -v p="$_rq_p" '{ sub(/^- [0-9-]+ /, "") } index($0, p) == 1 { f = 1 } END { exit !f }'; then
      continue
    fi
    _rq_n="$(msg_get requeues "$_rq_f")"
    case "$_rq_n" in ''|*[!0-9]*) _rq_n=0 ;; esac      # a corrupt header counts as 0
    _rq_n="${_rq_n#"${_rq_n%%[!0]*}"}"                 # no leading zeros (08 is not octal-safe)
    _rq_n=$(( ${_rq_n:-0} + 1 ))
    _rq_t="$_rq_ib/.rq.$$"
    if sed "1,/^--\$/s/^requeues: .*/requeues: $_rq_n/" "$_rq_f" > "$_rq_t" && mv -f "$_rq_t" "$_rq_ib/${_rq_f##*/}"; then
      rm -f "$_rq_f"
    else
      rm -f "$_rq_t"; continue
    fi
    run_event message_requeued "story=$_rq_s" "id:=$_rq_id" "unit=$UNIT_TAG" "requeues:=$_rq_n"
    if [ -z "$REQ_LIMIT" ] && [ "$_rq_n" -ge $((RETRIES + 1)) ] && [ "$HOLD_ON" = 1 ] && [ "$_rq_fd" != "$START_DIR" ]; then
      REQ_LIMIT="$_rq_id"
    fi
  done
  inbox_unlock "$_rq_ib"
}
# ctl_take ID KIND — control/ID.KIND exists: remove it, return 0.
ctl_take() { [ -f "$RUN_DIR/control/$1.$2" ] || return 1; rm -f "$RUN_DIR/control/$1.$2"; }
# ctl_clear ID — R25: a story that ends leaves no control file.
ctl_clear() {
  rm -f "$RUN_DIR/control/$1.hold" "$RUN_DIR/control/$1.resume" "$RUN_DIR/control/$1.stop" "$RUN_DIR/control/$1.held"
}
# op_boundary ID — R8, before a unit: the halt (`stopped by user`), then an
# operator stop (`stopped by operator`), then, with holds on, an operator
# hold (`held by operator`). Returns 1 with ENDING set when one acts.
op_boundary() {
  if stop_requested; then ENDING="stopped by user"; return 1; fi
  if ctl_take "$1" stop; then ENDING="stopped by operator"; return 1; fi
  if [ "$HOLD_ON" = 1 ] && ctl_take "$1" hold; then ENDING="held by operator"; return 1; fi
  return 0
}
# isolated — the last snapshot's feature checkout is not the start checkout.
isolated() { [ "${FEATURE_DIR:-$START_DIR}" != "$START_DIR" ]; }
# holdable — AC17-18, R6: ENDING holds instead of ending. Never under a halt,
# never with holds off; `held by operator` always; a `stop:` only when it is
# the feature-only Stop take_new_stop saw; the rest only after isolation.
holdable() {
  [ "$HOLD_ON" = 1 ] || return 1
  ! stop_requested || return 1
  case "$ENDING" in
    "held by operator") return 0 ;;
    "stop: "*) [ "$ENDING" = "${STOP_ENDING:-}" ] && [ "${STOP_SRC:-}" = feature ] && isolated; return $? ;;
    "no progress on "*|"timed out on "*|"directive "*" not recorded"|"gate red after "*|"gate repair made no progress"|"gate repair timed out"*|"stalled on "*|"gate repair stalled"*)
      isolated; return $? ;;
  esac
  return 1
}
# hold_record ID RECORD — the story's record while it holds and resumes.
# Single-plan mode keeps a held line in control/ID.held (removed for any
# other record) and writes the story_state event; overnight-lanes.sh
# redefines it as story_write.
hold_record() {
  mkdir -p "$RUN_DIR/control" 2>/dev/null
  case "$2" in
    held*) printf '%s\n' "$2" > "$RUN_DIR/control/.held.$$" && mv -f "$RUN_DIR/control/.held.$$" "$RUN_DIR/control/$1.held" ;;
    *) rm -f "$RUN_DIR/control/$1.held" ;;
  esac
  state_event "$1" "$2"
}
# halt_reason — the ending a halt gives a held story (R28); lanes redefine
# it as lane_halt_reason.
halt_reason() { echo "stopped by user"; }
# hm SECS — `<h>h<m>m`.
hm() { printf '%dh%dm' $(( $1 / 3600 )) $(( $1 % 3600 / 60 )); }
# hold_wait ID — AC19-25: hold the story ENDING names until the operator
# acts, the run halts, or HOLD_SECS pass; a poll every
# STUDIO_OVERNIGHT_POLL_SECONDS (default 5), no session running. A poll checks
# the halt, then .stop, then .resume, then the deadline (AC22). Returns 0 on
# resume (record running, ENDING cleared; n is kept, so units run on);
# else 1 with ENDING set (an operator stop of an operator hold is `stopped by
# operator`).
hold_wait() {
  _hw_why="$ENDING"
  # A halt or an operator stop already pending ends the story at once: no held
  # record, no held event, for a hold that never waited (R5).
  if stop_requested; then ENDING="$(halt_reason)"; return 1; fi
  if ctl_take "$1" stop; then ENDING="stopped by operator"; return 1; fi
  rm -f "$RUN_DIR/control/$1.hold" "$RUN_DIR/control/$1.resume"
  _hw_dl=$(( $(date +%s) + HOLD_SECS ))
  hold_record "$1" "held $_hw_why until $(iso_utc "$_hw_dl")"
  say "${CUR_ID:+$CUR_ID }held: $_hw_why — say / resume / stop ${CUR_ID:--}"
  while :; do
    if stop_requested; then ENDING="$(halt_reason) (was held: $_hw_why)"; return 1; fi
    if ctl_take "$1" stop; then
      case "$_hw_why" in "held by operator") ENDING="stopped by operator" ;; *) ENDING="$_hw_why" ;; esac
      return 1
    fi
    if ctl_take "$1" resume; then hold_record "$1" running; ENDING=""; return 0; fi
    if [ "$(date +%s)" -ge "$_hw_dl" ]; then ENDING="$_hw_why (held $(hm "$HOLD_SECS"), no reply)"; return 1; fi
    sleep "${STUDIO_OVERNIGHT_POLL_SECONDS:-5}"
  done
}
# hhmm_local ISO — ISO-8601 UTC as local HH:MM: days-from-civil to an epoch,
# then GNU `date -d @E`, else BSD `date -r E`; the ISO itself when neither
# works (R20, trial t6).
hhmm_local() {
  _hh_e="$(printf '%s\n' "$1" | awk -F'[-T:Z]' 'NF >= 6 { y = $1; m = $2; d = $3; if (m <= 2) { y--; m += 12 }
    era = int(y / 400); yoe = y - era * 400; doy = int((153 * (m - 3) + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    print (era * 146097 + doe - 719468) * 86400 + $4 * 3600 + $5 * 60 + $6 }')"
  if [ -n "$_hh_e" ]; then
    date -d "@$_hh_e" +%H:%M 2>/dev/null || date -r "$_hh_e" +%H:%M 2>/dev/null || printf '%s\n' "$1"
  else
    printf '%s\n' "$1"
  fi
}
# held_line RECORD ID — AC27, R20.
held_line() {
  _hl_r="${1#held }"
  printf 'held — %s — until %s — say / resume / stop %s\n' "${_hl_r% until *}" "$(hhmm_local "${_hl_r##* until }")" "$2"
}
# msgs_left ID — R21: the story's pending messages, lowest id first, as
# `- <id> (<scope>, requeues <n>): <text>`.
msgs_left() {
  for _ml_f in "$RUN_DIR/inbox/$1"/[0-9]*.msg; do
    [ -f "$_ml_f" ] || continue
    printf '%s\t- %s (%s, requeues %s): %s\n' "$(msg_get id "$_ml_f")" "$(msg_get id "$_ml_f")" \
      "$(msg_get scope "$_ml_f")" "$(msg_get requeues "$_ml_f")" "$(msg_body "$_ml_f")"
  done | sort -n | awk '{ sub(/^[0-9]+\t/, ""); print }'
}

# ---- What a unit is doing: activity, elapsed time, heartbeat ----

# unit_activity JSONL — the unit's last activity, one line, from its
# stream-json: the subagent still running (its type without the plugin
# prefix, and its description, quoted), then the last tool call (`Bash:
# <command>`, a file tool's file name, Grep's pattern, else the tool's name),
# joined by ` · `; `starting` before the first tool call.
unit_activity() {
  [ -s "$1" ] || { echo starting; return 0; }
  awk '
    # val(s, k) — the JSON string value of key k in s, escapes undone enough to read.
    function val(s, k,   re, v) {
      re = "\"" k "\":\"([^\"\\\\]|\\\\.)*\""
      if (!match(s, re)) return ""
      v = substr(s, RSTART + length(k) + 4, RLENGTH - length(k) - 5)
      gsub(/\\n/, " ", v); gsub(/\\t/, " ", v); gsub(/\\"/, "\"", v); gsub(/\\\\/, "\\", v)
      return v
    }
    function cut(s, n) { return length(s) > n ? substr(s, 1, n - 1) "…" : s }
    {
      l = $0
      while (match(l, /"tool_use_id":"[^"]*"/)) { closed[substr(l, RSTART + 15, RLENGTH - 16)] = 1; l = substr(l, RSTART + RLENGTH) }
      l = $0
      while (match(l, /"type":"tool_use","id":"[^"]*","name":"[^"]*"/)) {
        head = substr(l, RSTART, RLENGTH); l = substr(l, RSTART + RLENGTH)
        id = head; sub(/^"type":"tool_use","id":"/, "", id); sub(/".*/, "", id)
        nm = head; sub(/.*"name":"/, "", nm); sub(/"$/, "", nm)
        # This call input: up to the next tool_use, if any.
        inp = l; if (match(inp, /"type":"tool_use"/)) inp = substr(inp, 1, RSTART - 1)
        if (nm == "Agent" || nm == "Task") {
          t = val(inp, "subagent_type"); sub(/^.*:/, "", t); if (t == "") t = "agent"
          na++; aid[na] = id; adesc[na] = t " · \"" cut(val(inp, "description"), 60) "\""
          last = ""; lastid = id; continue
        }
        if (nm == "Bash") d = val(inp, "command")
        else if (nm ~ /^(Read|Edit|Write|NotebookEdit)$/) { d = val(inp, "file_path"); sub(/.*\//, "", d) }
        else if (nm ~ /^(Grep|Glob)$/) d = val(inp, "pattern")
        else d = ""
        last = (d == "") ? nm : nm ": " cut(d, 70); lastid = id
      }
    }
    END {
      open = ""; for (i = na; i >= 1; i--) if (!(aid[i] in closed)) { open = adesc[i]; break }
      if (open != "" && last != "") print open " · " last
      else if (open != "") print open
      else if (last != "") print last
      else print "starting"
    }' "$1" 2>/dev/null || echo starting
}
# open_calls JSONL [gate] — #59 R2: the session's open (unanswered) tool_use
# calls, newest first, one per line, rendered as unit_activity renders a tool
# (Agent/Task: `<type> · "<description>"`; Bash: `Bash: <command>`; a file
# tool: its file name; Grep/Glob: the pattern; else the tool name), newlines
# and tabs flattened, cut to 120 chars. `gate`: prints `gate` when an open
# Bash call's FULL command runs a gate-routed verb (never the cut text).
# Always exits 0.
open_calls() {
  [ -s "$1" ] || return 0
  awk -v mode="${2:-list}" '
    function val(s, k,   re, v) {
      re = "\"" k "\":\"([^\"\\\\]|\\\\.)*\""
      if (!match(s, re)) return ""
      v = substr(s, RSTART + length(k) + 4, RLENGTH - length(k) - 5)
      gsub(/\\n/, " ", v); gsub(/\\t/, " ", v); gsub(/\\"/, "\"", v); gsub(/\\\\/, "\\", v)
      return v
    }
    function cut(s, n) { return length(s) > n ? substr(s, 1, n - 1) "…" : s }
    {
      l = $0
      while (match(l, /"tool_use_id":"[^"]*"/)) { closed[substr(l, RSTART + 15, RLENGTH - 16)] = 1; l = substr(l, RSTART + RLENGTH) }
      l = $0
      while (match(l, /"type":"tool_use","id":"[^"]*","name":"[^"]*"/)) {
        head = substr(l, RSTART, RLENGTH); l = substr(l, RSTART + RLENGTH)
        id = head; sub(/^"type":"tool_use","id":"/, "", id); sub(/".*/, "", id)
        nm = head; sub(/.*"name":"/, "", nm); sub(/"$/, "", nm)
        inp = l; if (match(inp, /"type":"tool_use"/)) inp = substr(inp, 1, RSTART - 1)
        full = ""
        if (nm == "Agent" || nm == "Task") {
          t = val(inp, "subagent_type"); sub(/^.*:/, "", t); if (t == "") t = "agent"
          txt = t " · \"" val(inp, "description") "\""
        } else {
          if (nm == "Bash") { d = val(inp, "command"); full = d }
          else if (nm ~ /^(Read|Edit|Write|NotebookEdit)$/) { d = val(inp, "file_path"); sub(/.*\//, "", d) }
          else if (nm ~ /^(Grep|Glob)$/) d = val(inp, "pattern")
          else d = ""
          txt = (d == "") ? nm : nm ": " d
        }
        n++; cid[n] = id; ctxt[n] = txt; cfull[n] = full
      }
    }
    END {
      for (i = n; i >= 1; i--) {
        if (cid[i] in closed) continue
        if (mode == "gate") { if (cfull[i] ~ /studio-(test|run|setup|gate)/) { print "gate"; exit } ; continue }
        s = ctxt[i]; gsub(/[\t\r\n]/, " ", s); print cut(s, 120)
      }
    }' "$1" 2>/dev/null
  return 0
}
# elapsed_since EPOCH — minutes (or seconds under one) since EPOCH: `12m`, `40s`.
elapsed_since() {
  _es_s=$(( $(date +%s) - ${1:-0} ))
  if [ "$_es_s" -lt 60 ]; then printf '%ss\n' "$_es_s"; else printf '%sm\n' "$((_es_s / 60))"; fi
}
# unit_now_line DIR — `<unit> · <elapsed> · <activity>` for the unit running
# in DIR (its unit.now: `<epoch> <stem>`); nothing when none runs.
unit_now_line() {
  [ -f "$1/unit.now" ] || return 0
  _un_t=""; _un_s=""; read -r _un_t _un_s < "$1/unit.now" 2>/dev/null || true
  [ -n "$_un_s" ] || return 0
  printf '%s · %s · %s\n' "$_un_s" "$(elapsed_since "$_un_t")" "$(unit_activity "$1/$_un_s.jsonl")"
}
# gate_line [RUN_DIR] — the gate lock: `gate: free`, or `gate: <who> (pid
# <p>) for <elapsed>[, unit <tag>]` (the tag shortened to `<lane>-<unit>` when
# it is RUN_DIR's).
gate_line() {
  _gl="$STATE_ROOT/.studio/gate.lock"; _gl_p="$(cat "$_gl/pid" 2>/dev/null)"
  if [ -z "$_gl_p" ] || ! kill -0 "$_gl_p" 2>/dev/null; then echo "gate: free"; return 0; fi
  _gl_u="$(cat "$_gl/unit" 2>/dev/null)"; _gl_t="$(cat "$_gl/since" 2>/dev/null)"
  [ -z "${1:-}" ] || _gl_u="${_gl_u#"$(basename "$1")"-}"
  printf 'gate: %s (pid %s)%s%s\n' "$(cat "$_gl/who" 2>/dev/null)" "$_gl_p" \
    "${_gl_t:+ for $(elapsed_since "$_gl_t")}" "${_gl_u:+, unit $_gl_u}"
}
# heartbeat_start — while the unit's session (CPID) runs: every
# STUDIO_OVERNIGHT_HEARTBEAT_SECONDS (default 60) one line on the runner's
# stderr (unit_now_line), so a quiet terminal never looks frozen. It polls
# every few seconds and ends on its own once the session is gone; HBPID
# (under a lane also LDIR/hbpid, for lanes_end_sessions when the lane dies).
heartbeat_start() {
  _hb_every="${STUDIO_OVERNIGHT_HEARTBEAT_SECONDS:-60}"
  _hb_tick=5; [ "$_hb_every" -ge 5 ] 2>/dev/null || _hb_tick=1
  ( _sp=; trap 'kill $_sp 2>/dev/null; exit 0' TERM
    _hb_n=0
    while :; do
      sleep "$_hb_tick" & _sp=$!; wait "$_sp"
      kill -0 "$CPID" 2>/dev/null || exit 0
      _hb_n=$((_hb_n + _hb_tick))
      [ "$_hb_n" -ge "$_hb_every" ] || continue
      _hb_n=0
      say "${CUR_ID:+$CUR_ID }$(unit_now_line "$UNIT_DIR")"
    done ) &
  HBPID=$!
  [ -z "${LDIR:-}" ] || printf '%s\n' "$HBPID" > "$LDIR/hbpid"
}
heartbeat_stop() {
  [ -z "${HBPID:-}" ] || { kill "$HBPID" 2>/dev/null; wait "$HBPID" 2>/dev/null; }
  HBPID=""
  [ -z "${LDIR:-}" ] || rm -f "$LDIR/hbpid"
}

# ---- Gates a unit left behind ----

# unit_reap TAG — end every studio-gate still registered under the unit tag
# TAG (STATE_ROOT/.studio/gate.units/TAG/<gate pid>, holding its command's
# pid once it runs): a session that started a gate in the background and
# ended leaves it orphaned, holding or waiting for the gate lock. TERM each
# gate (it forwards the TERM to its command's process group and releases the
# lock), then after up to max(GRACE, 20) s KILL any gate still alive and its
# command's group. Sets UNIT_REAPED to the gate pids ended (empty: none).
unit_reap() {
  UNIT_REAPED=""
  [ -n "${1:-}" ] || return 0
  _ur_d="$STATE_ROOT/.studio/gate.units/$1"
  for _ur_f in "$_ur_d"/*; do
    [ -f "$_ur_f" ] || continue
    _ur_p="${_ur_f##*/}"
    case "$_ur_p" in ''|*[!0-9]*) continue ;; esac
    kill -0 "$_ur_p" 2>/dev/null && ps -o args= -p "$_ur_p" 2>/dev/null | grep -q studio-gate \
      && UNIT_REAPED="$UNIT_REAPED $_ur_p"
  done
  if [ -n "$UNIT_REAPED" ]; then
    _ur_kids=""
    for _ur_p in $UNIT_REAPED; do _ur_kids="$_ur_kids $(cat "$_ur_d/$_ur_p" 2>/dev/null)"; done
    kill -TERM $UNIT_REAPED 2>/dev/null
    _ur_g=0; _ur_max="${GRACE:-30}"; [ "$_ur_max" -ge 20 ] || _ur_max=20
    while [ "$_ur_g" -lt "$_ur_max" ]; do
      _ur_a=0
      for _ur_p in $UNIT_REAPED; do kill -0 "$_ur_p" 2>/dev/null && _ur_a=1; done
      [ "$_ur_a" = 1 ] || break
      sleep 1; _ur_g=$((_ur_g + 1))
    done
    for _ur_p in $UNIT_REAPED; do
      kill -0 "$_ur_p" 2>/dev/null || continue
      kill -KILL "$_ur_p" 2>/dev/null
      for _ur_k in $_ur_kids; do kill -KILL -"$_ur_k" 2>/dev/null; done
    done
    UNIT_REAPED="${UNIT_REAPED# }"
    say "unit ${1#"$(basename "${RUN_DIR:-.}")"-} left a gate running after it ended (pid $UNIT_REAPED) — ended it"
  fi
  rm -rf "$_ur_d"
  rmdir "$STATE_ROOT/.studio/gate.units" 2>/dev/null
  return 0
}

# ---- The user-level run registry: status from any directory ----
# REGISTRY holds one file per live run (<run dir name>-<pid>: root=,
# start=, run=, pid=, started= lines; then origin= when given and, for a
# single-plan run, spec=, #42), written when the run takes its lock
# and moved to REGISTRY/last (with ended=) when it unlocks. Paths are
# STATE_ROOT as studio-state prints it, so a project reached through a
# symlink (GameDev -> GameDev.nosync) is one project.
REGISTRY="$HOME/.claude-gamedev/runs"
reg_get() { sed -n "s/^$1=//p" "$2" 2>/dev/null | head -n 1; }
# origin_ok VALUE — AC1a's rule for the registry's origin= value: 1-200 bytes
# of A-Z a-z 0-9 . _ : - and no newline. The core never interprets it.
origin_ok() {
  case "$1" in *'
'*) return 1 ;; esac
  printf '%s\n' "$1" | LC_ALL=C grep -Eq '^[A-Za-z0-9._:-]{1,200}$'
}
# origin_take — STUDIO_RUN_ORIGIN, read once, into RUN_ORIGIN (cleared with
# one warning when it fails origin_ok), then dropped from the environment so
# no unit session inherits it.
origin_take() {
  RUN_ORIGIN="${STUDIO_RUN_ORIGIN:-}"
  unset STUDIO_RUN_ORIGIN 2>/dev/null || true
  if [ -n "$RUN_ORIGIN" ] && ! origin_ok "$RUN_ORIGIN"; then
    say "STUDIO_RUN_ORIGIN ignored — use 1-200 characters from A-Z a-z 0-9 . _ : -"
    RUN_ORIGIN=""
  fi
}
# reg_live FILE — the entry's runner is alive and is a studio-overnight.
reg_live() {
  _rl_p="$(reg_get pid "$1")"
  [ -n "$_rl_p" ] && kill -0 "$_rl_p" 2>/dev/null && ps -o args= -p "$_rl_p" 2>/dev/null | grep -q studio-overnight
}
# reg_write — this run's entry (RUN_DIR, this pid); another entry for the
# same project is dropped only when its runner is dead (a SIGKILLed run's),
# so a live sibling run keeps its entry (AC6, D11). Never fails the run.
reg_write() {
  mkdir -p "$REGISTRY" 2>/dev/null || return 0
  for _rw in "$REGISTRY"/overnight-*; do
    [ -f "$_rw" ] && [ "$(reg_get root "$_rw")" = "$STATE_ROOT" ] && ! reg_live "$_rw" && rm -f "$_rw"
  done
  REG_ENTRY="$REGISTRY/$(basename "$RUN_DIR")-$$"
  { printf 'root=%s\nstart=%s\nrun=%s\npid=%s\nstarted=%s\n' "$STATE_ROOT" "$START_DIR" "$RUN_DIR" "$$" \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    [ -z "${RUN_ORIGIN:-}" ] || printf 'origin=%s\n' "$RUN_ORIGIN"
    [ -z "${RUN_SPEC:-}" ] || printf 'spec=%s\n' "$RUN_SPEC"; } > "$REG_ENTRY" 2>/dev/null || REG_ENTRY=""
}
# reg_end — this run's entry becomes REGISTRY/last (the newest ended run).
reg_end() {
  [ -n "${REG_ENTRY:-}" ] && [ -f "$REG_ENTRY" ] || return 0
  [ "$(reg_get pid "$REG_ENTRY")" = "$$" ] || return 0
  printf 'ended=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$REG_ENTRY" 2>/dev/null
  mv -f "$REG_ENTRY" "$REGISTRY/last" 2>/dev/null || rm -f "$REG_ENTRY"
  REG_ENTRY=""
}

# start_session ARGS — the session in the background, its pid in CPID. Its
# env words are LAUNCH_ENV (manifest mode: the story's, story_launch_env),
# else the caps then OMEGA_AUTOPILOT=1; STUDIO_GATE_HELD never reaches a session (D17).
# Under a lane (LDIR set) the pid is also written to LDIR/cpid. The session
# starts in UNIT_CWD when set (manifest mode's final-step units), else where
# the story's pointer is (story_dir: START_DIR until a hand-off, #42).
# STUDIO_UNIT_TAG (UNIT_TAG) marks every studio-gate the session starts, so
# unit_reap can end the ones it leaves behind. STUDIO_START_DIR is
# the run's start dir, for every unit (AC30, D42).
start_session() {
  set -m 2>/dev/null || true   # own process group: a terminal Ctrl-C reaches only the runner (D6; a lane subshell too, D1c)
  ( cd "${UNIT_CWD:-$(story_dir)}" && unset STUDIO_GATE_HELD && eval "export ${LAUNCH_ENV:-$(caps_env) OMEGA_AUTOPILOT=1}" \
      && STUDIO_UNIT_TAG="$UNIT_TAG" && export STUDIO_UNIT_TAG \
      && STUDIO_RUN_DIR="$RUN_DIR" && export STUDIO_RUN_DIR \
      && STUDIO_START_DIR="$START_DIR" && export STUDIO_START_DIR && exec claude-gd -p "$@" ) \
    > "$UNIT_DIR/$UNIT_STEM.jsonl" 2> "$UNIT_DIR/$UNIT_STEM.err" < /dev/null &
  CPID=$!
  set +m 2>/dev/null || true
  [ -z "${LDIR:-}" ] || printf '%s\n' "$CPID" > "$LDIR/cpid"
}
# Session slots (#39 AC27) are a manifest run's (D19): a single-plan run
# excludes every other run, so here they are no-ops. overnight-lanes.sh
# redefines them. session_acquire LABEL returns 1 on a halt during the wait.
session_acquire() { :; }
session_started() { :; }
session_release() { :; }
# unit_pre LABEL — the hook story_units runs before a unit (#39 D34): a
# no-op here; overnight-lanes.sh redefines it as the sync check. 1 ends the
# story with ENDING set.
unit_pre() { return 0; }
# run_unit N LABEL — one session, waited for; sets UNIT_* (D7's wait loop).
# It first takes a session slot (session_acquire, D23): a halt while it waits
# sets UNIT_HALTED=1 and returns at once, with no row, event or session; the
# caller ends on the halt (D22). The slot goes once the session is reaped.
# CUR_ID (empty in single-plan mode) names the story: stem N-ID-LABEL, and
# $UNIT_DIR/current reads "ID LABEL". The model comes from the bare LABEL.
# While it runs, $UNIT_DIR/unit.now reads "<start epoch> <stem>" (status and
# the heartbeat). Once the session is gone, the gates it left are ended
# (unit_reap; UNIT_REAPED).
run_unit() {
  UNIT_STEM="$UNIT_PREFIX$1-${CUR_ID:+$CUR_ID-}$2"; printf '%s\n' "${CUR_ID:+$CUR_ID }$2" > "$UNIT_DIR/current"
  UNIT_TAG="$(printf '%s' "$(basename "$RUN_DIR")-${LANE_K:-0}-$UNIT_STEM" | tr -c 'A-Za-z0-9._-' '_')"
  [ -z "${LDIR:-}" ] || printf '%s\n' "$UNIT_TAG" > "$LDIR/utag"
  model_for "$2"
  UNIT_HALTED=0; session_acquire "$2" || { UNIT_HALTED=1; [ -z "${LDIR:-}" ] || rm -f "$LDIR/utag"; return 0; }
  run_event unit_started "story=${CUR_ID:--}" "unit=$UNIT_TAG" "label=$2" "model=$UNIT_MODEL"
  _t0="$(date +%s)"
  printf '%s %s\n' "$_t0" "$UNIT_STEM" > "$UNIT_DIR/unit.now"
  say "${CUR_ID:+$CUR_ID }$2 · started${LANE_K:+ (lane $LANE_K)}"
  with_launch_args start_session
  session_started "$CPID"
  heartbeat_start
  _secs="${STUDIO_OVERNIGHT_SESSION_SECONDS:-$((SESSION_MINUTES * 60))}"
  _idle=""; [ "${IDLE_MINUTES:-0}" -eq 0 ] || _idle="${STUDIO_OVERNIGHT_IDLE_SECONDS:-$((IDLE_MINUTES * 60))}"
  _poll="${STUDIO_OVERNIGHT_IDLE_POLL_SECONDS:-30}"
  _log="$UNIT_DIR/$UNIT_STEM.jsonl"; _greg="$STATE_ROOT/.studio/gate.units/$UNIT_TAG"
  _claim="$UNIT_DIR/$UNIT_STEM.ended"; rm -rf "$_claim" "$_claim.stall"
  # Watchdog: TERM the session's process group (D6), KILL after the grace;
  # pkill -P is the fallback when there is no group. Who ended the unit is
  # decided once, by an atomic mkdir of $_claim: the watchdog takes it at the
  # deadline, the runner as soon as its wait returns. The loser does nothing,
  # so a session that ended on time is never marked or signalled. Each sleep
  # runs in the background and is waited on, so the teardown TERM interrupts
  # it at once and the trap reaps it (no orphaned sleep).
  # Idle (#59 R2): every _poll s the watchdog compares the log's size; once
  # it has not grown for _idle s, and the unit has no registered gate and no
  # open gate-routed Bash call, it stages `.ended.stall`, takes the claim and
  # moves the marker inside it (D5), then ends the session as the cap does.
  # With the idle check off (idle_minutes 0) it naps once, to the deadline.
  ( _sp=; _why=; trap 'kill $_sp 2>/dev/null; exit 0' TERM
    _end=$(( $(date +%s) + _secs )); _sz=""; _quiet=$(date +%s)
    while :; do
      _left=$(( _end - $(date +%s) )); [ "$_left" -gt 0 ] || break
      _nap="$_left"; [ -z "$_idle" ] || [ "$_nap" -le "$_poll" ] || _nap="$_poll"
      sleep "$_nap" & _sp=$!; wait "$_sp"
      [ -n "$_idle" ] || continue
      _s="$(wc -c < "$_log" 2>/dev/null | tr -d ' ')"; _now=$(date +%s)
      if [ "${_s:-0}" != "$_sz" ]; then _sz="${_s:-0}"; _quiet="$_now"; continue; fi
      [ $((_now - _quiet)) -ge "$_idle" ] || continue
      [ -z "$(ls -A "$_greg" 2>/dev/null)" ] || continue
      [ -z "$(open_calls "$_log" gate)" ] || continue
      _oc="$(open_calls "$_log" | head -n 1)"
      printf 'idle_min=%s\ncommand=%s\n' "$IDLE_MINUTES" "${_oc:--}" > "$_claim.stall"
      if mkdir "$_claim" 2>/dev/null; then mv -f "$_claim.stall" "$_claim/stalled"
      else rm -f "$_claim.stall"; [ ! -d "$_claim" ] || exit 0; fi
      _why=stall; break
    done
    # Lost only to the runner's claim (the dir exists); a mkdir failing for
    # any other reason (run dir gone, disk full) still ends a hung session.
    [ "$_why" = stall ] || mkdir "$_claim" 2>/dev/null || [ ! -d "$_claim" ] || exit 0
    kill -TERM -"$CPID" 2>/dev/null || { pkill -TERM -P "$CPID"; kill -TERM "$CPID"; }
    sleep "$GRACE" & _sp=$!; wait "$_sp"
    kill -KILL -"$CPID" 2>/dev/null || { pkill -KILL -P "$CPID"; kill -KILL "$CPID"; }
  ) > /dev/null 2>&1 &
  WPID=$!
  # Under a lane, LDIR/wpid lets the runner end this watchdog if the lane dies.
  [ -z "${LDIR:-}" ] || printf '%s\n' "$WPID" > "$LDIR/wpid"
  _st=0
  while :; do
    wait "$CPID"; _st=$?
    kill -0 "$CPID" 2>/dev/null || break
  done
  CPID=""; [ -z "${LDIR:-}" ] || rm -f "$LDIR/cpid"   # reaped: never signal a reused pid
  session_release
  heartbeat_stop; rm -f "$UNIT_DIR/unit.now"
  UNIT_EXIT="$_st"; UNIT_TIMED_OUT=0; UNIT_STALLED=0; UNIT_STALL_MIN=""; UNIT_STALL_CMD=""
  _won=1; mkdir "$_claim" 2>/dev/null || _won=0
  kill "$WPID" 2>/dev/null; wait "$WPID" 2>/dev/null
  WPID=""; [ -z "${LDIR:-}" ] || rm -f "$LDIR/wpid"   # reaped: never signal a pid number since reused
  if [ "$_won" = 0 ]; then
    # The watchdog won: a stall when its marker is in (or staged beside) the claim, else the cap.
    _sf="$_claim/stalled"; [ -f "$_sf" ] || _sf="$_claim.stall"
    if [ -f "$_sf" ]; then
      UNIT_STALLED=1
      UNIT_STALL_MIN="$(sed -n 's/^idle_min=//p' "$_sf" | head -n 1)"
      UNIT_STALL_CMD="$(sed -n 's/^command=//p' "$_sf" | head -n 1)"
    else UNIT_TIMED_OUT=1; fi
  fi
  rm -rf "$_claim" "$_claim.stall"
  [ "$UNIT_STALLED" = 0 ] || run_event unit_stalled "story=${CUR_ID:--}" "unit=$UNIT_TAG" "label=$2" "idle_min:=${UNIT_STALL_MIN:-0}" "command=${UNIT_STALL_CMD:--}"
  unit_reap "$UNIT_TAG"; [ -z "${LDIR:-}" ] || rm -f "$LDIR/utag"
  UNIT_MIN="$(awk -v s="$(( $(date +%s) - _t0 ))" 'BEGIN { printf "%.1f", s / 60 }')"
  UNIT_COST="$(cost_of "$UNIT_DIR/$UNIT_STEM.jsonl")"; [ -n "$UNIT_COST" ] || UNIT_COST=unknown
  requeue_check
}
row() {  # row N LABEL OUTCOME — the label column is ID-LABEL when CUR_ID is set
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "${CUR_ID:+$CUR_ID-}$2" "$UNIT_EXIT" "$UNIT_COST" "$UNIT_MIN" "$UNIT_TIMED_OUT" "$3" \
    >> "$UNIT_DIR/units.tsv" || { say "cannot write $UNIT_DIR/units.tsv"; exit 3; }
  say "${CUR_ID:+$CUR_ID }$2 · ended: $3 · exit $UNIT_EXIT · $UNIT_MIN min${UNIT_REAPED:+ · a left-behind gate was ended}"
  run_event unit_ended "story=${CUR_ID:--}" "unit=$UNIT_TAG" "label=$2" "outcome=$3" "usd:=$UNIT_COST"
}
# unit_outcome — a unit that changed nothing: `timed out` when the session
# cap ended it (UNIT_TIMED_OUT); `stalled` when the idle watchdog ended it
# (UNIT_STALLED, #59 R2); `orphaned` when the session ended its turn
# with background work running, so print mode killed that work 600 s later
# and said so on stderr (phoenix mob-composer-parity, 2026-10-03); else
# `noprog`. An orphaned unit counts as no progress everywhere else.
unit_outcome() {
  if [ "${UNIT_TIMED_OUT:-0}" = 1 ]; then echo "timed out"
  elif [ "${UNIT_STALLED:-0}" = 1 ]; then echo stalled
  elif grep -q 'Background tasks still running after' "$UNIT_DIR/$UNIT_STEM.err" 2>/dev/null; then echo orphaned
  else echo noprog; fi
}
# orphan_note OUTCOME — the cause appended to a no-progress ending when
# OUTCOME is `orphaned`; empty otherwise.
orphan_note() {
  [ "$1" = orphaned ] && printf ' (orphaned: the session ended its turn with background work running)'
  return 0
}
# stall_note — #59 R2: the cause appended to a stalled ending, from the last
# run_unit: ` (no output for <N> min: <newest open call, or ->)`.
stall_note() { printf ' (no output for %s min: %s)' "${UNIT_STALL_MIN:-${IDLE_MINUTES:-}}" "${UNIT_STALL_CMD:--}"; }
# write_report REASON — the morning report: how it ended, what it cost, the
# rulings to check, what to play, the PR, and how to resume.
write_report() {
  _ld="$(ledger_of "$(feature_dir)")"
  _tsv="$RUN_DIR/units.tsv"; [ -f "$_tsv" ] || _tsv=/dev/null
  _pr="$(printf '%s\n' "$_ld" | sed -n 's/^- [0-9-]* shipped //p' | tail -n 1)"
  _unk="$(awk -F'\t' '$4 == "unknown" { n++ } END { print n + 0 }' "$_tsv")"
  _spent="$(spent)"; [ "$_unk" -eq 0 ] || _spent="$_spent (cost unknown for $_unk unit(s))"
  _started="$(sed -n 's/^started=//p' "$LOCK" 2>/dev/null | head -n 1)"
  {
    printf '# Overnight run — %s\n\n' "$(basename "$RUN_DIR")"
    printf 'Ending: %s\n' "$1"
    printf 'Plan: %s\n' "$(state get plan 2>/dev/null)"
    printf 'Branch: %s\n' "$(state get branch 2>/dev/null)"
    printf 'PR: %s\n' "${_pr:-none}"
    printf 'Spent: $%s\n' "$_spent"
    printf 'Started: %s · Ended: %s\n\n' "${_started:-unknown}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf '## Units\n\n| # | Unit | Exit | Cost | Minutes | Timed out | Outcome |\n|---|------|------|------|---------|-----------|---------|\n'
    awk -F'\t' '{ printf "| %s | %s | %s | %s | %s | %s | %s |\n", $1, $2, $3, $4, $5, $6, $7 }' "$_tsv"
    printf '\n## Rulings\n\n'
    printf '%s\n' "$_ld" | grep -E '^- [0-9-]* ([^ ]+ )?Ruling: ' || echo '(none)'
    printf '\n## Play list\n\n'
    printf '%s\n' "$_ld" | grep -E '^- [0-9-]* P[0-9]+ Play: ' || echo '(none)'
    _wr_m="$(msgs_left -)"
    [ -z "$_wr_m" ] || printf '\n## Operator messages left\n\n%s\n' "$_wr_m"
    if [ "$1" != done ]; then
      printf '\n## Resume\n\ncd %s && %s start\n' "$(sq "$(story_dir)")" "$(sq "$SELF_ABS")"
    fi
  } > "$RUN_DIR/report.md"
  case "$1" in
    done) ;;
    "stopped by operator") state_event - "$1" ;;
    *) state_event - "stopped $1" ;;
  esac
  run_event run_ended "ending=$1" "report=$RUN_DIR/report.md"
}
unlock() {
  [ -z "${INHIB_PID:-}" ] || kill "$INHIB_PID" 2>/dev/null
  INHIB_PID=""
  # Only what this run holds (D11): the lock while it names this pid, and its own stop flag.
  [ "$(lock_pid)" != "$$" ] || rm -f "$LOCK"
  rm -f "$STOP_FILE"
  reg_end
}
# finish_run REASON — report, unlock, exit (0 only for done).
finish_run() {
  write_report "$1"
  unlock
  REPORTED=1
  [ "$1" = done ] && exit 0
  exit 1
}
# end_session — TERM the live session's group, poll up to GRACE seconds,
# then KILL it, so no session outlives the lock (pkill -P/kill when there is
# no group, as the watchdog does). The watchdog goes first: it must not act.
# Then the unit's session slot or wait entry is released (session_release).
end_session() {
  [ -z "${WPID:-}" ] || { kill "$WPID" 2>/dev/null; wait "$WPID" 2>/dev/null; }
  heartbeat_stop
  { [ -n "${CPID:-}" ] && kill -0 "$CPID" 2>/dev/null; } || { unit_reap "${UNIT_TAG:-}"; session_release; return 0; }
  kill -TERM -"$CPID" 2>/dev/null || { pkill -TERM -P "$CPID"; kill -TERM "$CPID"; } 2>/dev/null
  _g=0
  while { kill -0 -"$CPID" 2>/dev/null || kill -0 "$CPID" 2>/dev/null; } && [ "$_g" -lt "${GRACE:-30}" ]; do
    sleep 1; _g=$((_g + 1))
  done
  kill -KILL -"$CPID" 2>/dev/null || { pkill -KILL -P "$CPID"; kill -KILL "$CPID"; } 2>/dev/null
  wait "$CPID" 2>/dev/null
  unit_reap "${UNIT_TAG:-}"
  session_release   # the session is gone: its slot (or a wait entry) goes (#39 AC27)
}
# on_exit CODE — the EXIT trap (D18): an ending that never reached
# finish_run is a runner error, or a closed terminal (HUP_REQ). Any live
# session is ended first; then it still gets a report and unlocks.
REPORTED=0
HUP_REQ=0
on_exit() {
  [ "$REPORTED" = 1 ] && return 0
  trap '' HUP INT TERM
  end_session
  session_release
  # A story held when the runner died keeps its why (AC25); its report is
  # written, so the held record goes (R25).
  _oe_h=""
  if [ -f "$RUN_DIR/control/-.held" ]; then
    _oe_r="$(cat "$RUN_DIR/control/-.held" 2>/dev/null)"; _oe_r="${_oe_r#held }"
    _oe_h=" (was held: ${_oe_r% until *})"
  fi
  if [ "$HUP_REQ" = 1 ]; then
    write_report "stop: terminal closed (SIGHUP)$_oe_h"
  else
    write_report "stop: runner error (exit $1)$_oe_h"
  fi
  rm -f "$RUN_DIR/control/-.held"
  unlock
  exit 1
}

# story_units — bundle 2's unit loop for the current story. Returns with
# ENDING set: done · stopped by user · stopped by operator · held by
# operator · directive <id> not recorded · stop: <reason> · stop: run budget ·
# no progress on <label> [(orphaned: …)] · timed out on <label> (…) ·
# stalled on <label> (no output for <N> min: <command>) ·
# stop: unexpected stage <s> · unit_pre's (lanes: sync repair: <reason>, or
# the halt reason). Its scratch files
# live in UNIT_DIR (the run dir; a lane's own dir in manifest mode). Unit
# numbers run on from the caller's n (0 when unset), so a second call for the
# same story (after a gate repair) never reuses a unit's file names.
story_units() {
  n="${n:-0}"; noprog=0; suffix=""; _su_first=1
  STOP_ENDING=""; STOP_SRC=""
  while :; do
    # #42 AC38: the story is where its pointer is; ambiguous or gone stops.
    story_resolve || { ENDING="stop: $STORY_WHY"; return 0; }
    op_boundary "${CUR_ID:--}" || return 0
    # First pass takes the before-snapshot; later passes reuse the previous after-snapshot.
    if [ "$_su_first" = 1 ]; then snapshot "$UNIT_DIR/stops.before"; _su_first=0
    else cp "$UNIT_DIR/stops.after" "$UNIT_DIR/stops.before"; fi
    _stage="$SIG_STAGE"
    case "$_stage" in plan|execute) ;; *) ENDING="stop: unexpected stage $_stage"; return 0 ;; esac
    if run_budget_out; then ENDING="stop: run budget"; return 0; fi
    _base="${STUDIO_OVERNIGHT_LABEL:-$(label_for)}"
    unit_pre "$_base" || return 0
    _before="$SIG"
    n=$((n + 1)); run_unit "$n" "$_base$suffix"
    [ "$UNIT_HALTED" = 0 ] || { ENDING="$(halt_reason)"; return 0; }   # halted waiting for a slot (D22)
    snapshot "$UNIT_DIR/stops.after"
    take_new_stop "$UNIT_DIR/stops.before" "$UNIT_DIR/stops.after"
    if [ -n "$NEW_STOP" ]; then row "$n" "$_base$suffix" stop; ENDING="$STOP_ENDING"; return 0; fi
    if [ "$SIG_STAGE" = idle ] && [ "$SIG_SHIPPED" -gt 0 ]; then row "$n" "$_base$suffix" done; ENDING=done; return 0; fi
    if [ -n "$REQ_LIMIT" ]; then
      if [ "$SIG" != "$_before" ]; then _su_o=progress; else _su_o="$(unit_outcome)"; fi
      row "$n" "$_base$suffix" "$_su_o"; ENDING="directive $REQ_LIMIT not recorded"; return 0
    fi
    if [ "$SIG" != "$_before" ]; then row "$n" "$_base$suffix" progress; noprog=0; suffix=""; continue; fi
    _out="$(unit_outcome)"; row "$n" "$_base$suffix" "$_out"; noprog=$((noprog + 1))
    if [ "$noprog" -le "$RETRIES" ]; then suffix="-retry"; continue; fi
    if [ "$_out" = "timed out" ]; then ENDING="timed out on $_base (session_minutes $SESSION_MINUTES)"
    elif [ "$_out" = stalled ]; then ENDING="stalled on $_base$(stall_note)"
    else ENDING="no progress on $_base$(orphan_note "$_out")"; fi
    return 0
  done
}

# detach_start MANIFEST — start the run detached from the chat (D1a): the
# preflight runs here in the foreground (a refusal shows and exits 2; it
# includes the worktree_setup check, whose commit the child gets in
# STUDIO_OVERNIGHT_SETUP_CHECKED so it does not run it again), then
# this script re-execs itself in its own session (perl setsid), stdin
# /dev/null, output to a log, with every CLAUDECODE, CLAUDE_*, AI_AGENT,
# OMEGA_* and STUDIO_* variable removed (CLAUDE_CONFIG_DIR kept). Success
# only when `status` exits 0 for that child within 10 s.
detach_start() {
  _dm="$1"
  # Test hooks, read before the strip: a status check that never answers, and
  # a stand-in child command (shell text) for the re-exec'd run.
  _dhs="${STUDIO_OVERNIGHT_DETACH_STATUS_CMD:-}"; _dhc="${STUDIO_OVERNIGHT_DETACH_CHILD_CMD:-}"
  # The chat's variables go first, so the foreground preflight and the child
  # both see the clean environment (a stray STUDIO_STORY would aim state at a
  # story file). PATH and CLAUDE_CONFIG_DIR stay, and a valid STUDIO_RUN_ORIGIN
  # is passed on explicitly below (AC1a): origin_take already took it.
  for _dn in $(env | sed -nE 's/^(CLAUDECODE|CLAUDE_[A-Za-z0-9_]*|AI_AGENT|OMEGA_[A-Za-z0-9_]*|STUDIO_[A-Za-z0-9_]*)=.*/\1/p' | grep -vx CLAUDE_CONFIG_DIR); do
    unset "$_dn" 2>/dev/null || true
  done
  START_DIR="$(sh "$STATE_BIN" root --work 2>/dev/null || true)"
  STATE_ROOT="$(sh "$STATE_BIN" root 2>/dev/null || true)"
  preflight manifest
  # The check is a background job we wait on, so a signal to this process
  # (a closed terminal, a caller's timeout) stops it too: detach_check_interrupt.
  DCK_F="$(mktemp "${TMPDIR:-/tmp}/detach-check.XXXXXX")" || { say "--detach: mktemp failed"; exit 2; }
  DCK_PID=""
  trap 'detach_check_interrupt' INT TERM HUP
  ( . "$SELF_DIR/overnight-lanes.sh"; lanes_start --check "$_dm" ) > "$DCK_F" &
  DCK_PID=$!
  _dck_rc=0; wait "$DCK_PID" || _dck_rc=$?
  trap - INT TERM HUP
  DCK_PID=""
  _dck="$(cat "$DCK_F")"; rm -f "$DCK_F"
  [ "$_dck_rc" -eq 0 ] || exit 2
  # Empty (worktree_setup unset) or one commit id (40 or, in a SHA-256 repo, 64 hex).
  case "$_dck" in
    '') ;;
    *[!0-9a-f]*) say "worktree_setup check printed an unexpected commit: $_dck"; exit 2 ;;
    *) [ "${#_dck}" -eq 40 ] || [ "${#_dck}" -eq 64 ] \
         || { say "worktree_setup check printed an unexpected commit: $_dck"; exit 2; } ;;
  esac
  _dmf="$_dm"; case "$_dmf" in /*) ;; *) _dmf="$START_DIR/$_dmf" ;; esac
  _dslug="$(runs_mf_slug "$_dmf")"
  # The dry run checked it (mf_check); checked again here, since it names a path.
  printf '%s\n' "$_dslug" | grep -Eq '^[A-Za-z0-9._-]+$' \
    || { say "manifest: '# Run: <slug>' must name a slug of [A-Za-z0-9._-], got '$_dslug'"; exit 2; }
  # The child's own lock (AC4): detach waits on it and on `status --run`, never on any live run.
  LOCK="$STATE_ROOT/.studio/runs/$_dslug/lock"
  _dcmd="cd $(sq "$(pwd)") && $(sq "$SELF_ABS") start $(sq "$_dm")"
  if ! command -v perl >/dev/null 2>&1; then
    say "--detach is not available on this machine — run the printed command"
    echo "$_dcmd"; exit 2
  fi
  mkdir -p "$REPORTS" || { say "cannot create $REPORTS"; exit 2; }
  _dlog="$REPORTS/overnight-$_dslug-detached-$(date +%Y%m%d-%H%M%S).log"
  if [ -n "$_dhc" ]; then
    nohup env ${RUN_ORIGIN:+"STUDIO_RUN_ORIGIN=$RUN_ORIGIN"} ${_dck:+"STUDIO_OVERNIGHT_SETUP_CHECKED=$_dck"} perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' sh -c "$_dhc" </dev/null >"$_dlog" 2>&1 &
  else
    nohup env ${RUN_ORIGIN:+"STUDIO_RUN_ORIGIN=$RUN_ORIGIN"} ${_dck:+"STUDIO_OVERNIGHT_SETUP_CHECKED=$_dck"} perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' sh "$SELF_ABS" start "$_dm" </dev/null >"$_dlog" 2>&1 &
  fi
  _dpid=$!
  _di=0
  while [ "$_di" -lt 10 ]; do
    if kill -0 "$_dpid" 2>/dev/null; then
      if { if [ -n "$_dhs" ]; then eval "$_dhs"; else sh "$SELF_ABS" status --run "$_dslug"; fi; } >/dev/null 2>&1 && [ "$(lock_pid)" = "$_dpid" ]; then
        _drun="$(sed -n 's/^run=//p' "$LOCK" 2>/dev/null | head -n 1)"
        [ -z "$_drun" ] || ln -sf "$_dlog" "$_drun/runner.log" 2>/dev/null || true
        echo "detached: pid $_dpid, log $_dlog"
        echo "watch: $(sq "$SELF_ABS") watch --run $_dslug · status: $(sq "$SELF_ABS") status --run $_dslug (from the project; plain status from anywhere)"
        return 0
      fi
    else
      _drc=0; wait "$_dpid" 2>/dev/null || _drc=$?
      cat "$_dlog" >&2
      say "the detached run did not start"
      [ "$_drc" -ne 0 ] || _drc=1
      return "$_drc"
    fi
    sleep 1; _di=$((_di + 1))
  done
  if lock_live && [ "$(lock_pid)" = "$_dpid" ]; then
    # The child holds the run lock: the run is live, only status was slow.
    say "the detached run is live (pid $_dpid, log $_dlog) but did not answer status in 10 s — $(sq "$SELF_ABS") status --run $_dslug, or $(sq "$SELF_ABS") stop --run $_dslug"
    return 1
  fi
  # No lock: end the child's process group (setsid made it the group leader).
  kill -TERM -- "-$_dpid" 2>/dev/null || kill -TERM "$_dpid" 2>/dev/null || true
  _di=0
  while [ "$_di" -lt 3 ] && kill -0 "$_dpid" 2>/dev/null; do sleep 1; _di=$((_di + 1)); done
  kill -KILL -- "-$_dpid" 2>/dev/null || kill -KILL "$_dpid" 2>/dev/null || true
  wait "$_dpid" 2>/dev/null || true
  say "the detached run never took the lock and was ended (log $_dlog) — run the plain command"
  echo "$_dcmd"
  return 1
}

# detach_check_interrupt — INT/TERM/HUP during detach's foreground check: TERM
# the check (a background job has SIGINT ignored; its own trap stops
# studio-setup, drops the scratch worktree and says so, exit 2), wait for it.
detach_check_interrupt() {
  trap '' INT TERM HUP
  _dci_rc=0
  if [ -n "$DCK_PID" ]; then kill -TERM "$DCK_PID" 2>/dev/null; wait "$DCK_PID" 2>/dev/null || _dci_rc=$?; fi
  rm -f "$DCK_F"
  # 2: the check refused or said "interrupted" itself; anything else: it said nothing.
  [ "$_dci_rc" -eq 2 ] || say "worktree_setup check interrupted — nothing started"
  exit 2
}

cmd_start() {
  origin_take
  # Manifest mode: the first non-flag argument names the manifest (D18).
  _mf=""; _dt=0; _dr=0
  for _a in "$@"; do
    case "$_a" in
      --dry-run) _dr=1 ;;
      --detach) _dt=1 ;;
      -*) usage >&2; exit 2 ;;
      *) [ -z "$_mf" ] || { usage >&2; exit 2; }; _mf="$_a" ;;
    esac
  done
  if [ "$_dt" -eq 1 ]; then
    { [ -n "$_mf" ] && [ "$_dr" -eq 0 ]; } || { usage >&2; exit 2; }
    detach_start "$_mf"
    exit $?
  fi
  if [ -n "$_mf" ]; then
    preflight manifest
    . "$SELF_DIR/overnight-lanes.sh"
    lanes_start "$@"
    exit $?
  fi
  _dry=0
  case "${1:-}" in
    '') ;;
    --dry-run) _dry=1 ;;
    *) usage >&2; exit 2 ;;
  esac
  [ "$#" -le 1 ] || { usage >&2; exit 2; }
  preflight
  if [ "$_dry" -eq 1 ]; then
    UNIT_MODEL="$MODEL_TASK"
    setup_preflight_note "$DEFAULT_BRANCH"
    with_launch_args print_launch
    exit 0
  fi
  setup_preflight "$DEFAULT_BRANCH"
  RUN_DIR="$REPORTS/overnight-$(date +%Y%m%d-%H%M%S)"
  acquire_run_lock
  trap 'on_exit $?' EXIT
  STOP_REQ=0
  trap 'STOP_REQ=1' INT TERM
  trap 'HUP_REQ=1; exit 129' HUP
  run_setup
  run_event run_started mode=single max_lanes:=1 "hold_minutes:=$HOLD_MINUTES"
  run_event story_listed story=- chain:=1 'depends[]='
  EV_ON=1; state_event - running
  UNIT_DIR="$RUN_DIR"; UNIT_PREFIX=""; CUR_ID=""; n=0
  story_units
  # A holdable ending waits for the operator (AC17-25); a resume runs the
  # unit loop on (a new stop holds again).
  while holdable; do
    hold_wait - || break
    story_units
  done
  # A halt that raced the operator's hold keeps the halt's reason.
  [ "$ENDING" != "held by operator" ] || ENDING="$(halt_reason)"
  ctl_clear -
  finish_run "$ENDING"
}

# acquire_run_lock — the run lock for RUN_DIR (a stale one reclaimed), then
# RUN_DIR itself; exit 2 when another start holds it. Both modes (D18).
acquire_run_lock() {
  if [ -f "$LOCK" ]; then
    # Only a dead holder's lock is reclaimed: a live one (a second start of
    # the same slug shares its lock path) refuses, and nothing of it is touched.
    if runs_lock_live "$LOCK"; then say "$(lock_held_by "$LOCK")"; exit 2; fi
    _stale="$(lock_pid)"
    say "reclaiming stale lock (pid $_stale)"
    # Test hook: runs between reading the stale pid and removing the lock.
    [ -z "${STUDIO_OVERNIGHT_RACE_HOOK:-}" ] || eval "$STUDIO_OVERNIGHT_RACE_HOOK"
    # mv is atomic: only one starter gets the stale file. If its holder is
    # live, or it no longer names the dead pid we read, another start already
    # retook the lock: it goes back, untouched.
    if mv "$LOCK" "$LOCK.stale.$$" 2>/dev/null; then
      if runs_lock_live "$LOCK.stale.$$"; then
        _why="$(lock_held_by "$LOCK" "$LOCK.stale.$$")"
        ln "$LOCK.stale.$$" "$LOCK" 2>/dev/null || true
        rm -f "$LOCK.stale.$$"
        say "lock taken by another start: $_why"; exit 2
      fi
      _got="$(sed -n 's/^pid=//p' "$LOCK.stale.$$" | head -n 1)"
      if [ "$_got" != "$_stale" ]; then
        ln "$LOCK.stale.$$" "$LOCK" 2>/dev/null || true
        rm -f "$LOCK.stale.$$"
        say "lock taken by another start"; exit 2
      fi
      rm -f "$LOCK.stale.$$"
    fi
  fi
  # The run's state paths are kept out of git before the lock exists (D6).
  run_excludes
  # A stop file left over from an earlier run goes before the lock, so a
  # `stop` issued once this run holds the lock is never lost.
  rm -f "$STOP_FILE"
  mkdir -p "$(dirname "$LOCK")"
  # Test hook (D10): runs after the preflight, just before the lock is taken.
  [ -z "${STUDIO_OVERNIGHT_LOCK_HOOK:-}" ] || eval "$STUDIO_OVERNIGHT_LOCK_HOOK"
  take_lock "$RUN_DIR" || { say "lock taken by another start"; exit 2; }
  # The run dir only once the lock is ours: a lost race leaves nothing behind.
  mkdir -p "$RUN_DIR" || { rm -f "$LOCK"; say "cannot create $RUN_DIR"; exit 2; }
  run_populate || lock_lost "cannot populate $RUN_DIR"
  # AC8/AC5 re-check (D8, D9): the lock first, so of two starts the later re-check sees the earlier.
  mx_take "$STATE_ROOT/.studio/runs.mutex" "$$" || lock_lost "$STATE_ROOT/.studio/runs.mutex is busy — start again"
  lock_recheck || lock_lost "$RECHECK_WHY"
  mx_drop "$STATE_ROOT/.studio/runs.mutex" "$$"
  reg_write
  say "run $RUN_DIR started (pid $$) — watch: $(sq "$SELF_ABS") watch · status: $(sq "$SELF_ABS") status${RUN_SLUG:+ --run $RUN_SLUG} · stop: $(sq "$SELF_ABS") stop${RUN_SLUG:+ --run $RUN_SLUG}"
}
# lock_recheck — after take_lock, under runs.mutex (D8): 0 when this start
# may run; 1 with RECHECK_WHY. A single-plan run excludes every other run.
# overnight-lanes.sh redefines it for manifest runs.
lock_recheck() {
  _lc="$(runs_live "$STATE_ROOT" | awk -F'\t' -v me="$LOCK" '$7 != me' | head -n 1)"
  [ -n "$_lc" ] || return 0
  RECHECK_WHY="a run is live: $(printf '%s\n' "$_lc" | awk -F'\t' '{ print ($2 == "-" ? "single-plan" : $2) " (" $5 ", pid " $4 ")" }') — $(sq "$SELF_ABS") status"
  return 1
}
# lock_held_by LOCKPATH [FILE] — the refusal text for a live run's lock
# (lock_recheck's form): `a run is live: <slug> (<run dir>, pid <pid>) —
# status [--run <slug>]`. The slug comes from LOCKPATH, the rest from FILE
# (default LOCKPATH; a moved copy of it during a reclaim).
lock_held_by() {
  _lh_f="${2:-$1}"; _lh_d="$(runs_kv run "$_lh_f")"
  case "$1" in
    */.studio/overnight.lock)
      if [ -f "$_lh_d/manifest.md" ]; then _lh_s="$(runs_mf_slug "$_lh_d/manifest.md")"; else _lh_s=single-plan; fi ;;
    *) _lh_s="${1%/lock}"; _lh_s="${_lh_s##*/}" ;;
  esac
  _lh_r=""; [ "$_lh_s" = single-plan ] || _lh_r=" --run $_lh_s"
  printf 'a run is live: %s (%s, pid %s) — %s status%s\n' "$_lh_s" "$_lh_d" "$(runs_kv pid "$_lh_f")" "$(sq "$SELF_ABS")" "$_lh_r"
}
run_populate() { :; }   # overnight-lanes.sh fills the run dir before the re-check (D9)
# lock_lost WHY — this start lost: its lock, run dir and empty record dir go, the mutex is dropped, exit 2.
lock_lost() {
  [ "$(lock_pid)" != "$$" ] || rm -f "$LOCK"
  rm -rf "$RUN_DIR"
  [ "$LOCK" = "$STATE_ROOT/.studio/overnight.lock" ] || rmdir "$(dirname "$LOCK")" 2>/dev/null
  mx_drop "$STATE_ROOT/.studio/runs.mutex" "$$"
  say "$1"; exit 2
}
# run_excludes — the run's machine-local paths into the common git dir's
# info/exclude, each once (D6): the single-plan lock and stop flag, the
# per-run records and locks, the session slots, both mutexes and their reap
# locks (mx_reap), and the final step's worktrees. Sets _excl.
run_excludes() {
  _excl="$(git -C "$START_DIR" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
  mkdir -p "$(dirname "$_excl")"
  for _e in .studio/overnight.lock .studio/overnight.stop .studio/runs/ .studio/sessions/ \
            .studio/runs.mutex .studio/sessions.mutex .studio/runs.mutex.reap/ .studio/sessions.mutex.reap/ \
            .claude/worktrees/; do
    grep -qxF "$_e" "$_excl" 2>/dev/null || printf '%s\n' "$_e" >> "$_excl"
  done
}
# setup_preflight BRANCH — #49: worktree_setup once, through studio-setup (its
# gate lock, timeout, log and marker), in a scratch linked worktree at
# origin/BRANCH, so a command that breaks only where .git is a file is refused
# here and not by the first story at night. Silent when unset. --detach's
# child gets STUDIO_OVERNIGHT_SETUP_CHECKED (read once, then unset): the
# base's commit skips the check; any other commit (BRANCH moved since detach
# checked it) refuses, since re-running a long setup would outlast detach's
# status window. Green: SP_SHA is the commit, the worktree is gone. Anything
# else: the worktree is gone and start exits 2 (refused).
SP_W=""; SP_PID=""; SP_SHA=""; SP_FETCHED=""; _sp_ef=""
setup_preflight() {
  _sp_ck="${STUDIO_OVERNIGHT_SETUP_CHECKED:-}"; unset STUDIO_OVERNIGHT_SETUP_CHECKED
  [ -n "${WORKTREE_SETUP:-}" ] || return 0
  if [ -n "$_sp_ck" ]; then
    sp_base "$1"
    if [ "$_sp_ck" = "$SP_SHA" ]; then
      say "worktree_setup: checked by start --detach at $(printf '%.7s' "$SP_SHA")"; return 0
    fi
    SP_SHA=""; say "worktree_setup: origin/$1 moved since start --detach checked it — start --detach again"; exit 2
  fi
  say "worktree_setup: checking it once in a scratch linked worktree off origin/$1 before launch — up to ${WORKTREE_SETUP_MINUTES:-20} min (worktree_setup_minutes), longer while another run holds the gate lock"
  _sp_ef=""; SP_PID=""; SP_W=""
  trap 'sp_interrupt' INT TERM HUP
  sp_base "$1"
  # This process's own pid ($$ is the parent's inside $( ) or a background
  # subshell): the scratch tree and its marker name the process that owns it.
  _sp_me="$(exec sh -c 'echo $PPID')"
  sp_sweep "$_sp_me"
  run_excludes
  _sp_w="$STATE_ROOT/.claude/worktrees/setup-preflight-$_sp_me"
  [ ! -e "$_sp_w" ] || sp_refuse "$_sp_w exists and is not this check's scratch worktree — move it, then start again"
  mkdir -p "$(dirname "$_sp_w")" || sp_refuse "cannot create $(dirname "$_sp_w")"
  SP_W="$_sp_w"
  _sp_ge="$(sp_git -C "$START_DIR" worktree add -q --detach "$SP_W" "$SP_SHA" 2>&1 >/dev/null)" \
    || sp_refuse "cannot add the scratch worktree $SP_W — $(sp_last "$_sp_ge")"
  # The marker the sweep requires: a tree that merely has the name is never swept.
  _sp_gd="$(git -C "$SP_W" rev-parse --absolute-git-dir 2>/dev/null)" \
    && printf '%s\n' "$_sp_me" > "$_sp_gd/studio-setup-preflight" \
    || sp_refuse "cannot mark the scratch worktree $SP_W"
  _sp_ef="$(mktemp "${TMPDIR:-/tmp}/setup-preflight.XXXXXX")" || { _sp_ef=""; sp_refuse "mktemp failed"; }
  # Background + wait: a trapped signal interrupts wait at once (D4).
  ( cd "$SP_W" && exec sh "$SELF_DIR/studio-setup" ) > /dev/null 2> "$_sp_ef" &
  SP_PID=$!
  _sp_rc=0; wait "$SP_PID" || _sp_rc=$?
  trap - INT TERM HUP
  SP_PID=""
  _sp_l="$(tail -n 1 "$_sp_ef" 2>/dev/null)"; rm -f "$_sp_ef"; _sp_ef=""
  if [ "$_sp_rc" -eq 0 ]; then sp_remove; say "worktree_setup: green in a linked worktree"; return 0; fi
  _sp_log=""
  case "$_sp_l" in
    *" — log "*)
      mkdir -p "$REPORTS" && { [ -f "$REPORTS/.gitignore" ] || printf '*\n' > "$REPORTS/.gitignore"; }
      _sp_log="$REPORTS/setup-preflight-$(date +%Y%m%d-%H%M%S)-$_sp_me.log"
      cp "$SP_W/${_sp_l##* — log }" "$_sp_log" 2>/dev/null || _sp_log="" ;;
  esac
  sp_remove
  case "$_sp_rc" in
    1) _sp_n="$(printf '%s\n' "$_sp_l" | sed -n 's/^worktree setup failed — exit \([0-9]*\) — .*/\1/p')"
       [ "$_sp_n" != 124 ] || _sp_n="124 (timed out after worktree_setup_minutes)"
       say "worktree_setup failed in a linked worktree — exit ${_sp_n:-?} — log ${_sp_log:-unavailable} — a story's worktree is linked too (.git is a file there): fix the command, then start again" ;;
    2) say "worktree_setup check: ${_sp_l:-studio-setup refused the config}" ;;
    *) say "worktree_setup check ended with exit $_sp_rc — ${_sp_l:-no output}" ;;
  esac
  SP_SHA=""
  exit 2
}
# sp_base BRANCH — SP_SHA, origin/BRANCH's commit, after a fetch of BRANCH
# (skipped when manifest mode's mf_check fetched origin in this process:
# SP_FETCHED names that Target). A failure refuses (sp_refuse).
sp_base() {
  if [ "${SP_FETCHED:-}" != "$1" ]; then
    _sp_ge="$(sp_git -C "$START_DIR" fetch -q origin "$1" 2>&1 >/dev/null)" \
      || sp_refuse "git fetch origin $1 failed — $(sp_last "$_sp_ge")"
  fi
  SP_SHA="$(git -C "$START_DIR" rev-parse -q --verify "refs/remotes/origin/$1^{commit}" 2>/dev/null)" \
    || sp_refuse "no origin/$1"
}
# sp_git ARGS… — git through git_retry once manifest mode has loaded it
# (concurrent runs contend on git's locks, #39); plain git otherwise.
sp_git() { if command -v git_retry >/dev/null 2>&1; then git_retry "$@"; else git "$@"; fi; }
# sp_last TEXT — TEXT's last non-blank line, or "no output".
sp_last() {
  _sl="$(printf '%s\n' "$1" | sed '/^[[:space:]]*$/d' | tail -n 1)"
  printf '%s\n' "${_sl:-no output}"
}
# sp_refuse MESSAGE — the check could not run: clean up, say so, exit 2.
sp_refuse() {
  trap '' INT TERM HUP
  [ -z "${_sp_ef:-}" ] || rm -f "$_sp_ef"
  sp_remove; SP_SHA=""
  say "worktree_setup check: $1"
  exit 2
}
# setup_preflight_note BRANCH — the dry run's one line (R3): start checks it, the dry run does not.
setup_preflight_note() {
  [ -n "${WORKTREE_SETUP:-}" ] || return 0
  echo "worktree_setup: start checks it once in a scratch linked worktree off origin/$1 before launch (up to ${WORKTREE_SETUP_MINUTES:-20} min); --dry-run does not run it"
}
# sp_remove — the scratch worktree, gone (a plain rm and a prune when git refuses).
sp_remove() {
  [ -n "$SP_W" ] || return 0
  git -C "$START_DIR" worktree remove --force "$SP_W" >/dev/null 2>&1 \
    || { rm -rf "$SP_W"; git -C "$START_DIR" worktree prune >/dev/null 2>&1; }
  SP_W=""
}
# sp_sweep ME — leftovers of a SIGKILLed check: setup-preflight-<pid> whose
# pid is not running (or is ME: a reused pid) and whose admin dir carries the
# marker naming that pid. A tree that merely has the name is never touched.
sp_sweep() {
  for _sw in "$STATE_ROOT"/.claude/worktrees/setup-preflight-*; do
    [ -d "$_sw" ] || continue
    _swp="${_sw##*-}"
    case "$_swp" in ''|*[!0-9]*) continue ;; esac
    [ "$_swp" = "$1" ] || ! kill -0 "$_swp" 2>/dev/null || continue
    _swg="$(git -C "$_sw" rev-parse --absolute-git-dir 2>/dev/null)" || continue
    [ "$(cat "$_swg/studio-setup-preflight" 2>/dev/null)" = "$_swp" ] || continue
    SP_W="$_sw"; sp_remove
  done
}
# sp_interrupt — INT/TERM/HUP during the check: stop studio-setup (TERM — its
# own trap ends the command's group and frees the gate lock), drop the worktree.
sp_interrupt() {
  trap '' INT TERM HUP
  if [ -n "$SP_PID" ]; then kill -TERM "$SP_PID" 2>/dev/null; wait "$SP_PID" 2>/dev/null; fi
  [ -z "${_sp_ef:-}" ] || rm -f "$_sp_ef"
  sp_remove
  say "worktree_setup check interrupted — nothing started"
  exit 2
}
# run_setup — once the lock and traps are in place: the sleep inhibitor, the
# reports dir's .gitignore, and the run's paths kept out of git.
run_setup() {
  printf 'hold_minutes=%s\ndirective_chars=%s\n' "$HOLD_MINUTES" "$DIRECTIVE_CHARS" > "$RUN_DIR/channel" \
    || say "cannot write $RUN_DIR/channel — the operator verbs will refuse this run"
  INHIB_PID=""
  case "$(uname -s)" in
    Darwin)
      if command -v caffeinate >/dev/null 2>&1; then
        caffeinate -i -w $$ >/dev/null 2>&1 &
        INHIB_PID=$!
      fi ;;
    Linux)
      if command -v systemd-inhibit >/dev/null 2>&1; then
        systemd-inhibit --what=idle:sleep --why=studio-overnight sh -c "while kill -0 $$ 2>/dev/null; do sleep 60; done" >/dev/null 2>&1 &
        INHIB_PID=$!
      fi ;;
  esac
  [ -n "$INHIB_PID" ] || say "no sleep inhibitor (caffeinate or systemd-inhibit) — the machine may sleep; the run resumes with studio-overnight start"
  [ -f "$REPORTS/.gitignore" ] || printf '*\n' > "$REPORTS/.gitignore"
  run_excludes
}

# ---- status and watch ----

# ended_line REPORT — an ended run in one line: `ended (<ending>)[ — <id>
# stopped: <why>; …] — report: <REPORT>[ — resume: <command>]`. The ending
# is the report's (a partial run's counts dropped); the stopped stories come
# from a manifest run's stories/ records; the command is the report's Resume.
ended_line() {
  _el_d="$(dirname "$1")"
  _el_e="$(sed -n 's/^Ending: //p' "$1" | head -n 1)"
  case "$_el_e" in partial:*) _el_e=partial ;; '') _el_e=unknown ;; esac
  _el_s=""
  if [ -f "$_el_d/rows.tsv" ]; then
    for _el_id in $(cut -f1 "$_el_d/rows.tsv" | awk '!seen[$0]++'); do
      _el_r="$(cat "$_el_d/stories/$_el_id" 2>/dev/null)"
      case "$_el_r" in
        'stopped: '*) _el_r="${_el_r#stopped: }" ;;
        'stopped '*) _el_r="${_el_r#stopped }" ;;
        *) continue ;;
      esac
      _el_s="${_el_s:+$_el_s; }$_el_id stopped: ${_el_r#stop: }"
    done
  fi
  _el_c="$(awk '/^## Resume$/ { f = 1; next } f && NF { print; exit }' "$1")"
  printf 'ended (%s)%s — report: %s%s\n' "$_el_e" "${_el_s:+ — $_el_s}" "$1" "${_el_c:+ — resume: $_el_c}"
}
# single_status DIR — a live single-plan run's block: run, unit, task,
# spend, pid (LOCK's), the running unit's last activity (now:), the gate
# lock and the resource readout. Returns 0.
single_status() {
  RUN_DIR="$1"
  { progress_compute single 1 || true; progress_overall; progress_done; }
  # #42 AC38: the task where the story's pointer is, or why it does not resolve.
  if story_resolve; then _ss_t="$(state get task 2>/dev/null)"; else _ss_t="$STORY_WHY"; fi
  printf 'run: %s\nunit: %s\ntask: %s\nspent: $%s\npid: %s\n' "$RUN_DIR" \
    "$(cat "$RUN_DIR/current" 2>/dev/null)" "$_ss_t" "$(spent)" "$(lock_pid)"
  if [ -f "$RUN_DIR/control/-.held" ]; then held_line "$(cat "$RUN_DIR/control/-.held")" -
  else _ps_now="$(unit_now_line "$RUN_DIR")"; [ -z "$_ps_now" ] || printf 'now: %s\n' "$_ps_now"; fi
  gate_line "$RUN_DIR"
  env_line "$(lock_pid)"
  return 0
}
# status_reap_dead — D12/AC31: every dead lock (a per-run lock, or the
# old-style .studio/overnight.lock) whose run dir has manifest.md and no
# report.md is reaped as lanes_reap_stale does: in a subshell, with LOCK set
# to it and START_DIR from its recorded start dir, so the report's Resume
# line changes into the run's own checkout (AC7). A run whose lanes still
# run is left alone (lanes_reap refuses).
status_reap_dead() {
  for _sr_l in "$STATE_ROOT"/.studio/runs/*/lock "$STATE_ROOT/.studio/overnight.lock"; do
    [ -f "$_sr_l" ] && ! runs_lock_live "$_sr_l" || continue
    _sr_d="$(runs_kv run "$_sr_l")"
    [ -n "$_sr_d" ] && [ -f "$_sr_d/manifest.md" ] && [ ! -f "$_sr_d/report.md" ] || continue
    _sr_sd="$(runs_start_dir "$_sr_l")"; [ -n "$_sr_sd" ] && [ -d "$_sr_sd" ] || _sr_sd="$START_DIR"
    ( LOCK="$_sr_l"; START_DIR="$_sr_sd"; . "$SELF_DIR/overnight-lanes.sh"
      lanes_load_run "$_sr_d"; lanes_reap ) || true
  done
}
# project_status — status inside a project (STATE_ROOT/.studio exists).
# Dead runs are reaped first (status_reap_dead). Then one block per live run
# (runs_live, oldest first); RUN_SEL (`status --run <sel>`) keeps the one
# runs_match picks, or prints `no live run <sel>` and returns 1. With a live
# manifest run and no RUN_SEL, `sessions: <live>/<cap>` comes first (AC10,
# D15). With two or more blocks each is headed `== <slug> (<kind>, pid <pid>) — <run dir>`
# (D16). Each block runs in a subshell with that run's LOCK and start dir
# (D12): a manifest run prints per story (lanes_status), a single-plan run
# single_status. With no live run: the lock's or the newest run dir — a
# manifest run's lanes_status, else the last run's ended_line, else where it
# looked. Returns 0 live, 1 not.
project_status() {
  status_reap_dead
  _ps_all="$(runs_live "$STATE_ROOT")"
  if [ -n "${RUN_SEL:-}" ]; then
    _ps_all="$(printf '%s\n' "$_ps_all" | runs_match "$RUN_SEL")"
    [ -n "$_ps_all" ] || { printf 'no live run %s\n' "$RUN_SEL"; return 1; }
  fi
  if [ -n "$_ps_all" ]; then
    # AC10, D15: with a manifest run live (and no --run), the project's
    # session slots first: the live ones (read, never reclaimed) over the cap.
    if [ -z "${RUN_SEL:-}" ] && printf '%s\n' "$_ps_all" | cut -f3 | grep -qx manifest; then
      sess_init; printf 'sessions: %s/%s\n' "$(sess_live_count)" "$(sess_cap)"
    fi
    _ps_n="$(printf '%s\n' "$_ps_all" | grep -c .)"; _ps_i=0
    # Fields by cut, not `read`: a tab is IFS white space, so an empty field
    # (an old lock's unknown start dir) would shift the ones after it.
    printf '%s\n' "$_ps_all" | while IFS= read -r _ps_line; do
      _ps_s="$(printf '%s\n' "$_ps_line" | cut -f2)"; _ps_k="$(printf '%s\n' "$_ps_line" | cut -f3)"
      _ps_p="$(printf '%s\n' "$_ps_line" | cut -f4)"; _ps_d="$(printf '%s\n' "$_ps_line" | cut -f5)"
      _ps_sd="$(printf '%s\n' "$_ps_line" | cut -f6)"; _ps_l="$(printf '%s\n' "$_ps_line" | cut -f7)"
      _ps_i=$((_ps_i + 1))
      if [ "$_ps_n" -gt 1 ]; then
        [ "$_ps_i" -eq 1 ] || echo
        printf '== %s (%s, pid %s) — %s\n' "$_ps_s" "$_ps_k" "$_ps_p" "$_ps_d"
      fi
      ( LOCK="$_ps_l"; START_DIR="${_ps_sd:-$START_DIR}"
        if [ "$_ps_k" = manifest ]; then . "$SELF_DIR/overnight-lanes.sh"; lanes_status "$_ps_d" live
        else single_status "$_ps_d"; fi )
    done
    return 0
  fi
  # The lock's run dir, unless a newer run dir exists: a manifest run no
  # longer rewrites .studio/overnight.lock, so a dead old lock must not mask
  # every newer run (#39).
  _sd="$(sed -n 's/^run=//p' "$LOCK" 2>/dev/null | head -n 1)"
  { [ -n "$_sd" ] && [ -d "$_sd" ]; } || _sd=""
  _sn="$(ls -dt "$REPORTS"/overnight-*/ 2>/dev/null | head -n 1)"; _sn="${_sn%/}"
  if [ -z "$_sd" ] || { [ -n "$_sn" ] && [ "$_sn" -nt "$_sd" ]; }; then _sd="$_sn"; fi
  _sd="${_sd%/}"
  if [ -n "$_sd" ] && [ -f "$_sd/manifest.md" ]; then
    ( . "$SELF_DIR/overnight-lanes.sh"; lanes_status "$_sd" ); return $?
  fi
  if [ -n "$_sd" ] && [ -f "$_sd/report.md" ]; then
    printf 'no run — the last run: %s\n' "$_sd"
    ended_line "$_sd/report.md"
    RUN_DIR="$_sd"; { progress_compute single 0 || true; progress_overall; progress_done; }
    return 1
  fi
  if [ -n "$_sd" ] && [ -d "$_sd" ]; then
    printf 'no run — the last run: %s has no report (its runner died before writing one; units.tsv and the unit logs are there)\n' "$_sd"
    RUN_DIR="$_sd"; { progress_compute single 0 || true; progress_overall; progress_done; }
    return 1
  fi
  printf 'no run in %s — no live run lock (%s) and no run under %s\n' "$STATE_ROOT" "$LOCK" "$REPORTS"
  return 1
}
# reg_show ROOT — a registered project's own status, run in ROOT. The nested
# call never reads the registry again (STUDIO_OVERNIGHT_IN_REGISTRY): a root
# that no longer resolves to its .studio/ must not recurse.
reg_show() {
  if [ -d "$1/.studio" ]; then
    ( cd "$1" && STUDIO_OVERNIGHT_IN_REGISTRY=1 sh "$SELF_ABS" status )
  elif [ -d "$1" ]; then echo "(the project has no .studio/ any more)"
  else echo "(the project directory is gone)"; fi
}
# registry_status — status outside a project, from REGISTRY: every live
# run's own status (run in its project), headed `== <run> — <project>`;
# with none, the newest ended run (REGISTRY/last, or an entry whose runner
# died); else where it looked. Returns 3 when a run is live elsewhere (0 is
# kept for "this project's run is live", the skills' liveness test), else 1.
registry_status() {
  _rs_n=0; _rs_seen=""
  for _rs_f in "$REGISTRY"/overnight-*; do
    [ -f "$_rs_f" ] && reg_live "$_rs_f" || continue
    _rs_root="$(reg_get root "$_rs_f")"
    case "$_rs_seen" in *"|$_rs_root|"*) continue ;; esac     # D17: each root once
    _rs_seen="$_rs_seen|$_rs_root|"
    _rs_names=""
    for _rs_g in "$REGISTRY"/overnight-*; do
      [ -f "$_rs_g" ] && reg_live "$_rs_g" && [ "$(reg_get root "$_rs_g")" = "$_rs_root" ] || continue
      _rs_names="${_rs_names:+$_rs_names, }$(reg_get run "$_rs_g" | sed 's|.*/||')"
    done
    _rs_n=$((_rs_n + 1)); [ "$_rs_n" = 1 ] || echo
    printf '== %s — %s\n' "$_rs_names" "$_rs_root"
    reg_show "$_rs_root"
  done
  [ "$_rs_n" -eq 0 ] || return 3
  _rs_last="$(ls -t "$REGISTRY"/last "$REGISTRY"/overnight-* 2>/dev/null | head -n 1)"
  if [ -n "$_rs_last" ]; then
    _rs_root="$(reg_get root "$_rs_last")"
    printf 'no live run (registry %s) — the last run was in %s\n' "$REGISTRY" "$_rs_root"
    reg_show "$_rs_root"
    return 1
  fi
  printf 'no run — nothing registered in %s, and %s is not a studio project (no .studio/)\n' "$REGISTRY" "$(pwd)"
  return 1
}
# cmd_status — inside a project, its run (project_status); a project with
# no live run also names the live runs of other projects. Outside one, the
# registry (registry_status). Exit 0 this project's run is live, 1 none,
# 3 (outside a project) a run is live elsewhere.
cmd_status() {
  if [ -n "$STATE_ROOT" ] && [ -d "$STATE_ROOT/.studio" ]; then
    project_status; _cs=$?
    if [ "$_cs" -ne 0 ] && [ -z "${STUDIO_OVERNIGHT_IN_REGISTRY:-}" ]; then
      for _cs_f in "$REGISTRY"/overnight-*; do
        [ -f "$_cs_f" ] && reg_live "$_cs_f" || continue
        [ "$(reg_get root "$_cs_f")" != "$STATE_ROOT" ] || continue
        printf 'live elsewhere: %s (pid %s) — %s status\n' "$(reg_get root "$_cs_f")" "$(reg_get pid "$_cs_f")" "$(sq "$SELF_ABS")"
      done
    fi
    return "$_cs"
  fi
  if [ -n "${STUDIO_OVERNIGHT_IN_REGISTRY:-}" ]; then
    printf 'no run in %s — not a studio project (no .studio/)\n' "$(pwd)"
    return 1
  fi
  registry_status
}
# cmd_watch [SECONDS] — cmd_status every SECONDS (default 5), the screen
# cleared on a terminal, until Ctrl-C. STUDIO_OVERNIGHT_WATCH_COUNT (test
# hook) ends it after that many refreshes.
cmd_watch() {
  _w_every="${1:-5}"
  case "$_w_every" in ''|*[!0-9]*|0) usage >&2; exit 2 ;; esac
  _w_max="${STUDIO_OVERNIGHT_WATCH_COUNT:-0}"; _w_n=0
  trap 'exit 0' INT TERM
  while :; do
    _w_out="$(cmd_status 2>&1)"
    [ ! -t 1 ] || printf '\033[H\033[2J'
    printf 'studio-overnight watch · %s · every %ss · Ctrl-C to quit\n\n%s\n' "$(date +%H:%M:%S)" "$_w_every" "$_w_out"
    _w_n=$((_w_n + 1))
    [ "$_w_max" -eq 0 ] || [ "$_w_n" -lt "$_w_max" ] || exit 0
    sleep "$_w_every"
  done
}

# The operator channel's verbs (#27): say, said, unsay, hold, resume,
# stop <story> and stop --run; and the message helpers the runner uses.
. "$SELF_DIR/overnight-channel.sh"
# The progress bar and rough finish time of `status` (#37).
. "$SELF_DIR/overnight-progress.sh"

case "$1" in
  start)  shift; cmd_start "$@" ;;
  status)
    shift
    case "${1:-}" in
      '') cmd_status; exit $? ;;
      --run) [ "$#" -eq 2 ] && [ -n "$2" ] || { usage >&2; exit 2; }
             RUN_SEL="$2"; cmd_status; exit $? ;;
      --follow|-f) shift; cmd_watch "$@" ;;
      *) usage >&2; exit 2 ;;
    esac ;;
  watch)  shift
          if [ "${1:-}" = --run ]; then
            [ "$#" -ge 2 ] && [ -n "$2" ] || { usage >&2; exit 2; }
            RUN_SEL="$2"; shift 2
          fi
          [ "$#" -le 1 ] || { usage >&2; exit 2; }; cmd_watch "$@" ;;
  activity)
    # --open: the open calls (#59 R2); --open-gate: open_calls' gate mode (a test hook).
    if [ "${2:-}" = --open ]; then [ "$#" -eq 3 ] && [ -f "$3" ] || { usage >&2; exit 2; }; open_calls "$3"; exit 0; fi
    if [ "${2:-}" = --open-gate ]; then [ "$#" -eq 3 ] && [ -f "$3" ] || { usage >&2; exit 2; }; open_calls "$3" gate; exit 0; fi
    [ "$#" -eq 2 ] && [ -f "$2" ] || { usage >&2; exit 2; }
    unit_activity "$2"; exit 0 ;;
  deny-rules) shift; cmd_deny_rules "$@" ;;
  check-id)
    shift
    . "$SELF_DIR/overnight-lanes.sh"   # mf_load, row_field; it sources overnight-ids.sh
    cmd_check_id "$@"
    exit $? ;;
  next)
    shift
    [ "$#" -le 1 ] || { usage >&2; exit 2; }
    _nx="${1:-}"
    if [ -z "$_nx" ]; then
      _nx="$(head -n 1 "$START_DIR/.studio/run" 2>/dev/null || true)"
      [ -n "$_nx" ] || { say "no run manifest (.studio/run)"; exit 2; }
    fi
    . "$SELF_DIR/overnight-lanes.sh"
    lanes_next "$_nx"
    exit $? ;;
  say|said|unsay|hold|resume) chan_main "$@" ;;
  stop)
    [ "$#" -eq 1 ] || {
      # stop --all: every live run's own flag (D13); anything else is the channel's.
      [ "${2:-}" = --all ] || chan_main "$@"
      [ "$#" -eq 2 ] || { usage >&2; exit 2; }
      _sp_l="$( { [ -z "$STATE_ROOT" ] || runs_live "$STATE_ROOT"; } )"
      [ -n "$_sp_l" ] || { echo "no run in ${STATE_ROOT:-$(pwd)} — stop runs from the run's project ($(sq "$SELF_ABS") status lists live runs)"; exit 1; }
      printf '%s\n' "$_sp_l" | while IFS= read -r _sp_e; do
        _sp_k="$(printf '%s\n' "$_sp_e" | cut -f7)"; _sp_s="$(printf '%s\n' "$_sp_e" | cut -f2)"
        runs_lock_live "$_sp_k" || continue
        : > "$(runs_stop_of "$_sp_k")"
        [ "$_sp_s" != - ] || _sp_s="$(basename "$(printf '%s\n' "$_sp_e" | cut -f5)")"
        printf 'stop requested: %s (pid %s)\n' "$_sp_s" "$(printf '%s\n' "$_sp_e" | cut -f4)"
      done
      exit 0
    }
    # The live run's own flag (D5): a per-run lock's stop, or .studio/overnight.stop.
    # Two or more live runs list them and stop none (D13).
    _sp_l="$( { [ -z "$STATE_ROOT" ] || runs_live "$STATE_ROOT"; } )"
    _sp_n="$(printf '%s\n' "$_sp_l" | grep -c .)"
    if [ "$_sp_n" -gt 1 ]; then
      printf '%s runs are live — nothing stopped:\n' "$_sp_n"
      printf '%s\n' "$_sp_l" | awk -F'\t' '{ b = $5; sub(/.*\//, "", b); printf "  %s  %s\n", ($2 == "-" ? b : $2), $5 }'
      printf 'stop one: %s stop --run <slug> · stop all: %s stop --all\n' "$(sq "$SELF_ABS")" "$(sq "$SELF_ABS")"
      exit 1
    fi
    if [ "$_sp_n" -eq 1 ]; then
      : > "$(runs_stop_of "$(printf '%s\n' "$_sp_l" | cut -f7)")"
      echo "stop requested: the run ends after its running unit (pid $(printf '%s\n' "$_sp_l" | cut -f4))"
      exit 0
    fi
    echo "no run in ${STATE_ROOT:-$(pwd)} — stop runs from the run's project ($(sq "$SELF_ABS") status lists live runs)"; exit 1 ;;
  *)      usage >&2; exit 2 ;;
esac
