#!/bin/sh
# studio-gate <who> -- <cmd> [args...] — run <cmd> holding the project's one
# gate lock, so at most one test or gate run happens at a time.
#
# Lock: STATE_ROOT/.studio/gate.lock/ (mkdir), holding `pid` (this script's
# $$) and `who`. The command runs as a child, leading its own process group,
# with STUDIO_GATE_HELD=<this pid> in its environment only; a nested
# studio-gate that sees STUDIO_GATE_HELD naming the live holder execs the
# command without locking. A lock whose pid is dead (or that has no pid) is
# reclaimed under the reclaim mutex below. The lock dir also holds `unit`
# (STUDIO_UNIT_TAG, empty outside an overnight unit) and `since` (epoch s).
#
# Overnight units: with STUDIO_UNIT_TAG set (the runner exports it into
# each unit's session), this script registers itself as
# STATE_ROOT/.studio/gate.units/<tag>/<its pid>, holding its child's pid once
# the command runs, and removes the entry on exit. When the unit ends, the
# runner ends every gate still registered under the unit's tag, waiting or
# holding, so a gate a session left in the background can never hold the
# lock into the next unit.
#
# Gate times: every command that ran appends `<epoch> <who> <seconds> <rc>`
# (rc 128+n when a signal ended it) to STATE_ROOT/.studio/gate.times (the
# newest 50 lines per `who` are kept); studio-overnight's preflight checks the slowest
# recent studio-test against session_minutes.
#
# Run cap (#59 R1): STUDIO_GATE_MINUTES (a whole number; unset, empty or 0 =
# no cap) stops a run that goes past it: TERM to the process group, KILL after
# the 10 s grace, `gate: <who> ran past <n> min — stopped` on stderr, rc 124
# in gate.times. The timer starts once the lock is held (waiting does not
# count). Who `setup` is exempt (worktree_setup has its own timer). A nested
# gate execs before any timer, so re-entry adds no second one.
# STUDIO_GATE_SECONDS (tests only) replaces minutes x 60.
# Exit: the command's status · 2 usage · 128+n when TERM/INT/HUP ended it ·
# 124 when STUDIO_GATE_MINUTES stopped the run.
# With no .studio/ project there is nothing to protect: the command just runs.

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

if [ "$#" -lt 3 ] || [ "$2" != "--" ]; then
  printf 'usage: studio-gate <who> -- <cmd> [args...]\n' >&2
  exit 2
fi
WHO="$1"
shift 2

ROOT="$(sh "$SELF_DIR/studio-state" root 2>/dev/null)" || ROOT=""
if [ -z "$ROOT" ] || [ ! -d "$ROOT/.studio" ]; then
  exec "$@"
fi
LOCK="$ROOT/.studio/gate.lock"
MUTEX="$LOCK.mutex"

# The gate's files (.studio/gate.lock, .mutex, .times, .units) are runtime
# state: keep them out of git through the repository's info/exclude, which
# every worktree shares.
_gcd="$(git -C "$ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || _gcd=""
case "$_gcd" in
  /?*) _excl="$_gcd/info/exclude"
      if ! grep -qxF '.studio/gate.*' "$_excl" 2>/dev/null; then
        mkdir -p "$_gcd/info" 2>/dev/null && printf '%s\n' '.studio/gate.*' >> "$_excl" 2>/dev/null
      fi ;;
esac

alive() { [ -n "$1" ] && kill -0 "$1" 2>/dev/null; }
lock_pid() { cat "$LOCK/pid" 2>/dev/null; }

# Re-entry: the caller already holds the lock through us.
if [ -n "${STUDIO_GATE_HELD:-}" ] && [ "$(lock_pid)" = "$STUDIO_GATE_HELD" ] && alive "$STUDIO_GATE_HELD"; then
  exec "$@"
fi

OWNED=0
HAVE_MUTEX=0
RUNNING=0
CHILD=""
SIGSTATUS=""

# ---- Reclaim mutex -------------------------------------------------------
# Every change to the lock dir except its live owner's own release happens
# while holding this mutex: taking it (mkdir + pid write) and reclaiming it.
# So, under the mutex, a lock dir naming a dead pid cannot change under us
# and is removed safely, and a lock dir with no pid is a taker that died
# before writing one. The owner's release is a rename aside, so nobody ever
# sees a half-deleted lock.
#
# The mutex is a symlink whose target is its owner's pid: `ln -s` creates it
# and names its owner in one atomic step, so it is never ownerless. It is held
# for a few milliseconds and its taker removes it on every path (the EXIT trap
# included). Stale rule: a mutex naming a dead pid is removed by whoever finds
# it, after re-reading the target just before the rm.
mutex_take() {
  if ln -s "$$" "$MUTEX" 2>/dev/null; then
    HAVE_MUTEX=1
    return 0
  fi
  _m="$(readlink "$MUTEX" 2>/dev/null)"
  if [ -n "$_m" ] && ! alive "$_m" && [ "$(readlink "$MUTEX" 2>/dev/null)" = "$_m" ]; then
    rm -f "$MUTEX"
  fi
  return 1
}
mutex_drop() {
  if [ "$HAVE_MUTEX" = 1 ]; then rm -f "$MUTEX"; fi
  HAVE_MUTEX=0
}

# One attempt: under the mutex, clear a dead or pidless holder's lock, then
# try to take it. Returns 0 when we hold the lock.
try_take() {
  mutex_take || return 1
  if [ -d "$LOCK" ]; then
    _h="$(lock_pid)"
    if [ -z "$_h" ] || ! alive "$_h"; then rm -rf "$LOCK"; fi
  fi
  _took=1
  if mkdir "$LOCK" 2>/dev/null; then
    OWNED=1
    printf '%s\n' "$$" > "$LOCK/pid"
    printf '%s\n' "$WHO" > "$LOCK/who"
    printf '%s\n' "$TAG" > "$LOCK/unit"
    date +%s > "$LOCK/since"
    _took=0
  fi
  mutex_drop
  return "$_took"
}

release() {
  [ -z "${TIMER:-}" ] || kill "$TIMER" 2>/dev/null
  mutex_drop
  if [ "$OWNED" = 1 ] && [ "$(lock_pid)" = "$$" ]; then
    mv "$LOCK" "$LOCK.gone.$$" 2>/dev/null && rm -rf "$LOCK.gone.$$"
  fi
  OWNED=0
  if [ -n "$REG" ]; then rm -f "$REG/$$"; rmdir "$REG" 2>/dev/null; fi
}

# The unit tag: only [A-Za-z0-9._-], so it is one safe path component.
TAG="${STUDIO_UNIT_TAG:-}"
case "$TAG" in *[!A-Za-z0-9._-]*|.|..) TAG="" ;; esac
# Another gate's release or the runner may rmdir an emptied directory between
# the mkdir and the write, so a failed registration is retried.
REG=""
if [ -n "$TAG" ]; then
  for _i in 1 2 3; do
    if mkdir -p "$ROOT/.studio/gate.units/$TAG" 2>/dev/null \
      && : 2>/dev/null > "$ROOT/.studio/gate.units/$TAG/$$"; then
      REG="$ROOT/.studio/gate.units/$TAG"
      break
    fi
  done
fi

# What a forwarded signal goes to: the child's process group ("-<pgid>") when
# it leads one, else (dash with no tty refuses `set -m`) the child and its
# descendants from one ps snapshot. `kill -SIG -<n>` (no `--`) is the form
# both bash and dash parse as a group.
TARGETS=""
targets() {
  if kill -0 "-$1" 2>/dev/null; then printf '%s\n' "-$1"; return; fi
  ps -A -o pid= -o ppid= 2>/dev/null | awk -v r="$1" '
    { kid[$2] = kid[$2] " " $1 }
    END { q = r; while (q != "") { n = split(q, a, " "); q = ""
          for (i = 1; i <= n; i++) { print a[i]; q = q kid[a[i]] } } }'
}
targets_alive() {
  for _t in $TARGETS; do kill -0 "$_t" 2>/dev/null && return 0; done
  return 1
}

# Before the child exists a signal just ends us (the EXIT trap releases).
# Once it runs, TERM goes to all of TARGETS (an engine the command runs in
# the foreground included), and the lock is kept until they are gone.
# ${CHILD:-$!} covers a signal landing between the launch and CHILD=$!.
on_signal() {
  SIGSTATUS="$1"
  if [ "$RUNNING" = 1 ]; then
    _c="${CHILD:-$!}"
    if [ -z "$TARGETS" ] && [ -n "$_c" ]; then TARGETS="$(targets "$_c")"; fi
    if [ -n "$TARGETS" ]; then kill -TERM $TARGETS 2>/dev/null; fi
  else
    exit "$1"
  fi
}
# Run cap (#59 R1): the timer starts once the lock is held. At the cap it
# sends us ALRM: TERM to the targets (on_signal 124); 10 s later it KILLs
# them itself, since the wait loop below never ends while a TERM-ignoring
# child lives.
# Leading zeros are stripped (decimal() below): `090` would otherwise be an
# octal arithmetic error that ends the gate before the command runs.
decimal() { _d="${1#"${1%%[!0]*}"}"; printf '%s\n' "${_d:-0}"; }
CAP_SECS=""; CAPPED=0; TIMER=""; CAP_MIN=""
case "${STUDIO_GATE_MINUTES:-}" in
  ''|*[!0-9]*) ;;
  *) CAP_MIN="$(decimal "$STUDIO_GATE_MINUTES")"
     if [ "$CAP_MIN" -gt 0 ] && [ "$WHO" != setup ]; then
       CAP_SECS="${STUDIO_GATE_SECONDS:-$((CAP_MIN * 60))}"
       case "$CAP_SECS" in ''|*[!0-9]*) CAP_SECS="" ;; *) CAP_SECS="$(decimal "$CAP_SECS")" ;; esac
     fi ;;
esac
on_cap() { if [ "$RUNNING" = 1 ] && alive "$CHILD"; then CAPPED=1; on_signal 124; fi; }
[ -z "$CAP_SECS" ] || trap on_cap ALRM
trap release EXIT
trap 'on_signal 130' INT
trap 'on_signal 143' TERM
trap 'on_signal 129' HUP

waited=0
until try_take; do
  if [ $((waited % 60)) -eq 0 ]; then
    printf 'gate: waiting for %s (pid %s)\n' "$(cat "$LOCK/who" 2>/dev/null)" "$(lock_pid)" >&2
  fi
  waited=$((waited + 1))
  sleep 1
done

# `set -m` makes the child lead its own process group (pgid == its pid), so
# a forwarded signal reaches everything it started, and its signal
# dispositions are not the ignored SIGINT of a plain background job.
RUNNING=1
{ set -m; } 2>/dev/null
T0="$(date +%s)"
STUDIO_GATE_HELD="$$" "$@" &
CHILD=$!
set +m
# The timer polls once a second and exits as soon as the gate is gone, so it
# can neither outlive the gate (signalling a reused pid) nor hold it: the
# gate never waits for it. Deadlines are wall-clock, so the polls' own cost
# does not stretch the cap.
if [ -n "$CAP_SECS" ]; then
  ( _end=$(( $(date +%s) + CAP_SECS ))
    while [ "$(date +%s)" -lt "$_end" ]; do sleep 1; kill -0 $$ 2>/dev/null || exit 0; done
    kill -ALRM $$ 2>/dev/null || exit 0
    _end=$(( $(date +%s) + 10 ))
    while [ "$(date +%s)" -lt "$_end" ]; do sleep 1; kill -0 $$ 2>/dev/null || exit 0; done
    kill -KILL $(targets "$CHILD") 2>/dev/null
  ) > /dev/null 2>&1 &
  TIMER=$!
fi
[ -z "$REG" ] || printf '%s\n' "$CHILD" > "$REG/$$"
rc=0
while :; do
  wait "$CHILD"
  rc=$?
  alive "$CHILD" || break
done
if [ -n "$TIMER" ]; then kill "$TIMER" 2>/dev/null; TIMER=""; fi
if [ -n "$TARGETS" ]; then
  # Hold the lock until the targets are gone: KILL stragglers after ~10 s
  # and stop waiting after ~15 s so a stuck process cannot wedge the gate.
  _n=0
  while targets_alive && [ "$_n" -lt 15 ]; do
    if [ "$_n" -eq 10 ]; then kill -KILL $TARGETS 2>/dev/null; fi
    _n=$((_n + 1))
    sleep 1
  done
fi
[ "$CAPPED" = 0 ] || printf 'gate: %s ran past %s min — stopped\n' "$WHO" "$CAP_MIN" >&2
RUNNING=0
CHILD=""
# A signalled run (a reaper, a session cap) is logged too, with 128+n: its
# seconds are a lower bound, and the overruns are what the preflight's
# session_minutes check most needs to see.
_times="$ROOT/.studio/gate.times"
{ [ -f "$_times" ] && cat "$_times"
  printf '%s %s %s %s\n' "$(date +%s)" "$WHO" "$(( $(date +%s) - T0 ))" "${SIGSTATUS:-$rc}"
} | awk '{ w[NR] = $2; l[NR] = $0 }
    END { for (i = NR; i >= 1; i--) keep[i] = (++c[w[i]] <= 50); for (i = 1; i <= NR; i++) if (keep[i]) print l[i] }' \
  > "$_times.$$" 2>/dev/null && mv -f "$_times.$$" "$_times" 2>/dev/null
rm -f "$_times.$$"
release
if [ -n "$SIGSTATUS" ]; then exit "$SIGSTATUS"; fi
exit "$rc"
