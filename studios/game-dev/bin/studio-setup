#!/bin/sh
# studio-setup — the project's hooks, run under the one gate lock.
#
#   studio-setup          run `worktree_setup` from this worktree's root, as
#                         `studio-gate setup -- sh -c '<command>'`
#   studio-setup gate     run `gate_command`, as
#                         `studio-gate gate -- sh -c '<command>'`
#   studio-setup --help   this text
#
# Run from any directory inside a worktree; it cds to the worktree's root.
#
# Config (.studio/config.json in the tree root, else in the state root):
#   worktree_setup          command line (a value containing a backslash is refused)
#   worktree_setup_minutes  timeout, integer 1-120, default 20
#   gate_command            command line (a backslash is refused)
#
# worktree_setup: the timer starts once the gate lock is held (at launch when
# there is no lock to take or the lock is already held through re-entry); a
# timeout TERMs the command's process group (studio-gate forwards it). Log:
# .studio/reports/setup-<stamp>.log, whose last line on a timeout is
# `studio-setup: timed out after <s> s`. Marker: $(git rev-parse --git-dir)/
# studio-setup.done, holding `printf %s <command> | cksum`; it is written only
# after a green run, so an unchanged command is a no-op and a changed command,
# or a new worktree (new git dir), runs again.
# gate: log .studio/reports/gate-<stamp>.log; exits with studio-gate's status.
#   green -> stdout `gate_command: green — log <path>`
#   red   -> stderr `gate_command exit <n> — log <path>`
#
# Exit (setup): 0 ran green, marker matched, or worktree_setup unset (silent) ·
#   1 failed or timed out, one stderr line
#   `worktree setup failed — exit <n> — log <path>` (124 = timeout) ·
#   2 usage or bad config.
# Exit (gate): the command's status (129/130/143 pass through); 0 when unset.
# Test hook: STUDIO_SETUP_TIMEOUT_SECONDS replaces minutes x 60.

HERE="$(cd "$(dirname "$0")" && pwd)"

usage() {
  sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
}

VERB=""
case "${1:-}" in
  "") [ "$#" -le 1 ] || { usage >&2; exit 2; } ;;
  gate) [ "$#" -eq 1 ] || { usage >&2; exit 2; }; VERB=gate ;;
  --help|-h) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

TOP="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  printf 'studio-setup: not inside a git worktree\n' >&2; exit 2; }
cd "$TOP" || exit 2
STATE_ROOT="$(sh "$HERE/studio-state" root 2>/dev/null)" || STATE_ROOT="$TOP"
[ -n "$STATE_ROOT" ] || STATE_ROOT="$TOP"

# cfg_get KEY — the quoted string value of "KEY" (first match), from the tree's
# .studio/config.json, else STATE_ROOT's (D8); cfg_num KEY — the bare token.
CONF="$TOP/.studio/config.json"; [ -f "$CONF" ] || CONF="$STATE_ROOT/.studio/config.json"
cfg_get() { [ -f "$CONF" ] && sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$CONF" | head -n 1; }
cfg_num() { [ -f "$CONF" ] && sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([^,}[:space:]]*\).*/\1/p' "$CONF" | head -n 1; }

ensure_reports() {
  mkdir -p .studio/reports
  [ -f .studio/reports/.gitignore ] || printf '*\n' > .studio/reports/.gitignore
}

# no_backslash KEY VALUE — exit 2 on a value the reader would not decode.
no_backslash() {
  case "$2" in
    *\\*) printf 'studio-setup: %s must not contain a backslash\n' "$1" >&2; exit 2 ;;
  esac
}

STAMP="$(date +%Y%m%d-%H%M%S)-$$"

if [ "$VERB" = gate ]; then
  GC="$(cfg_get gate_command)"
  [ -n "$GC" ] || exit 0
  no_backslash gate_command "$GC"
  ensure_reports
  LOG=".studio/reports/gate-$STAMP.log"
  rc=0
  sh "$HERE/studio-gate" gate -- sh -c "$GC" > "$LOG" 2>&1 < /dev/null || rc=$?
  if [ "$rc" -eq 0 ]; then
    printf 'gate_command: green — log %s\n' "$LOG"
    exit 0
  fi
  printf 'gate_command exit %s — log %s\n' "$rc" "$LOG" >&2
  exit "$rc"
fi

# timed_gate CMD SECS LOG — CMD under `studio-gate setup`, output to LOG; the
# timer starts once the gate lock names the gate's pid (at launch when there is
# no lock to take); a timeout TERMs the gate's process group (studio-gate
# forwards it to the command's group). Status: the command's, 124 on timeout.
tg_stop() {
  kill -TERM "-$_tg" 2>/dev/null || kill -TERM "$_tg" 2>/dev/null
  _n=0
  while kill -0 "$_tg" 2>/dev/null && [ "$_n" -lt 5 ]; do sleep 1; _n=$((_n + 1)); done
  if kill -0 "$_tg" 2>/dev/null; then
    # KILL the gate's descendants (the command runs in a group of its own) but
    # not the gate, which then sees its child die and releases the lock itself.
    _k="$(ps -A -o pid= -o ppid= 2>/dev/null | awk -v r="$_tg" '
      { kid[$2] = kid[$2] " " $1 }
      END { q = kid[r]; while (q != "") { n = split(q, a, " "); q = ""
            for (i = 1; i <= n; i++) { print a[i]; q = q kid[a[i]] } } }')"
    if [ -n "$_k" ]; then kill -KILL $_k 2>/dev/null; fi
  fi
}
# The caller was signalled: stop the run, wait for the gate, exit 128+N.
tg_signal() {
  tg_stop
  wait "$_tg" 2>/dev/null
  exit $(( 128 + $1 ))
}
timed_gate() {
  { set -m; } 2>/dev/null
  sh "$HERE/studio-gate" setup -- sh -c "$1" > "$3" 2>&1 < /dev/null &
  _tg=$!
  trap 'tg_signal 2' INT
  trap 'tg_signal 15' TERM
  trap 'tg_signal 1' HUP
  if [ -d "$STATE_ROOT/.studio" ] && ! { [ -n "${STUDIO_GATE_HELD:-}" ] \
       && [ "$(cat "$STATE_ROOT/.studio/gate.lock/pid" 2>/dev/null)" = "$STUDIO_GATE_HELD" ] \
       && kill -0 "$STUDIO_GATE_HELD" 2>/dev/null; }; then
    while kill -0 "$_tg" 2>/dev/null && [ "$(cat "$STATE_ROOT/.studio/gate.lock/pid" 2>/dev/null)" != "$_tg" ]; do sleep 1; done
  fi
  _t0=$(date +%s); _to=0
  while kill -0 "$_tg" 2>/dev/null; do
    if [ $(( $(date +%s) - _t0 )) -ge "$2" ]; then
      _to=1; tg_stop; break
    fi
    sleep 1
  done
  _rc=0; wait "$_tg" 2>/dev/null || _rc=$?
  trap - INT TERM HUP
  { set +m; } 2>/dev/null
  if [ "$_to" = 1 ]; then printf 'studio-setup: timed out after %s s\n' "$2" >> "$3"; return 124; fi
  return "$_rc"
}

CMD="$(cfg_get worktree_setup)"
[ -n "$CMD" ] || exit 0
no_backslash worktree_setup "$CMD"
MIN="$(cfg_num worktree_setup_minutes)"
[ -n "$MIN" ] || MIN=20
case "$MIN" in
  *[!0-9]*|"") printf 'studio-setup: worktree_setup_minutes must be an integer 1-120\n' >&2; exit 2 ;;
esac
MIN="$(printf '%s' "$MIN" | sed 's/^0*//')"   # no leading zeros: they read as octal
[ -n "$MIN" ] || MIN=0
if [ "${#MIN}" -gt 3 ] || [ "$MIN" -lt 1 ] || [ "$MIN" -gt 120 ]; then
  printf 'studio-setup: worktree_setup_minutes must be an integer 1-120\n' >&2; exit 2
fi

MARK="$(git rev-parse --git-dir)/studio-setup.done"
SUM="$(printf '%s' "$CMD" | cksum)"
[ "$(cat "$MARK" 2>/dev/null)" = "$SUM" ] && exit 0
LOG=".studio/reports/setup-$STAMP.log"
ensure_reports
SECS="${STUDIO_SETUP_TIMEOUT_SECONDS:-$((MIN * 60))}"
rc=0; timed_gate "$CMD" "$SECS" "$LOG" || rc=$?
if [ "$rc" -eq 0 ]; then printf '%s\n' "$SUM" > "$MARK"; exit 0; fi
printf 'worktree setup failed — exit %s — log %s\n' "$rc" "$LOG" >&2
exit 1
