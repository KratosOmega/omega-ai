#!/usr/bin/env python3
"""stub-multica: offline stand-in for the Multica CLI 0.6.x (#28 tests).

Row shapes, envelopes, timestamp form and error texts follow the P7 recording
(see tests/fixtures/cli/README.md). State lives in $STUB_MULTICA_DIR, else
<directory of argv[0] as invoked>/stub-state: board.json, calls.jsonl,
faults.json, errors/<name>.txt (+ optional <name>.exit)."""
from __future__ import annotations

import fcntl
import json
import os
import sys
import time
from datetime import datetime, timezone

ENV_KEYS = ("MULTICA_TOKEN", "MULTICA_SERVER_URL", "MULTICA_WORKSPACE_ID",
            "MULTICA_DAEMON_PORT", "MULTICA_TASK_ID", "HOME", "PATH")
GLOBAL_VALUE = ("--profile", "--server-url", "--workspace-id", "--output")
GLOBAL_BOOL = ("--debug",)
_SIGNIN = ("Your session has expired or you are not signed in. Run `multica login` to sign in again. "
           "On a self-hosted or non-OAuth setup, ask your administrator for valid credentials.")
DEFAULT_ERRORS = {
    "no-token": _SIGNIN,
    "unauthorized": _SIGNIN,
    "not-found": "The requested resource was not found. Check the ID, or run the matching `list` command "
                 "to see what exists in this workspace.",
    "duplicate": "Active duplicate issue exists: {ident} {title} (status: {status}). "
                 "Set allow_duplicate=true or use --allow-duplicate to create another.",
    "bad-status": "Invalid request: invalid status \"{status}\"; valid values: "
                  "backlog, todo, in_progress, in_review, blocked, done, cancelled",
    "forbidden": "Forbidden: workspace owner or admin required",
}
DEFAULT_EXIT = {"no-token": 3, "unauthorized": 3, "not-found": 4, "duplicate": 1, "bad-status": 5, "forbidden": 1}
STATUSES = ("backlog", "todo", "in_progress", "in_review", "blocked", "done", "cancelled")
TERMINAL = ("done", "cancelled")
ACTIVE_RUN = ("queued", "dispatched", "running")
SPEC = {  # command words: (value flags, bool flags, positional count)
    ("version",): ((), (), 0),
    ("user", "profile", "get"): ((), (), 0),
    ("issue", "create"): (("--title", "--description", "--parent", "--status", "--assignee-id", "--property"),
                          ("--description-stdin", "--allow-duplicate"), 0),
    ("issue", "get"): ((), (), 1),
    ("issue", "list"): (("--property", "--assignee-id", "--sort", "--direction", "--limit", "--offset", "--status"), (), 0),
    ("issue", "status"): ((), ("--no-start",), 2),
    ("issue", "assign"): (("--agent", "--member", "--squad"), ("--unassign", "--no-start"), 1),
    ("issue", "runs"): ((), ("--active",), 1),
    ("issue", "comment", "add"): (("--parent", "--content"), ("--content-stdin",), 1),
    ("issue", "comment", "list"): (("--since",), (), 1),
    ("property", "list"): ((), ("--include-archived",), 0),
    ("property", "create"): (("--name", "--type", "--description"), (), 0),
    ("runtime", "list"): ((), (), 0),
    ("runtime", "profile", "list"): ((), (), 0),
    ("runtime", "profile", "create"): (("--display-name", "--command-name", "--protocol-family"), (), 0),
    ("runtime", "profile", "delete"): ((), (), 1),
    ("agent", "list"): ((), ("--include-archived",), 0),
    ("agent", "create"): (("--name", "--runtime-id", "--max-concurrent-tasks", "--instructions"), ("--custom-env-stdin",), 0),
}
REPEATABLE = ("--property",)
NO_OUTPUT = (("runtime", "profile", "delete"),)


class Exit(Exception):
    def __init__(self, code, out="", err=""):
        super().__init__(code)
        self.code, self.out, self.err = code, out, err


def state_dir():
    return os.environ.get("STUB_MULTICA_DIR") or os.path.join(
        os.path.dirname(os.path.abspath(sys.argv[0])), "stub-state")


def error_text(d, name, **kw):
    try:
        with open(os.path.join(d, "errors", name + ".txt"), encoding="utf-8") as f:
            text = f.read().strip()
    except OSError:
        text = DEFAULT_ERRORS[name]
    for k, v in kw.items():         # {ident} {title} {status}; no str.format, texts may hold braces
        text = text.replace("{%s}" % k, str(v))
    return text


def error_exit(d, name):
    try:
        with open(os.path.join(d, "errors", name + ".exit"), encoding="utf-8") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return DEFAULT_EXIT[name]


def fail(d, name, **kw):
    return Exit(error_exit(d, name), err=error_text(d, name, **kw))


def usage(msg):
    return Exit(2, err="Error: " + msg)


# ----- clock and ids -------------------------------------------------------

def fmt(t):
    """P7d form: UTC, Z, second resolution."""
    return datetime.fromtimestamp(int(t), timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def parse_ts(s):
    s = s.strip().rstrip("Z").partition(".")[0]
    return datetime.strptime(s, "%Y-%m-%dT%H:%M:%S").replace(tzinfo=timezone.utc).timestamp()


def now(board):
    t = board.get("now")
    return fmt(time.time() if t is None else t)


def next_n(board, kind):
    c = board.setdefault("counters", {})
    c[kind] = c.get(kind, 0) + 1
    return c[kind]


def ws():
    return os.environ.get("MULTICA_WORKSPACE_ID") or "ws-test"


# ----- row templates (key sets = the P7 recording) -------------------------

def make_issue(board, title, description="", status="backlog", parent=None, assignee_type=None,
               assignee_id=None, props=None, created_at=None):
    n = next_n(board, "issue")
    at = created_at or now(board)
    row = {"assignee_id": assignee_id, "assignee_type": assignee_type, "created_at": at,
           "creator_id": board["user"]["id"], "creator_type": "member", "description": description,
           "due_date": None, "duplicate_of": None, "id": "iss-%d" % n, "identifier": "OMEG-%d" % n,
           "labels": [], "last_activity_at": at, "metadata": {}, "number": n, "parent_issue_id": parent,
           "position": float(n), "priority": "none", "project_id": None, "properties": dict(props or {}),
           "revision": 1, "stage": None, "start_date": None, "status": status, "status_category": status,
           "status_name": "", "title": title, "updated_at": at, "workspace_id": ws()}
    board.setdefault("issues", []).append(row)
    return row


def make_comment(board, issue_id, content, author_type="member", author_id=None, parent=None, at=None):
    n = next_n(board, "comment")
    at = at or now(board)
    row = {"attachments": [], "author_id": author_id or board["user"]["id"], "author_type": author_type,
           "content": content, "created_at": at, "id": "cm-%d" % n, "issue_id": issue_id,
           "issue_revision": 1, "parent_id": parent, "reactions": [], "resolved_at": None,
           "resolved_by_id": None, "resolved_by_type": None, "revision": 1, "type": "comment",
           "updated_at": at}
    board.setdefault("comments", []).append(row)
    return row


def make_run(issue_id, run_id, started_at, completed_at=None, status="completed"):
    return {"agent_id": "ag-1", "attempt": 1, "attribution": None, "completed_at": completed_at,
            "created_at": started_at, "delivered_comment_ids": [], "dispatched_at": started_at,
            "error": None, "id": run_id, "issue_id": issue_id, "kind": "issue_assignment",
            "max_attempts": 2, "priority": 0, "relative_work_dir": "", "result": {},
            "runtime_id": "rt-1", "started_at": started_at, "status": status,
            "trigger_comment_id": None, "trigger_summary": "", "usage": [], "work_dir": "",
            "workspace_id": ws()}


def make_property(board, name, ptype="text", description=""):
    n = next_n(board, "property")
    at = now(board)
    return {"archived": False, "config": {"options": None}, "created_at": at, "description": description,
            "icon": "", "id": "prop-%d" % n, "name": name, "position": n, "type": ptype,
            "updated_at": at, "usage_count": 0}


def make_profile(board, display_name, command_name, protocol_family):
    n = next_n(board, "profile")
    at = now(board)
    return {"command_name": command_name, "created_at": at, "created_by": board["user"]["id"],
            "description": "", "display_name": display_name, "enabled": True, "fixed_args": [],
            "id": "rp-%d" % n, "protocol_family": protocol_family, "runtime_type": "custom",
            "updated_at": at, "visibility": "workspace", "workspace_id": ws()}


def make_runtime(board, name, profile_id):
