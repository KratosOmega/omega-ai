#!/usr/bin/env python3
"""stub-launchctl: offline stand-in for /bin/launchctl (#28 tests).

Appends argv as one JSON line to $STUB_LAUNCHCTL_DIR/calls.
  print gui/<uid>/<label>       exit 0 when $STUB_LAUNCHCTL_DIR/loaded exists, else 113
  bootstrap gui/<uid> <plist>   copies the plist to loaded, exit 0
  bootout gui/<uid>/<label>     removes loaded, exit 0 (3 when absent)
  kickstart -k gui/<uid>/<label> by $STUB_LAUNCHCTL_DIR/mode (default selftest):
    selftest     runs the loaded plist's ProgramArguments[:-1] + ["selftest"] with its
                 EnvironmentVariables plus this environment's OMEGA_MULTICA_* and STUB_*
    file-access  writes a file-access failure to $HOME/.claude-gamedev/multica/selftest.json
    none         writes nothing
    stale        writes an ok self-test whose checked_at is long past (an old instance's)
Fault hooks: STUB_LAUNCHCTL_LINGER=N makes `print` succeed N more times after a bootout;
STUB_LAUNCHCTL_BOOTSTRAP_FAILS=N makes the first N bootstraps exit 5 (EIO) without loading."""
from __future__ import annotations

import json
import os
import plistlib
import subprocess
import sys
import time


def main(argv):
    d = os.environ.get("STUB_LAUNCHCTL_DIR")
    if not d:
        sys.stderr.write("STUB_LAUNCHCTL_DIR is not set\n")
        return 2
    with open(os.path.join(d, "calls"), "a", encoding="utf-8") as f:
        f.write(json.dumps(argv) + "\n")
    loaded = os.path.join(d, "loaded")
    verb = argv[0] if argv else ""
    linger = os.path.join(d, "linger")
    if verb == "print":
        if os.path.exists(linger):
            with open(linger, encoding="utf-8") as f:
                n = int(f.read().strip() or 0)
            if n > 0:
                with open(linger, "w", encoding="utf-8") as f:
                    f.write(str(n - 1))
                return 0
            os.remove(linger)
        return 0 if os.path.exists(loaded) else 113
    if verb == "bootstrap" and len(argv) >= 3:
        limit = int(os.environ.get("STUB_LAUNCHCTL_BOOTSTRAP_FAILS") or 0)
        done = os.path.join(d, "bootstrap-fails")
        n = int(open(done, encoding="utf-8").read() or 0) if os.path.exists(done) else 0
        if n < limit:
            with open(done, "w", encoding="utf-8") as f:
                f.write(str(n + 1))
            sys.stderr.write("Bootstrap failed: 5: Input/output error\n")
            return 5
        with open(argv[2], "rb") as src, open(loaded, "wb") as dst:
            dst.write(src.read())
        return 0
    if verb == "bootout":
        if not os.path.exists(loaded):
            return 3
        os.remove(loaded)
        if os.environ.get("STUB_LAUNCHCTL_LINGER"):
            with open(linger, "w", encoding="utf-8") as f:
                f.write(os.environ["STUB_LAUNCHCTL_LINGER"])
        return 0
    if verb == "kickstart":
        try:
            with open(os.path.join(d, "mode"), encoding="utf-8") as f:
                mode = f.read().strip() or "selftest"
        except OSError:
            mode = "selftest"
        if mode == "none":
            return 0
        if mode == "stale":
            base = os.path.join(os.environ.get("HOME", ""), ".claude-gamedev", "multica")
            os.makedirs(base, exist_ok=True)
            with open(os.path.join(base, "selftest.json"), "w", encoding="utf-8") as f:
                json.dump({"ok": True, "kind": None, "error": None, "interpreter": sys.executable,
                           "checked_at": "2020-01-01T00:00:00Z", "checked": []}, f)
            return 0
        if mode == "file-access":
            home = os.environ.get("HOME", "")
            base = os.path.join(home, ".claude-gamedev", "multica")
            os.makedirs(base, exist_ok=True)
            with open(os.path.join(base, "selftest.json"), "w", encoding="utf-8") as f:
                json.dump({"ok": False, "kind": "file-access", "checked_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                           "error": "Operation not permitted: %s/Documents/p/.studio" % home,
                           "interpreter": "/Library/Developer/CommandLineTools/usr/bin/python3"}, f)
            return 0
        with open(loaded, "rb") as f:
            pl = plistlib.load(f)
        env = dict(pl.get("EnvironmentVariables", {}))
        env.update({k: v for k, v in os.environ.items() if k.startswith(("OMEGA_MULTICA_", "STUB_"))})
        try:
            subprocess.run(pl["ProgramArguments"][:-1] + ["selftest"], env=env, timeout=20,
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            pass
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
